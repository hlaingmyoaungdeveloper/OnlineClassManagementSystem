@model OnlineClassManagementSystem.MvcApp.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");
    var isTeacher = currentRole == "teacher";
}

<div class="p-6 md:p-8 space-y-8">

    <!-- Header Greeting -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Dashboard</h1>
            <p id="dashboardGreeting" class="mt-1 text-sm text-slate-500">
                @(isTeacher ? "Welcome back, Teacher!" : "Welcome back, Admin!")
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span id="apiStatusBadge" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-2xs">
                <span id="apiStatusDot" class="h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
                <span id="apiStatusText">Loading Data...</span>
            </span>
            <button id="btnRefreshDashboard" onclick="loadDashboardData()" title="Refresh Dashboard"
                    class="rounded-lg border border-slate-200 bg-white p-1.5 text-slate-500 hover:text-slate-800 hover:bg-slate-50 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            </button>
        </div>
    </div>

    <!-- Error Banner (Hidden by default) -->
    <div id="dashboardErrorBanner" class="hidden rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs font-medium text-amber-800 flex items-center justify-between gap-2">
        <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <span id="dashboardErrorMessage">Cannot connect to Web API. Please verify the API is running.</span>
        </div>
        <button onclick="loadDashboardData()" class="rounded-lg bg-amber-600 hover:bg-amber-700 text-white px-3 py-1 text-xs font-semibold transition cursor-pointer">
            Retry
        </button>
    </div>

    @if (!isTeacher)
    {
        <!-- ADMIN DASHBOARD -->
        <!-- Stat Cards (4 columns) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            <!-- Total Classes -->
            <a asp-controller="SubClass" asp-action="Index" asp-route-role="admin" class="group flex items-center gap-4 rounded-xl border border-blue-100 bg-white p-5 shadow-xs hover:border-blue-300 hover:shadow-md transition">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Classes</p>
                    <div id="statTotalClassesSkeleton" class="mt-1 h-7 w-12 rounded skeleton-shimmer"></div>
                    <h3 id="statTotalClasses" class="hidden mt-1 text-2xl font-bold text-slate-800">0</h3>
                </div>
            </a>

            <!-- Total Students -->
            <div class="flex items-center gap-4 rounded-xl border border-emerald-100 bg-white p-5 shadow-xs">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Students</p>
                    <div id="statTotalStudentsSkeleton" class="mt-1 h-7 w-12 rounded skeleton-shimmer"></div>
                    <h3 id="statTotalStudents" class="hidden mt-1 text-2xl font-bold text-slate-800">0</h3>
                </div>
            </div>

            <!-- Total Teachers -->
            <div class="flex items-center gap-4 rounded-xl border border-purple-100 bg-white p-5 shadow-xs">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-purple-50 text-purple-600">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Teachers</p>
                    <div id="statTotalTeachersSkeleton" class="mt-1 h-7 w-12 rounded skeleton-shimmer"></div>
                    <h3 id="statTotalTeachers" class="hidden mt-1 text-2xl font-bold text-slate-800">0</h3>
                </div>
            </div>

            <!-- Total Enrollments -->
            <a asp-controller="Enrollment" asp-action="Index" asp-route-role="admin" class="group flex items-center gap-4 rounded-xl border border-amber-100 bg-white p-5 shadow-xs hover:border-amber-300 hover:shadow-md transition">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600 group-hover:bg-amber-600 group-hover:text-white transition">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Enrollments</p>
                    <div id="statTotalEnrollmentsSkeleton" class="mt-1 h-7 w-12 rounded skeleton-shimmer"></div>
                    <h3 id="statTotalEnrollments" class="hidden mt-1 text-2xl font-bold text-slate-800">0</h3>
                </div>
            </a>
        </div>

        <!-- Trend Chart & Recent Activities Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Enrollment Trend Chart -->
            <div class="lg:col-span-2 rounded-xl border border-slate-200 bg-white p-6 shadow-xs">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="text-base font-bold text-slate-800">Enrollment Trend (@DateTime.Now.Year)</h2>
                        <p class="text-xs text-slate-400">Monthly student enrollments from API</p>
                    </div>
                    <span id="chartEnrollmentBadge" class="inline-flex items-center rounded-md bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-600">
                        0 Total
                    </span>
                </div>
                <div class="relative h-72 w-full flex items-center justify-center" id="chartWrapper">
                    <div id="chartSkeleton" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-slate-50/50 rounded-xl">
                        <div class="h-6 w-6 animate-spin rounded-full border-2 border-blue-600 border-t-transparent"></div>
                        <span class="text-xs text-slate-400">Loading chart data...</span>
                    </div>
                    <canvas id="enrollmentTrendChart" class="w-full h-full"></canvas>
                </div>
            </div>

            <!-- Right: Recent Activities -->
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-xs flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-5">
                        <h2 class="text-base font-bold text-slate-800">Recent Activities</h2>
                        <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Live Feed</span>
                    </div>

                    <!-- Activities Skeleton -->
                    <div id="recentActivitiesSkeleton" class="space-y-4">
                        @for (int i = 0; i < 4; i++)
                        {
                            <div class="flex items-start gap-3.5">
                                <div class="mt-1.5 h-2.5 w-2.5 rounded-full skeleton-shimmer shrink-0"></div>
                                <div class="min-w-0 flex-1 space-y-1.5">
                                    <div class="h-3 w-3/4 rounded skeleton-shimmer"></div>
                                    <div class="h-2.5 w-1/2 rounded skeleton-shimmer"></div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Activities Content -->
                    <div id="recentActivitiesList" class="hidden space-y-4"></div>
                    <div id="recentActivitiesEmpty" class="hidden py-12 text-center text-slate-400">
                        <svg class="mx-auto h-8 w-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <p class="mt-2 text-xs">No recent activity recorded yet.</p>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100 mt-6">
                    <a asp-controller="SubClass" asp-action="Index" class="text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1">
                        View All Classes &rarr;
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- TEACHER DASHBOARD -->
        <!-- Stat Cards (3 columns) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <!-- My Classes -->
            <div class="flex items-center gap-4 rounded-xl border border-teal-100 bg-white p-5 shadow-xs">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-600">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">My Classes</p>
                    <div id="statMyClassesSkeleton" class="mt-1 h-7 w-12 rounded skeleton-shimmer"></div>
                    <h3 id="statMyClasses" class="hidden mt-1 text-2xl font-bold text-slate-800">0</h3>
                </div>
            </div>

            <!-- Total Students -->
            <div class="flex items-center gap-4 rounded-xl border border-emerald-100 bg-white p-5 shadow-xs">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Class Students</p>
                    <div id="statTeacherStudentsSkeleton" class="mt-1 h-7 w-12 rounded skeleton-shimmer"></div>
                    <h3 id="statTeacherStudents" class="hidden mt-1 text-2xl font-bold text-slate-800">0</h3>
                </div>
            </div>

            <!-- Teaching Tracking Records -->
            <div class="flex items-center gap-4 rounded-xl border border-amber-100 bg-white p-5 shadow-xs">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Teaching Records</p>
                    <div id="statPendingTrackingSkeleton" class="mt-1 h-7 w-12 rounded skeleton-shimmer"></div>
                    <h3 id="statPendingTracking" class="hidden mt-1 text-2xl font-bold text-slate-800">0</h3>
                </div>
            </div>
        </div>

        <!-- Upcoming Classes Card -->
        <div class="rounded-xl border border-slate-200 bg-white shadow-xs overflow-hidden">
            <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
                <div>
                    <h2 class="text-base font-bold text-slate-800">Schedule & Timetable</h2>
                    <p class="text-xs text-slate-400">Class timings assigned from API</p>
                </div>
                <a asp-controller="Timetable" asp-action="Index" asp-route-role="teacher" class="text-xs font-semibold text-teal-600 hover:text-teal-700">View Full Timetable</a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50/80 text-xs font-semibold uppercase text-slate-500">
                        <tr>
                            <th class="px-6 py-3.5">Day</th>
                            <th class="px-6 py-3.5">Time</th>
                            <th class="px-6 py-3.5">Class</th>
                            <th class="px-6 py-3.5">Subject</th>
                            <th class="px-6 py-3.5">Mode</th>
                        </tr>
                    </thead>
                    <tbody id="upcomingClassesBody" class="divide-y divide-slate-100">
                        <!-- Skeleton Rows -->
                        <tr id="upcomingClassesSkeleton">
                            <td colspan="5" class="px-6 py-8 text-center">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <div class="h-5 w-5 animate-spin rounded-full border-2 border-teal-600 border-t-transparent"></div>
                                    <span class="text-xs text-slate-400">Loading schedule...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        const currentRole = '@currentRole';
        const isTeacher = @(isTeacher ? "true" : "false");
        let trendChartInstance = null;

        function loadDashboardData() {
            // Set loading indicators
            const statusDot = document.getElementById('apiStatusDot');
            const statusText = document.getElementById('apiStatusText');
            const errorBanner = document.getElementById('dashboardErrorBanner');

            if (statusDot) {
                statusDot.className = 'h-2 w-2 rounded-full bg-amber-400 animate-pulse';
            }
            if (statusText) {
                statusText.innerText = 'Loading Data...';
            }
            if (errorBanner) {
                errorBanner.classList.add('hidden');
            }

            const url = '@Url.Action("GetDashboardData", "Home")?role=' + encodeURIComponent(currentRole);

            fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => {
                if (!res.ok) throw new Error('HTTP ' + res.status);
                return res.json();
            })
            .then(response => {
                if (response && response.isSuccess && response.data) {
                    const data = response.data;

                    // Update Status
                    if (statusDot) statusDot.className = 'h-2 w-2 rounded-full bg-emerald-500';
                    if (statusText) statusText.innerText = 'API Connected';

                    if (!isTeacher) {
                        // Populate Admin Stats
                        updateStat('statTotalClasses', 'statTotalClassesSkeleton', data.totalClasses);
                        updateStat('statTotalStudents', 'statTotalStudentsSkeleton', data.totalStudents);
                        updateStat('statTotalTeachers', 'statTotalTeachersSkeleton', data.totalTeachers);
                        updateStat('statTotalEnrollments', 'statTotalEnrollmentsSkeleton', data.totalEnrollments);

                        // Update badge
                        const badge = document.getElementById('chartEnrollmentBadge');
                        if (badge) badge.innerText = `${data.totalEnrollments} Total`;

                        // Render Trend Chart
                        renderChart(data.monthlyEnrollments || []);

                        // Render Recent Activities
                        renderRecentActivities(data.recentActivities || []);
                    } else {
                        // Populate Teacher Stats
                        updateStat('statMyClasses', 'statMyClassesSkeleton', data.myClassesCount);
                        updateStat('statTeacherStudents', 'statTeacherStudentsSkeleton', data.teacherStudentCount);
                        updateStat('statPendingTracking', 'statPendingTrackingSkeleton', data.pendingTrackingCount);

                        // Greeting
                        if (data.teacherName) {
                            const greeting = document.getElementById('dashboardGreeting');
                            if (greeting) greeting.innerText = `Welcome back, ${data.teacherName}!`;
                        }

                        // Render Upcoming Classes
                        renderUpcomingClasses(data.upcomingClasses || []);
                    }
                } else {
                    showDashboardError(response ? response.message : 'Unknown response from server');
                }
            })
            .catch(err => {
                showDashboardError('Failed to load dashboard metrics from Web API.');
            });
        }

        function updateStat(valueElementId, skeletonElementId, value) {
            const valEl = document.getElementById(valueElementId);
            const skelEl = document.getElementById(skeletonElementId);
            if (valEl) {
                valEl.innerText = (value !== undefined && value !== null) ? value : '0';
                valEl.classList.remove('hidden');
            }
            if (skelEl) {
                skelEl.classList.add('hidden');
            }
        }

        function showDashboardError(msg) {
            const statusDot = document.getElementById('apiStatusDot');
            const statusText = document.getElementById('apiStatusText');
            const errorBanner = document.getElementById('dashboardErrorBanner');
            const errorMsg = document.getElementById('dashboardErrorMessage');

            if (statusDot) statusDot.className = 'h-2 w-2 rounded-full bg-rose-500';
            if (statusText) statusText.innerText = 'API Disconnected';

            if (errorBanner) {
                errorBanner.classList.remove('hidden');
            }
            if (errorMsg) {
                errorMsg.innerText = msg;
            }

            // Hide chart skeleton on error
            const chartSkel = document.getElementById('chartSkeleton');
            if (chartSkel) chartSkel.classList.add('hidden');
        }

        function renderChart(monthlyData) {
            const chartSkel = document.getElementById('chartSkeleton');
            if (chartSkel) chartSkel.classList.add('hidden');

            const ctx = document.getElementById('enrollmentTrendChart');
            if (!ctx) return;

            if (typeof Chart === 'undefined') {
                console.warn('Chart.js library is not available');
                return;
            }

            if (trendChartInstance) {
                trendChartInstance.destroy();
            }

            trendChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                    datasets: [{
                        label: 'Enrollments',
                        data: monthlyData,
                        borderColor: '#3B82F6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        tension: 0.35,
                        fill: true,
                        pointBackgroundColor: '#3B82F6',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ' ' + context.parsed.y + ' enrolled';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1,
                                precision: 0,
                                color: '#94A3B8',
                                font: { size: 11 }
                            },
                            grid: { color: '#F1F5F9' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#94A3B8', font: { size: 11 } }
                        }
                    }
                }
            });
        }

        function renderRecentActivities(activities) {
            const skel = document.getElementById('recentActivitiesSkeleton');
            const list = document.getElementById('recentActivitiesList');
            const empty = document.getElementById('recentActivitiesEmpty');

            if (skel) skel.classList.add('hidden');

            if (!activities || activities.length === 0) {
                if (empty) empty.classList.remove('hidden');
                if (list) list.classList.add('hidden');
                return;
            }

            if (empty) empty.classList.add('hidden');
            if (list) {
                list.innerHTML = '';
                activities.forEach(act => {
                    const dotColor = act.type === 'enrollment' ? 'bg-blue-500 ring-blue-50'
                        : act.type === 'tracking' ? 'bg-emerald-500 ring-emerald-50'
                        : 'bg-purple-500 ring-purple-50';

                    const itemHtml = `
                        <div class="flex items-start gap-3.5">
                            <span class="mt-1.5 h-2.5 w-2.5 rounded-full ${dotColor} shrink-0 ring-4"></span>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-semibold text-slate-800 truncate">${escapeHtml(act.title)}</p>
                                <p class="text-[11px] text-slate-500 truncate">${escapeHtml(act.description)}</p>
                                <span class="text-[10px] text-slate-400">${escapeHtml(act.timeAgo || '')}</span>
                            </div>
                        </div>
                    `;
                    list.insertAdjacentHTML('beforeend', itemHtml);
                });
                list.classList.remove('hidden');
            }
        }

        function renderUpcomingClasses(schedules) {
            const tbody = document.getElementById('upcomingClassesBody');
            if (!tbody) return;

            if (!schedules || schedules.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-slate-400 text-xs">
                            No scheduled classes found.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = '';
            schedules.forEach(sch => {
                const startTime = formatTime(sch.startTime);
                const endTime = formatTime(sch.endTime);
                const className = sch.className || ('Class #' + sch.subClassId);
                const subjectName = sch.subjectName || 'Subject';
                const mode = sch.mode || 'ClassRoom';

                const rowHtml = `
                    <tr class="hover:bg-slate-50/50 transition">
                        <td class="px-6 py-4 font-semibold text-slate-800">${escapeHtml(sch.dayOfWeek || '-')}</td>
                        <td class="px-6 py-4 font-medium text-slate-700">${startTime} - ${endTime}</td>
                        <td class="px-6 py-4 text-slate-800 font-semibold">${escapeHtml(className)}</td>
                        <td class="px-6 py-4 text-teal-600 font-medium">${escapeHtml(subjectName)}</td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">
                                ${escapeHtml(mode)}
                            </span>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', rowHtml);
            });
        }

        function formatTime(timeStr) {
            if (!timeStr) return '--:--';
            if (typeof timeStr === 'string' && timeStr.length >= 5) {
                return timeStr.substring(0, 5);
            }
            return timeStr;
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Kick off AJAX load immediately
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', loadDashboardData);
        } else {
            loadDashboardData();
        }
    </script>
}
