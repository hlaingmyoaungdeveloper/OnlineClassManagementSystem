@{
    ViewData["Title"] = "Reports";
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");
    var isTeacher = currentRole == "teacher";
}

<div class="p-6 md:p-8 space-y-6">

    <!-- Page Title -->
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Reports</h1>
    </div>

    <!-- Report Sub-tabs -->
    <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 pb-3">
        <button class="rounded-lg @(isTeacher ? "bg-teal-600" : "bg-blue-600") px-4 py-2 text-xs font-semibold text-white shadow-xs">
            Student Performance
        </button>
        <button class="rounded-lg px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
            Class Summary
        </button>
        <button class="rounded-lg px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
            Teacher Performance
        </button>
        <button class="rounded-lg px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
            Enrollment Report
        </button>
    </div>

    <!-- Filters Row -->
    <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-xs">
        <div class="flex flex-wrap items-center gap-4 flex-1">
            <!-- Class Dropdown -->
            <div class="w-40">
                <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Class</label>
                <select class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs font-medium text-slate-700 outline-none focus:border-blue-500">
                    <option>All Classes</option>
                    <option>Class A</option>
                    <option>Class B</option>
                    <option>Class C</option>
                    <option>Class D</option>
                </select>
            </div>

            <!-- Subject Dropdown -->
            <div class="w-40">
                <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Subject</label>
                <select class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs font-medium text-slate-700 outline-none focus:border-blue-500">
                    <option>All Subjects</option>
                    <option>Mathematics</option>
                    <option>Physics</option>
                    <option>Chemistry</option>
                    <option>Biology</option>
                </select>
            </div>

            <!-- Date Range -->
            <div>
                <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Date Range</label>
                <div class="flex items-center gap-2">
                    <input type="date" value="2025-08-01" class="rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-blue-500" />
                    <span class="text-xs text-slate-400">to</span>
                    <input type="date" value="2025-10-31" class="rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-blue-500" />
                </div>
            </div>
        </div>

        <div>
            <button class="inline-flex items-center gap-2 rounded-lg @(isTeacher ? "bg-teal-600 hover:bg-teal-700" : "bg-blue-600 hover:bg-blue-700") px-5 py-2 text-xs font-semibold text-white shadow-xs transition">
                Generate
            </button>
        </div>
    </div>

    <!-- Reports 2-Column Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Left: Student Performance Summary Table -->
        <div class="lg:col-span-2 rounded-xl border border-slate-200 bg-white shadow-xs overflow-hidden">
            <div class="border-b border-slate-100 px-6 py-4">
                <h2 class="text-base font-bold text-slate-800">Student Performance Summary</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50/80 text-xs font-semibold uppercase text-slate-500 border-b border-slate-200/80">
                        <tr>
                            <th class="px-6 py-3.5">Class</th>
                            <th class="px-6 py-3.5">Total Students</th>
                            <th class="px-6 py-3.5">Average Score</th>
                            <th class="px-6 py-3.5">Pass Rate</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="px-6 py-4 font-semibold text-slate-800">Class A</td>
                            <td class="px-6 py-4 text-slate-600">28</td>
                            <td class="px-6 py-4 font-medium text-slate-800">82.5</td>
                            <td class="px-6 py-4 text-emerald-600 font-semibold">89%</td>
                        </tr>
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="px-6 py-4 font-semibold text-slate-800">Class B</td>
                            <td class="px-6 py-4 text-slate-600">25</td>
                            <td class="px-6 py-4 font-medium text-slate-800">79.2</td>
                            <td class="px-6 py-4 text-emerald-600 font-semibold">84%</td>
                        </tr>
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="px-6 py-4 font-semibold text-slate-800">Class C</td>
                            <td class="px-6 py-4 text-slate-600">22</td>
                            <td class="px-6 py-4 font-medium text-slate-800">76.8</td>
                            <td class="px-6 py-4 text-emerald-600 font-semibold">82%</td>
                        </tr>
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="px-6 py-4 font-semibold text-slate-800">Class D</td>
                            <td class="px-6 py-4 text-slate-600">20</td>
                            <td class="px-6 py-4 font-medium text-slate-800">78.5</td>
                            <td class="px-6 py-4 text-emerald-600 font-semibold">85%</td>
                        </tr>
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="px-6 py-4 font-semibold text-slate-800">Class E</td>
                            <td class="px-6 py-4 text-slate-600">18</td>
                            <td class="px-6 py-4 font-medium text-slate-800">81.3</td>
                            <td class="px-6 py-4 text-emerald-600 font-semibold">88%</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right: Performance Distribution Donut Chart -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-xs flex flex-col justify-between">
            <div>
                <h2 class="text-base font-bold text-slate-800 mb-4">Performance Distribution</h2>
                
                <div class="relative h-56 w-full flex items-center justify-center">
                    <canvas id="performanceDonutChart"></canvas>
                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                        <span class="text-xs text-slate-400 font-medium">Total</span>
                        <span class="text-xl font-bold text-slate-800">168</span>
                    </div>
                </div>

                <!-- Custom Legend matching screenshot -->
                <div class="mt-6 space-y-2.5 text-xs text-slate-600">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="h-2.5 w-2.5 rounded-full bg-blue-500"></span>
                            <span>Excellent (80-100)</span>
                        </div>
                        <span class="font-semibold text-slate-800">45%</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                            <span>Good (70-79)</span>
                        </div>
                        <span class="font-semibold text-slate-800">25%</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>
                            <span>Average (60-69)</span>
                        </div>
                        <span class="font-semibold text-slate-800">20%</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span>
                            <span>Fail (0-59)</span>
                        </div>
                        <span class="font-semibold text-slate-800">10%</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('performanceDonutChart');
            if (ctx) {
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Excellent', 'Good', 'Average', 'Fail'],
                        datasets: [{
                            data: [45, 25, 20, 10],
                            backgroundColor: [
                                '#3B82F6', // Blue
                                '#10B981', // Green
                                '#F59E0B', // Amber
                                '#EF4444'  // Red
                            ],
                            borderWidth: 2,
                            borderColor: '#ffffff',
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return ' ' + context.label + ': ' + context.raw + '%';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
