@model OnlineClassManagementSystem.Shared.models.Enrollment.SubClassEnrollRequestModel
@{
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");
    var subClass = ViewBag.SubClass as OnlineClassManagementSystem.Shared.models.SubClass.SubClassEditResponseModel;
    var students = ViewBag.Students as List<OnlineClassManagementSystem.Shared.models.User.UserModel> ?? new();
    ViewData["Title"] = "Enroll Student";
}

<div class="p-6 md:p-8 space-y-6 max-w-3xl mx-auto">

    <!-- Back Navigation -->
    <div>
        <a asp-controller="SubClass" asp-action="Index" asp-route-role="@currentRole"
           class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 transition">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back to Classes
        </a>
    </div>

    <!-- Main Card -->
    <div class="rounded-2xl border border-slate-200/80 bg-white p-6 md:p-8 shadow-sm">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-slate-100">
            <div>
                <h1 class="text-xl font-bold tracking-tight text-slate-900">Enroll Student into Class</h1>
                <p class="text-xs text-slate-500 mt-0.5">Assign an existing student or register a new student to <span class="font-semibold text-blue-600">@(subClass?.ClassName ?? "Selected Class")</span></p>
            </div>
            <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
            </div>
        </div>

        @if (TempData["Error"] != null || ViewBag.Error != null)
        {
            <div class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs font-medium text-rose-800 flex items-center gap-2">
                <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                <span>@(TempData["Error"] ?? ViewBag.Error)</span>
            </div>
        }

        <!-- Class Summary Details -->
        @if (subClass != null)
        {
            <div class="mb-6 rounded-xl bg-slate-50 border border-slate-100 p-4 grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
                <div>
                    <span class="text-slate-400 block text-[11px] uppercase font-semibold">Class</span>
                    <span class="font-bold text-slate-800">@subClass.ClassName</span>
                </div>
                <div>
                    <span class="text-slate-400 block text-[11px] uppercase font-semibold">Room / Place</span>
                    <span class="font-medium text-slate-700">@(string.IsNullOrEmpty(subClass.Place) ? "Not Assigned" : subClass.Place)</span>
                </div>
                <div>
                    <span class="text-slate-400 block text-[11px] uppercase font-semibold">Schedule</span>
                    <span class="font-medium text-slate-700">@subClass.OpenDate.ToString("dd-MM-yyyy") @subClass.OpenTime</span>
                </div>
                <div>
                    <span class="text-slate-400 block text-[11px] uppercase font-semibold">Capacity</span>
                    <span class="font-medium text-slate-700">Max @subClass.StudentLimit students</span>
                </div>
            </div>
        }

        <form asp-controller="SubClass" asp-action="Enroll" asp-route-role="@currentRole" method="post" class="space-y-6" id="enrollForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ClassId" />
            <input type="hidden" asp-for="IsNewStudent" id="pageIsNewStudentInput" value="false" />

            <!-- Student Type Selection: Existing Student vs New Student -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-2">Student Option</label>
                <div class="grid grid-cols-2 gap-3 p-1 rounded-xl bg-slate-100/80 border border-slate-200/80">
                    <button type="button" id="tabExistingBtn" onclick="toggleStudentMode(false)"
                            class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-xs font-semibold transition bg-white text-blue-600 shadow-2xs">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        Existing Student
                    </button>
                    <button type="button" id="tabNewBtn" onclick="toggleStudentMode(true)"
                            class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-xs font-semibold transition text-slate-500 hover:text-slate-800">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                        + New Student
                    </button>
                </div>
            </div>

            <!-- OPTION 1: EXISTING STUDENT SECTION -->
            <div id="existingStudentSection" class="space-y-2">
                <label asp-for="StudentId" class="block text-xs font-semibold text-slate-700 mb-1.5">
                    Select Existing Student <span class="text-rose-500">*</span>
                </label>
                @if (students.Count > 0)
                {
                    <select asp-for="StudentId" id="pageStudentSelect"
                            class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition">
                        <option value="">-- Choose a Registered Student --</option>
                        @foreach (var s in students)
                        {
                            <option value="@s.UserId">@s.FullName (@s.Email) [No: @s.UserId]</option>
                        }
                    </select>
                }
                else
                {
                    <input asp-for="StudentId" id="pageStudentInput" type="number" min="1" placeholder="Enter Student User No"
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
                    <p class="text-[11px] text-slate-400 mt-1">Enter the student's User No to enroll.</p>
                }
                <span asp-validation-for="StudentId" class="text-[11px] text-rose-600"></span>
            </div>

            <!-- OPTION 2: NEW STUDENT DATA SECTION (Requested Flow) -->
            <div id="newStudentSection" class="hidden space-y-4 p-4 rounded-xl border border-blue-100 bg-blue-50/40">
                <div class="flex items-center gap-2 text-xs font-semibold text-blue-800 mb-2">
                    <svg class="h-4 w-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>Enter New Student Information</span>
                </div>

                <!-- Full Name -->
                <div>
                    <label asp-for="FullName" class="block text-xs font-semibold text-slate-700 mb-1.5">
                        Full Name <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="FullName" id="pageFullName" placeholder="e.g. Aung Min Khant"
                           class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition" />
                    <span asp-validation-for="FullName" class="text-[11px] text-rose-600"></span>
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Email" class="block text-xs font-semibold text-slate-700 mb-1.5">
                        Email Address <span class="text-rose-500">*</span>
                    </label>
                    <input asp-for="Email" id="pageEmail" type="email" placeholder="e.g. aungminkhant@gmail.com"
                           class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition" />
                    <span asp-validation-for="Email" class="text-[11px] text-rose-600"></span>
                </div>

                <!-- Telegram / Contact -->
                <div>
                    <label asp-for="TelegramUsername" class="block text-xs font-semibold text-slate-700 mb-1.5">
                        Telegram / Phone <span class="text-slate-400 font-normal">(Optional)</span>
                    </label>
                    <input asp-for="TelegramUsername" id="pageTelegram" placeholder="e.g. @@aungmin or 09123456789"
                           class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition" />
                    <span asp-validation-for="TelegramUsername" class="text-[11px] text-rose-600"></span>
                </div>
            </div>

            <!-- Enrollment Date (For both Existing & New) -->
            <div>
                <label asp-for="EnrollDate" class="block text-xs font-semibold text-slate-700 mb-1.5">
                    Enrollment Date <span class="text-rose-500">*</span>
                </label>
                <input asp-for="EnrollDate" type="date" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" required
                       class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
                <span asp-validation-for="EnrollDate" class="text-[11px] text-rose-600"></span>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-controller="SubClass" asp-action="Index" asp-route-role="@currentRole"
                   class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition shadow-2xs">
                    Cancel
                </a>
                <button type="submit" id="submitEnrollBtn"
                        class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 px-6 py-2.5 text-xs font-semibold text-white shadow-sm transition">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span id="submitBtnText">Confirm Enrollment</span>
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <script>
        function toggleStudentMode(isNew) {
            const isNewInput = document.getElementById('pageIsNewStudentInput');
            const tabExistingBtn = document.getElementById('tabExistingBtn');
            const tabNewBtn = document.getElementById('tabNewBtn');
            const existingSection = document.getElementById('existingStudentSection');
            const newSection = document.getElementById('newStudentSection');
            const submitBtnText = document.getElementById('submitBtnText');

            const studentSelect = document.getElementById('pageStudentSelect');
            const studentInput = document.getElementById('pageStudentInput');
            const fullNameInput = document.getElementById('pageFullName');
            const emailInput = document.getElementById('pageEmail');

            isNewInput.value = isNew ? "true" : "false";

            if (isNew) {
                // Switch to New Student mode
                tabNewBtn.classList.add('bg-white', 'text-blue-600', 'shadow-2xs');
                tabNewBtn.classList.remove('text-slate-500');

                tabExistingBtn.classList.remove('bg-white', 'text-blue-600', 'shadow-2xs');
                tabExistingBtn.classList.add('text-slate-500');

                existingSection.classList.add('hidden');
                newSection.classList.remove('hidden');

                if (studentSelect) studentSelect.removeAttribute('required');
                if (studentInput) studentInput.removeAttribute('required');

                if (fullNameInput) fullNameInput.setAttribute('required', 'required');
                if (emailInput) emailInput.setAttribute('required', 'required');

                submitBtnText.innerText = "Register & Enroll Student";
            } else {
                // Switch to Existing Student mode
                tabExistingBtn.classList.add('bg-white', 'text-blue-600', 'shadow-2xs');
                tabExistingBtn.classList.remove('text-slate-500');

                tabNewBtn.classList.remove('bg-white', 'text-blue-600', 'shadow-2xs');
                tabNewBtn.classList.add('text-slate-500');

                newSection.classList.add('hidden');
                existingSection.classList.remove('hidden');

                if (fullNameInput) fullNameInput.removeAttribute('required');
                if (emailInput) emailInput.removeAttribute('required');

                if (studentSelect) studentSelect.setAttribute('required', 'required');
                if (studentInput) studentInput.setAttribute('required', 'required');

                submitBtnText.innerText = "Confirm Enrollment";
            }
        }
    </script>
}
