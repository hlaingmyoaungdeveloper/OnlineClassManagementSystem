@model OnlineClassManagementSystem.Shared.models.SubClass.SubClassEditRequestModel
@{
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");
    ViewData["Title"] = "Edit Class";
}

<div class="p-6 md:p-8 space-y-6 max-w-4xl">

    <!-- Back Button -->
    <div>
        <a asp-controller="SubClass" asp-action="Index" asp-route-role="@currentRole"
           class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 transition">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back
        </a>
    </div>

    <!-- Main Card -->
    <div class="rounded-xl border border-slate-200 bg-white p-6 md:p-8 shadow-xs">
        <h1 class="text-xl font-bold tracking-tight text-slate-900 mb-6">Edit Class</h1>

        @if (ViewBag.Error != null)
        {
            <div class="mb-6 rounded-lg bg-red-50 p-3 text-xs text-red-700">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="SubClass" asp-action="Edit" asp-route-id="@Model.SubClassId" asp-route-role="@currentRole" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs text-red-600"></div>

            <input type="hidden" asp-for="SubClassId" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label asp-for="ClassName" class="block text-xs font-semibold text-slate-700 mb-1.5">Class Name <span class="text-rose-500">*</span></label>
                    <input asp-for="ClassName" required placeholder="e.g. Class A"
                           class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500" />
                    <span asp-validation-for="ClassName" class="text-[11px] text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Place" class="block text-xs font-semibold text-slate-700 mb-1.5">Room / Place <span class="text-rose-500">*</span></label>
                    <input asp-for="Place" required placeholder="e.g. Room 101"
                           class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500" />
                    <span asp-validation-for="Place" class="text-[11px] text-red-600"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                <div>
                    <label asp-for="StudentLimit" class="block text-xs font-semibold text-slate-700 mb-1.5">Student Limit <span class="text-rose-500">*</span></label>
                    <input asp-for="StudentLimit" type="number" min="1" max="100" required
                           class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500" />
                    <span asp-validation-for="StudentLimit" class="text-[11px] text-red-600"></span>
                </div>

                <div>
                    <label asp-for="OpenDate" class="block text-xs font-semibold text-slate-700 mb-1.5">Open Date <span class="text-rose-500">*</span></label>
                    <input asp-for="OpenDate" type="date" required
                           class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500" />
                    <span asp-validation-for="OpenDate" class="text-[11px] text-red-600"></span>
                </div>

                <div>
                    <label asp-for="OpenTime" class="block text-xs font-semibold text-slate-700 mb-1.5">Open Time <span class="text-rose-500">*</span></label>
                    <input asp-for="OpenTime" type="text" required placeholder="e.g. 09:00 AM"
                           class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500" />
                    <span asp-validation-for="OpenTime" class="text-[11px] text-red-600"></span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-controller="SubClass" asp-action="Index" asp-route-role="@currentRole"
                   class="rounded-lg border border-slate-200 bg-white px-5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">
                    Cancel
                </a>
                <button type="submit"
                        class="rounded-lg bg-blue-600 px-6 py-2 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition">
                    Update Class
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
