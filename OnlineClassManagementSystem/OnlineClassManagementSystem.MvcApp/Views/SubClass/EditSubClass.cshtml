@model OnlineClassManagementSystem.Shared.models.SubClass.SubClassEditRequestModel

@{
    ViewData["Title"] = "Edit Class";
}

<div class="min-h-screen bg-slate-50 px-4 py-10">
    <div class="mx-auto max-w-2xl">
        <a asp-controller="SubClass" asp-action="Index" class="text-sm font-medium text-blue-600 hover:text-blue-800">
            ← Back to Classes
        </a>

        <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <h1 class="text-2xl font-bold text-slate-900">Edit Class</h1>
            <p class="mt-2 text-sm text-slate-500">Update the details for the class.</p>

            @if (ViewBag.Error != null)
            {
                <div class="mt-5 rounded-lg bg-red-50 p-3 text-sm text-red-700">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="SubClass" asp-action="Edit" method="post" class="mt-6 space-y-5">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

                <input type="hidden" asp-for="SubClassId" />

                <div>
                    <label asp-for="ClassName" class="mb-2 block text-sm font-semibold text-slate-700">Class Name</label>
                    <input asp-for="ClassName" required class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" placeholder="Enter class name" />
                    <span asp-validation-for="ClassName" class="text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Place" class="mb-2 block text-sm font-semibold text-slate-700">Place</label>
                    <input asp-for="Place" required class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" placeholder="Enter class location" />
                    <span asp-validation-for="Place" class="text-sm text-red-600"></span>
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <label asp-for="OpenDate" class="mb-2 block text-sm font-semibold text-slate-700">Open Date</label>
                        <input asp-for="OpenDate" type="date" required class="w-full rounded-lg border border-slate-300 px-3 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
                        <span asp-validation-for="OpenDate" class="text-sm text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="OpenTime" class="mb-2 block text-sm font-semibold text-slate-700">Open Time</label>
                        <input asp-for="OpenTime" type="text" required class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" placeholder="e.g. 09:00 AM" />
                        <span asp-validation-for="OpenTime" class="text-sm text-red-600"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="StudentLimit" class="mb-2 block text-sm font-semibold text-slate-700">Student Limit</label>
                    <input asp-for="StudentLimit" type="number" min="1" required class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" placeholder="Enter maximum students" />
                    <span asp-validation-for="StudentLimit" class="text-sm text-red-600"></span>
                </div>

                <div class="flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:justify-end">
                    <a asp-controller="SubClass" asp-action="Index" class="rounded-lg border border-slate-300 px-5 py-3 text-center font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
                    <button type="submit" class="rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700">Update Class</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
