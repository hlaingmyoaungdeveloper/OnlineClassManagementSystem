@model OnlineClassManagementSystem.Domain.models.SubClass.SubClassPatchRequestModel

<div class="p-8 max-w-2xl mx-auto">
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-bold text-gray-800">Edit Class</h3>
        </div>
        
        <form asp-action="Edit" asp-route-id="@ViewBag.SubClassId" method="post" class="p-6 space-y-4">
            
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                    @ViewBag.ErrorMessage
                </div>
            }

            <div>
                <label asp-for="ClassName" class="block text-sm font-medium text-gray-700 mb-1">Class Name</label>
                <input asp-for="ClassName" type="text" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                <span asp-validation-for="ClassName" class="text-red-500 text-xs"></span>
            </div>

            <div>
                <label asp-for="Place" class="block text-sm font-medium text-gray-700 mb-1">Location / Place</label>
                <input asp-for="Place" type="text" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                <span asp-validation-for="Place" class="text-red-500 text-xs"></span>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="OpenDate" class="block text-sm font-medium text-gray-700 mb-1">Open Date</label>
                    <input asp-for="OpenDate" type="date" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <span asp-validation-for="OpenDate" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label asp-for="OpenTime" class="block text-sm font-medium text-gray-700 mb-1">Open Time</label>
                    <input asp-for="OpenTime" type="time" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <span asp-validation-for="OpenTime" class="text-red-500 text-xs"></span>
                </div>
            </div>

            <div>
                <label asp-for="StudentLimit" class="block text-sm font-medium text-gray-700 mb-1">Student Limit</label>
                <input asp-for="StudentLimit" type="number" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                <span asp-validation-for="StudentLimit" class="text-red-500 text-xs"></span>
            </div>

            <div class="pt-4 flex justify-end space-x-3">
                <a asp-action="Index" class="px-4 py-2 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg font-medium transition">Cancel</a>
                <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium shadow-sm transition">Update Class</button>
            </div>
        </form>
    </div>
</div>