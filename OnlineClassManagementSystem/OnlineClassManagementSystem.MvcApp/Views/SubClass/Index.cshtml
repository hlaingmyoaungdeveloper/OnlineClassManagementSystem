@model OnlineClassManagementSystem.Shared.models.SubClass.SubClassListResponseModel

@{
    ViewData["Title"] = "Class Management";
    var classes = Model?.SubClassList ?? new List<OnlineClassManagementSystem.Shared.models.SubClass.SubClassModel>();
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");
}

<div class="p-6 md:p-8 space-y-6">

    <!-- Header Section with Title and Add Class Button -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Class Management</h1>
        </div>
        <div>
            <a asp-controller="SubClass" asp-action="Create" asp-route-role="@currentRole"
               class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Add Class
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3.5 text-xs text-emerald-800">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null || ViewBag.Error != null)
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-3.5 text-xs text-amber-800">
            @(TempData["Error"] ?? ViewBag.Error)
        </div>
    }

    <!-- Table Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50/80 text-xs font-semibold uppercase text-slate-500 border-b border-slate-200/80">
                    <tr>
                        <th class="px-6 py-3.5">ID</th>
                        <th class="px-6 py-3.5">Class Name</th>
                        <th class="px-6 py-3.5">Place / Room</th>
                        <th class="px-6 py-3.5">Schedule</th>
                        <th class="px-6 py-3.5">Capacity</th>
                        <th class="px-6 py-3.5 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (classes.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <svg class="h-8 w-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                                    <span>No classes found.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in classes)
                        {
                            var codeId = "C00" + item.SubClassId;

                            <tr class="hover:bg-slate-50/60 transition">
                                <td class="px-6 py-4 font-semibold text-slate-800">@codeId</td>
                                <td class="px-6 py-4 text-slate-800 font-medium">@item.ClassName</td>
                                <td class="px-6 py-4 text-slate-700">@(string.IsNullOrEmpty(item.Place) ? "-" : item.Place)</td>
                                <td class="px-6 py-4 text-slate-700">
                                    @(item.OpenDate?.ToString("yyyy-MM-dd") ?? "")
                                    @if (!string.IsNullOrEmpty(item.OpenTime))
                                    {
                                        <span class="text-xs text-slate-400 block">@item.OpenTime</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-slate-700">@(item.StudentCount ?? 0) / @item.StudentLimit</td>
                                <td class="px-6 py-4 text-center">
                                    <div class="inline-flex items-center gap-2">
                                        <a asp-controller="SubClass" asp-action="Edit" asp-route-id="@item.SubClassId" asp-route-role="@currentRole"
                                           class="text-blue-600 hover:text-blue-800 p-1" title="Edit">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                        </a>
                                        <form asp-controller="SubClass" asp-action="Delete" asp-route-id="@item.SubClassId" asp-route-role="@currentRole" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-rose-500 hover:text-rose-700 p-1" title="Delete" onclick="return confirm('Are you sure you want to delete this class?');">
                                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-200/80 px-6 py-3.5 bg-slate-50/50 text-xs text-slate-500">
            <span>Showing @(classes.Count > 0 ? "1-" + classes.Count : "0") of @classes.Count</span>
            <div class="flex items-center gap-1">
                <button class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-400 hover:bg-slate-100">&lt;</button>
                <button class="h-7 w-7 rounded-md bg-blue-600 text-white font-semibold flex items-center justify-center">1</button>
                <button class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-400 hover:bg-slate-100">&gt;</button>
            </div>
        </div>
    </div>

</div>
