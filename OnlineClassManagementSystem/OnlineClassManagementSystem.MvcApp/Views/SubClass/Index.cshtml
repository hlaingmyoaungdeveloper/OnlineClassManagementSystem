@model OnlineClassManagementSystem.Shared.models.SubClass.SubClassListResponseModel

@{
    ViewData["Title"] = "SubClass Management";
    var classes = Model?.SubClassList
        ?? new List<OnlineClassManagementSystem.Shared.models.SubClass.SubClassModel>();
}

<div class="flex min-h-screen">

    <!-- Sidebar -->
    <aside class="hidden w-64 shrink-0 flex-col bg-slate-900 text-white md:flex">
        <div class="border-b border-slate-700 px-6 py-7">
            <div class="flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-500 text-xl font-bold">
                    O
                </div>
                <div>
                    <h1 class="text-lg font-bold">Online Class</h1>
                    <p class="text-xs text-slate-400">Management System</p>
                </div>
            </div>
        </div>

        <nav class="flex-1 space-y-2 px-4 py-6">
            <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-wider text-slate-500">
                Main Menu
            </p>

            <a href="#" class="flex items-center gap-3 rounded-xl bg-indigo-600 px-4 py-3 font-medium text-white">
                <span>▦</span> Dashboard
            </a>

            <a asp-controller="SubClass" asp-action="Index"
               class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-300 transition hover:bg-slate-800 hover:text-white">
                <span>▤</span> Class Management
            </a>

            <a href="#" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-300 transition hover:bg-slate-800 hover:text-white">
                <span>♙</span> Enrollment
            </a>

            <a href="#" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-300 transition hover:bg-slate-800 hover:text-white">
                <span>◷</span> Timetable
            </a>

            <a href="#" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-300 transition hover:bg-slate-800 hover:text-white">
                <span>▧</span> Test Plans
            </a>

            <a href="#" class="flex items-center gap-3 rounded-xl px-4 py-3 text-slate-300 transition hover:bg-slate-800 hover:text-white">
                <span>◫</span> Reports
            </a>
        </nav>

        <div class="border-t border-slate-700 p-5">
            <p class="text-sm font-medium">Online Class System</p>
            <p class="mt-1 text-xs text-slate-400">Management Portal</p>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="min-w-0 flex-1">

        <!-- Top Navbar -->
        <header class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-200 bg-white px-5 py-4 md:px-8">
            <div>
                <p class="text-sm text-slate-500">Pages / Classes</p>
                <h2 class="mt-1 text-xl font-bold text-slate-900">
                    SubClass Management
                </h2>
            </div>

            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-100 font-bold text-indigo-700">
                    A
                </div>
                <div>
                    <p class="text-sm font-semibold text-slate-800">Administrator</p>
                    <p class="text-xs text-slate-500">Management Portal</p>
                </div>
            </div>
        </header>

        <div class="space-y-6 p-5 md:p-8">

            <!-- Page Heading -->
            <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
                <div>
                    <h1 class="text-2xl font-bold tracking-tight text-slate-900">
                        Class Management
                    </h1>
                    <p class="mt-2 text-sm text-slate-500">
                        View and manage all available classes.
                    </p>
                </div>

                <a asp-controller="SubClass"
                   asp-action="Create"
                   class="rounded-lg bg-blue-600 px-4 py-2.5 font-semibold text-white hover:bg-blue-700">
                    + Add New Class
                </a>
            </section>

            <!-- Error Message -->
            @if (ViewBag.Error != null)
            {
                <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                    @ViewBag.Error
                </div>
            }
            else if (Model != null && !Model.IsSuccess)
            {
                <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
                    @Model.Message
                </div>
            }

            <!-- Summary Cards -->
            <section class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">

                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <div class="flex items-center justify-between">
                        <p class="text-sm font-medium text-slate-500">Total Classes</p>
                        <span class="rounded-xl bg-indigo-50 px-3 py-2 text-lg text-indigo-600">▤</span>
                    </div>
                    <p class="mt-4 text-3xl font-bold text-slate-900">
                        @(Model?.IsSuccess == true ? classes.Count : 0)
                    </p>
                    <p class="mt-2 text-xs text-slate-500">Classes returned by API</p>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <div class="flex items-center justify-between">
                        <p class="text-sm font-medium text-slate-500">Total Students</p>
                        <span class="rounded-xl bg-emerald-50 px-3 py-2 text-lg text-emerald-600">♙</span>
                    </div>
                    <p class="mt-4 text-3xl font-bold text-slate-900">
                        @(Model?.IsSuccess == true
                            ? classes.Sum(c => c.StudentCount ?? 0)
                            : 0)
                    </p>
                    <p class="mt-2 text-xs text-slate-500">Across listed classes</p>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:col-span-2 xl:col-span-1">
                    <div class="flex items-center justify-between">
                        <p class="text-sm font-medium text-slate-500">Total Capacity</p>
                        <span class="rounded-xl bg-violet-50 px-3 py-2 text-lg text-violet-600">◎</span>
                    </div>
                    <p class="mt-4 text-3xl font-bold text-slate-900">
                        @(Model?.IsSuccess == true
                            ? classes.Sum(c => c.StudentLimit)
                            : 0)
                    </p>
                    <p class="mt-2 text-xs text-slate-500">Combined student limit</p>
                </div>
            </section>

            <!-- Class Table -->
            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

                <div class="flex flex-col justify-between gap-4 border-b border-slate-200 p-5 sm:flex-row sm:items-center">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">All Classes</h3>
                        <p class="mt-1 text-sm text-slate-500">
                            Class information retrieved from your Web API.
                        </p>
                    </div>

                    <div class="relative">
                        <input id="classSearch"
                               type="search"
                               placeholder="Search classes..."
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 sm:w-64" />
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[850px] text-left text-sm">
                        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
                            <tr>
                                <th class="px-6 py-4 font-semibold">Class</th>
                                <th class="px-6 py-4 font-semibold">Place</th>
                                <th class="px-6 py-4 font-semibold">Open Date</th>
                                <th class="px-6 py-4 font-semibold">Open Time</th>
                                <th class="px-6 py-4 font-semibold">Students</th>
                                <th class="px-6 py-4 font-semibold">Capacity</th>
<th class="px-6 py-4 font-semibold">Actions</th>
                            </tr>
                        </thead>

                        <tbody id="classTableBody" class="divide-y divide-slate-100">
                            @if (Model?.IsSuccess == true && classes.Count > 0)
                            {
                                @foreach (var item in classes)
                                {
                                    <tr class="class-row transition hover:bg-slate-50">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-50 font-bold text-indigo-600">
                                                    @item.ClassName.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>
                                                    <p class="font-semibold text-slate-900">
                                                        @item.ClassName
                                                    </p>
                                                    <p class="mt-1 text-xs text-slate-500">
                                                        ID: @item.SubClassId
                                                    </p>
                                                </div>
                                            </div>
                                        </td>

                                        <td class="px-6 py-4 text-slate-600">
                                            @item.Place
                                        </td>

                                        <td class="px-6 py-4 text-slate-600">
                                            @(item.OpenDate?.ToString("dd MMM yyyy") ?? "-")
                                        </td>

                                        <td class="px-6 py-4 text-slate-600">
                                            @item.OpenTime
                                        </td>

                                        <td class="px-6 py-4">
                                            @(item.StudentCount ?? 0)
                                        </td>

                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                <span class="font-medium text-slate-700">
                                                    @item.StudentLimit
                                                </span>
                                                <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                                                    Capacity
                                                </span>
                                            </div>
                                        </td>
                                    <td class="px-6 py-4 text-right space-x-2">
    <a asp-controller="SubClass" asp-action="Edit" asp-route-id="@item.SubClassId" class="text-blue-600 hover:underline">Edit</a>
    <form asp-controller="SubClass" asp-action="Delete" asp-route-id="@item.SubClassId" method="post" class="inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="text-red-600 hover:underline" onclick="return confirm('Are you sure you want to delete this class?');">Delete</button>
    </form>
</td>
</tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center">
                                        <p class="font-semibold text-slate-700">
                                            No classes to display
                                        </p>
                                        <p class="mt-2 text-sm text-slate-500">
                                            Check the API response or try again later.
                                        </p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="border-t border-slate-200 px-6 py-4">
                    <p id="classCount" class="text-sm text-slate-500">
                        Showing @classes.Count classes
                    </p>
                </div>
            </section>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById("classSearch");
        const rows = Array.from(document.querySelectorAll(".class-row"));
        const countLabel = document.getElementById("classCount");

        searchInput.addEventListener("input", function () {
            const query = this.value.toLowerCase().trim();
            let visibleCount = 0;

            rows.forEach(row => {
                const matches = row.textContent.toLowerCase().includes(query);
                row.classList.toggle("hidden", !matches);

                if (matches) visibleCount++;
            });

            countLabel.textContent =
                `Showing ${visibleCount} of ${rows.length} classes`;
        });
    </script>
}
