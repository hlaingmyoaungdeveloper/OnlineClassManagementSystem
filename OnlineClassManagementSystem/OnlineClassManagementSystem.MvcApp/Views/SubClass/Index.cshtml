@model OnlineClassManagementSystem.Shared.models.SubClass.SubClassListResponseModel

@{
    ViewData["Title"] = "Class Management";
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");

    var pageNo = (int)(ViewBag.PageNo ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var searchVal = ViewBag.Search as string ?? "";
    var statusVal = ViewBag.Status as string ?? "all";
}

<div class="p-6 md:p-8 space-y-6">

    <!-- Header Section with Title, Subtitle, and Add Class Button -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Class Management</h1>
            <p class="text-xs text-slate-500 mt-1">Manage and monitor all class schedules, room allocations, capacity, and student enrollments.</p>
        </div>
        <div class="flex items-center gap-2.5">
            <button type="button" onclick="openCreateClassModal()"
               class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-4 py-2.5 text-xs font-semibold text-white shadow-sm hover:bg-blue-700 transition cursor-pointer">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Add Class
            </button>
        </div>
    </div>

    <!-- Metric Overview Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <!-- Total Classes -->
        <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Total Classes</span>
                <div class="h-7 w-7 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                </div>
            </div>
            <div id="statTotalClassesSkel" class="mt-2 h-7 w-12 rounded skeleton-shimmer"></div>
            <p id="statTotalClasses" class="hidden mt-2 text-2xl font-bold tracking-tight text-slate-900">0</p>
        </div>

        <!-- Total Enrolled -->
        <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Total Enrolled</span>
                <div class="h-7 w-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                </div>
            </div>
            <div id="statTotalEnrolledSkel" class="mt-2 h-7 w-12 rounded skeleton-shimmer"></div>
            <p id="statTotalEnrolled" class="hidden mt-2 text-2xl font-bold tracking-tight text-slate-900">0</p>
        </div>

        <!-- Total Capacity -->
        <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Total Capacity</span>
                <div class="h-7 w-7 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                </div>
            </div>
            <div id="statTotalCapacitySkel" class="mt-2 h-7 w-12 rounded skeleton-shimmer"></div>
            <p id="statTotalCapacity" class="hidden mt-2 text-2xl font-bold tracking-tight text-slate-900">0</p>
        </div>

        <!-- Available Seats -->
        <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Available Seats</span>
                <div class="h-7 w-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
            </div>
            <div id="statAvailableSeatsSkel" class="mt-2 h-7 w-12 rounded skeleton-shimmer"></div>
            <p id="statAvailableSeats" class="hidden mt-2 text-2xl font-bold tracking-tight text-slate-900">0</p>
        </div>
    </div>

    <!-- Controls Row: Search, Availability Filter, and View Mode Toggle -->
    <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200/80 bg-white p-3.5 shadow-2xs">
        <form id="classFilterForm" onsubmit="event.preventDefault(); triggerClassSearch();" class="flex flex-wrap items-center gap-3 flex-1">
            <!-- Search Input -->
            <div class="relative flex-1 min-w-[220px] max-w-md">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </span>
                <input type="text" id="classSearchInput" value="@searchVal" placeholder="Search by class name or place..."
                       class="w-full rounded-lg border border-slate-200 bg-slate-50/50 py-2 pl-9 pr-3 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white transition" />
            </div>

            <!-- Status Filter Dropdown -->
            <div class="w-40">
                <select id="statusFilter" onchange="triggerClassSearch()" class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs font-medium text-slate-700 outline-none focus:border-blue-500 focus:bg-white transition cursor-pointer">
                    <option value="all">All Status</option>
                    <option value="available">Available Seats</option>
                    <option value="full">Class Full</option>
                </select>
            </div>

            <button type="submit" class="rounded-lg bg-blue-600 hover:bg-blue-700 px-4 py-2 text-xs font-semibold text-white shadow-xs transition cursor-pointer">
                Search
            </button>
            <button type="button" id="btnResetFilter" onclick="resetClassFilters()" class="hidden rounded-lg border border-slate-200 bg-white hover:bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 transition cursor-pointer">
                Reset
            </button>
        </form>

        <!-- View Mode Switcher: Table View & Card View -->
        <div class="flex items-center gap-1 rounded-lg border border-slate-200 bg-slate-50/80 p-1">
            <button id="tableViewBtn" type="button" title="Table View"
                    class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition bg-white text-blue-600 shadow-2xs cursor-pointer">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                <span>Table</span>
            </button>
            <button id="cardViewBtn" type="button" title="Card View"
                    class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition text-slate-500 hover:text-slate-800 cursor-pointer">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>Cards</span>
            </button>
        </div>
    </div>

    <!-- VIEW 1: TABLE VIEW -->
    <div id="tableViewContainer" class="rounded-xl border border-slate-200/80 bg-white shadow-2xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50/80 text-xs font-semibold uppercase text-slate-500 border-b border-slate-200/80">
                    <tr>
                        <th class="px-6 py-3.5">No</th>
                        <th class="px-6 py-3.5">Class Name</th>
                        <th class="px-6 py-3.5">Place / Room</th>
                        <th class="px-6 py-3.5">Schedule</th>
                        <th class="px-6 py-3.5">Capacity & Occupancy</th>
                        <th class="px-6 py-3.5">Status</th>
                        <th class="px-6 py-3.5 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100" id="classTableBody">
                    @for (int i = 0; i < 5; i++)
                    {
                        <tr>
                            <td class="px-6 py-4"><div class="h-4 w-6 rounded skeleton-shimmer"></div></td>
                            <td class="px-6 py-4"><div class="h-4 w-32 rounded skeleton-shimmer"></div></td>
                            <td class="px-6 py-4"><div class="h-4 w-24 rounded skeleton-shimmer"></div></td>
                            <td class="px-6 py-4"><div class="h-4 w-28 rounded skeleton-shimmer"></div></td>
                            <td class="px-6 py-4"><div class="h-4 w-36 rounded skeleton-shimmer"></div></td>
                            <td class="px-6 py-4"><div class="h-4 w-16 rounded skeleton-shimmer"></div></td>
                            <td class="px-6 py-4 text-center"><div class="mx-auto h-4 w-20 rounded skeleton-shimmer"></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-200/80 px-6 py-3.5 bg-slate-50/50 text-xs text-slate-500">
            <div class="flex items-center gap-3">
                <span id="showingText">Loading classes...</span>
                <div class="flex items-center gap-1.5 pl-3 border-l border-slate-200">
                    <span>Per page:</span>
                    <select id="pageSizeSelect" onchange="changeClassPageSize(this.value)"
                            class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 outline-none focus:border-blue-500 cursor-pointer">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>

            <div id="paginationNav" class="flex items-center gap-1"></div>
        </div>
    </div>

    <!-- VIEW 2: CARD VIEW -->
    <div id="cardViewContainer" class="hidden grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5"></div>

</div>

<!-- CREATE CLASS POPUP MODAL -->
<div id="createClassModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs hidden transition-opacity duration-200">
    <div class="relative w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-2xl animate-in fade-in zoom-in-95 duration-150">
        <!-- Close Button (X) -->
        <button type="button" onclick="closeCreateClassModal()" class="absolute top-4 right-4 rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition cursor-pointer">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>

        <!-- Header -->
        <div class="flex items-center gap-3 pb-4 mb-5 border-b border-slate-100">
            <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-900">Create New Class</h3>
                <p class="text-xs text-slate-500">Add a new class schedule, room allocation, and student capacity</p>
            </div>
        </div>

        <form id="createClassForm" onsubmit="event.preventDefault(); submitCreateClass();" class="space-y-4">
            <!-- Class Name -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Class Name <span class="text-rose-500">*</span></label>
                <input name="ClassName" id="createClassName" required placeholder="e.g. Class A, Grade 10 Math"
                       class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
            </div>

            <!-- Room / Place -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Room / Place <span class="text-rose-500">*</span></label>
                <input name="Place" id="createPlace" required placeholder="e.g. Room 101, Lab A"
                       class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
            </div>

            <!-- Grid 3 items: StudentLimit, OpenDate, OpenTime -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Capacity <span class="text-rose-500">*</span></label>
                    <input name="StudentLimit" id="createStudentLimit" type="number" min="1" max="500" value="30" required
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Open Date <span class="text-rose-500">*</span></label>
                    <input name="OpenDate" id="createOpenDate" type="date" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" required
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Open Time <span class="text-rose-500">*</span></label>
                    <input name="OpenTime" id="createOpenTime" type="time" value="09:00" required
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
                </div>
            </div>

            <!-- Modal Action Buttons -->
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeCreateClassModal()"
                        class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition cursor-pointer">
                    Cancel
                </button>
                <button type="submit" id="btnSubmitCreateClass"
                        class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-xs font-semibold text-white shadow-sm transition cursor-pointer">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    <span>Create Class</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT CLASS POPUP MODAL -->
<div id="editClassModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs hidden transition-opacity duration-200">
    <div class="relative w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-2xl animate-in fade-in zoom-in-95 duration-150">
        <!-- Close Button (X) -->
        <button type="button" onclick="closeEditClassModal()" class="absolute top-4 right-4 rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition cursor-pointer">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>

        <!-- Header -->
        <div class="flex items-center gap-3 pb-4 mb-5 border-b border-slate-100">
            <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                </svg>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-900">Edit Class</h3>
                <p class="text-xs text-slate-500">Update class schedule, room allocation, and student capacity</p>
            </div>
        </div>

        <form id="editClassForm" onsubmit="event.preventDefault(); submitEditClass();" class="space-y-4">
            <input type="hidden" id="editSubClassId" />

            <!-- Class Name -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Class Name <span class="text-rose-500">*</span></label>
                <input id="editClassName" required placeholder="e.g. Class A, Grade 10 Math"
                       class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
            </div>

            <!-- Room / Place -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Room / Place <span class="text-rose-500">*</span></label>
                <input id="editPlace" required placeholder="e.g. Room 101, Lab A"
                       class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
            </div>

            <!-- Grid 3 items: StudentLimit, OpenDate, OpenTime -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Capacity <span class="text-rose-500">*</span></label>
                    <input id="editStudentLimit" type="number" min="1" max="500" required
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Open Date <span class="text-rose-500">*</span></label>
                    <input id="editOpenDate" type="date" required
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Open Time <span class="text-rose-500">*</span></label>
                    <input id="editOpenTime" type="time" required
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
                </div>
            </div>

            <!-- Modal Action Buttons -->
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeEditClassModal()"
                        class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition cursor-pointer">
                    Cancel
                </button>
                <button type="submit" id="btnSubmitEditClass"
                        class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-xs font-semibold text-white shadow-sm transition cursor-pointer">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span>Update Class</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ENROLL STUDENT MODAL -->
<div id="enrollModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs hidden transition-opacity duration-200">
    <div class="relative w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-2xl animate-in fade-in zoom-in-95 duration-150">
        <!-- Close Button (X) -->
        <button type="button" onclick="closeEnrollModal()" class="absolute top-4 right-4 rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition cursor-pointer">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>

        <div class="flex items-center gap-3 pb-4 mb-4 border-b border-slate-100">
            <div class="h-10 w-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-900">Enroll Student</h3>
                <p class="text-xs text-slate-500">Add a student to <span id="modalClassName" class="font-semibold text-emerald-600">Selected Class</span></p>
            </div>
        </div>

        <!-- Class Preview Info Banner -->
        <div class="rounded-xl bg-slate-50 border border-slate-100 p-3 mb-5 grid grid-cols-2 gap-3 text-xs">
            <div>
                <span class="text-[11px] text-slate-400 uppercase font-semibold block">Room / Place</span>
                <span id="modalPlace" class="font-medium text-slate-700">Room 101</span>
            </div>
            <div>
                <span class="text-[11px] text-slate-400 uppercase font-semibold block">Current Occupancy</span>
                <span id="modalCapacity" class="font-semibold text-slate-800">0 / 30 seats</span>
            </div>
        </div>

        <form id="enrollStudentForm" onsubmit="event.preventDefault(); submitEnrollStudent();" class="space-y-4">
            <input type="hidden" name="ClassId" id="modalClassId" value="0" />
            <input type="hidden" name="IsNewStudent" id="modalIsNewStudentInput" value="false" />

            <!-- Student Option Toggle: Existing Student vs New Student -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Student Option</label>
                <div class="grid grid-cols-2 gap-2 p-1 rounded-xl bg-slate-100/80 border border-slate-200/80">
                    <button type="button" id="modalTabExistingBtn" onclick="toggleModalStudentMode(false)"
                            class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-semibold transition bg-white text-emerald-600 shadow-2xs cursor-pointer">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        Existing Student
                    </button>
                    <button type="button" id="modalTabNewBtn" onclick="toggleModalStudentMode(true)"
                            class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-semibold transition text-slate-500 hover:text-slate-800 cursor-pointer">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                        + New Student
                    </button>
                </div>
            </div>

            <!-- Existing Student Section -->
            <div id="modalExistingSection">
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                    Select Existing Student <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                    <select name="StudentId" id="modalStudentSelect" required
                            class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-emerald-500 focus:bg-white focus:ring-2 focus:ring-emerald-100 transition cursor-pointer">
                        <option value="">-- Choose a Registered Student --</option>
                    </select>
                    <div id="studentSelectLoading" class="hidden absolute right-3 top-3">
                        <div class="h-3.5 w-3.5 animate-spin rounded-full border-2 border-emerald-500 border-t-transparent"></div>
                    </div>
                </div>
            </div>

            <!-- New Student Data Section -->
            <div id="modalNewSection" class="hidden space-y-3 p-3.5 rounded-xl border border-emerald-100 bg-emerald-50/40">
                <div class="flex items-center gap-1.5 text-xs font-semibold text-emerald-800 mb-1">
                    <svg class="h-4 w-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>Enter New Student Information</span>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                        Full Name <span class="text-rose-500">*</span>
                    </label>
                    <input type="text" name="FullName" id="modalFullName" placeholder="e.g. Aung Min Khant"
                           class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs text-slate-700 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 transition" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                        Email Address <span class="text-rose-500">*</span>
                    </label>
                    <input type="email" name="Email" id="modalEmail" placeholder="e.g. aungmin@gmail.com"
                           class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs text-slate-700 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 transition" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                        Telegram / Contact <span class="text-slate-400 font-normal">(Optional)</span>
                    </label>
                    <input type="text" name="TelegramUsername" id="modalTelegram" placeholder="e.g. @@aungmin"
                           class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs text-slate-700 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 transition" />
                </div>
            </div>

            <!-- Enrollment Date -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                    Enrollment Date <span class="text-rose-500">*</span>
                </label>
                <input type="date" name="EnrollDate" id="modalEnrollDate" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" required
                       class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-emerald-500 focus:bg-white focus:ring-2 focus:ring-emerald-100 transition cursor-pointer" />
            </div>

            <!-- Modal Action Buttons -->
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeEnrollModal()"
                        class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition cursor-pointer">
                    Cancel
                </button>
                <button type="submit" id="btnSubmitEnroll"
                        class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 px-5 py-2 text-xs font-semibold text-white shadow-sm transition cursor-pointer">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span id="modalSubmitBtnText">Confirm Enrollment</span>
                </button>
            </div>
        </form>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const currentRole = '@currentRole';

        let currentPageNo = @pageNo;
        let currentPageSize = @pageSize;
        let currentSearch = '@searchVal';
        let currentStatus = '@statusVal';
        let cachedStudents = null;

        // View toggle logic
        const tableViewBtn = document.getElementById('tableViewBtn');
        const cardViewBtn = document.getElementById('cardViewBtn');
        const tableViewContainer = document.getElementById('tableViewContainer');
        const cardViewContainer = document.getElementById('cardViewContainer');

        function setViewMode(mode) {
            if (mode === 'card') {
                tableViewContainer.classList.add('hidden');
                cardViewContainer.classList.remove('hidden');

                cardViewBtn.classList.add('bg-white', 'text-blue-600', 'shadow-2xs');
                cardViewBtn.classList.remove('text-slate-500');

                tableViewBtn.classList.remove('bg-white', 'text-blue-600', 'shadow-2xs');
                tableViewBtn.classList.add('text-slate-500');
            } else {
                cardViewContainer.classList.add('hidden');
                tableViewContainer.classList.remove('hidden');

                tableViewBtn.classList.add('bg-white', 'text-blue-600', 'shadow-2xs');
                tableViewBtn.classList.remove('text-slate-500');

                cardViewBtn.classList.remove('bg-white', 'text-blue-600', 'shadow-2xs');
                cardViewBtn.classList.add('text-slate-500');
            }
            try {
                localStorage.setItem('subclass_view_mode', mode);
            } catch (e) {}
        }

        tableViewBtn.addEventListener('click', () => setViewMode('table'));
        cardViewBtn.addEventListener('click', () => setViewMode('card'));

        const savedMode = localStorage.getItem('subclass_view_mode');
        if (savedMode === 'card') {
            setViewMode('card');
        } else {
            setViewMode('table');
        }

        // Load Classes via AJAX
        function loadClasses(pageNo = currentPageNo, pageSize = currentPageSize, search = currentSearch, status = currentStatus) {
            currentPageNo = pageNo;
            currentPageSize = pageSize;
            currentSearch = search;
            currentStatus = status;

            // Reset button visibility
            const resetBtn = document.getElementById('btnResetFilter');
            if (resetBtn) {
                if ((currentSearch && currentSearch.trim().length > 0) || currentStatus !== 'all') {
                    resetBtn.classList.remove('hidden');
                } else {
                    resetBtn.classList.add('hidden');
                }
            }

            // Show skeleton rows in table
            const tbody = document.getElementById('classTableBody');
            tbody.innerHTML = `
                @for (int i = 0; i < 5; i++)
                {
                    <tr>
                        <td class="px-6 py-4"><div class="h-4 w-6 rounded skeleton-shimmer"></div></td>
                        <td class="px-6 py-4"><div class="h-4 w-32 rounded skeleton-shimmer"></div></td>
                        <td class="px-6 py-4"><div class="h-4 w-24 rounded skeleton-shimmer"></div></td>
                        <td class="px-6 py-4"><div class="h-4 w-28 rounded skeleton-shimmer"></div></td>
                        <td class="px-6 py-4"><div class="h-4 w-36 rounded skeleton-shimmer"></div></td>
                        <td class="px-6 py-4"><div class="h-4 w-16 rounded skeleton-shimmer"></div></td>
                        <td class="px-6 py-4 text-center"><div class="mx-auto h-4 w-20 rounded skeleton-shimmer"></div></td>
                    </tr>
                }
            `;

            const queryParams = $.param({
                pageNo: currentPageNo,
                pageSize: currentPageSize,
                search: currentSearch || '',
                status: currentStatus || 'all'
            });

            $.ajax({
                url: '@Url.Action("GetData", "SubClass")?' + queryParams,
                type: 'GET',
                dataType: 'json',
                timeout: 15000,
                success: function (response) {
                    if (response && response.isSuccess) {
                        const list = response.subClassList || [];
                        const totalClasses = response.totalClasses > 0 ? response.totalClasses : (response.totalCount || list.length);
                        const totalEnrolled = response.totalEnrolled || 0;
                        const totalCapacity = response.totalCapacity || 0;
                        const availableSeats = response.availableSeats >= 0 ? response.availableSeats : Math.max(0, totalCapacity - totalEnrolled);
                        const totalPages = response.totalPages || Math.max(1, Math.ceil(totalClasses / currentPageSize));

                        // Update Stats
                        updateSubClassStat('statTotalClasses', 'statTotalClassesSkel', totalClasses);
                        updateSubClassStat('statTotalEnrolled', 'statTotalEnrolledSkel', totalEnrolled);
                        updateSubClassStat('statTotalCapacity', 'statTotalCapacitySkel', totalCapacity);
                        updateSubClassStat('statAvailableSeats', 'statAvailableSeatsSkel', availableSeats);

                        renderClassTable(list);
                        renderClassCards(list);
                        renderClassPagination(totalClasses, totalPages, currentPageNo, currentPageSize);
                    } else {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="7" class="px-6 py-12 text-center text-amber-600">
                                    <p class="font-medium">${escapeHtml(response ? response.message : 'Error loading classes')}</p>
                                    <button onclick="loadClasses()" class="mt-2 text-xs text-blue-600 hover:underline">Retry</button>
                                </td>
                            </tr>
                        `;
                    }
                },
                error: function () {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-rose-500">
                                <p class="font-medium">Failed to connect to Web API.</p>
                                <button onclick="loadClasses()" class="mt-2 text-xs text-blue-600 hover:underline">Retry</button>
                            </td>
                        </tr>
                    `;
                }
            });
        }

        function updateSubClassStat(valId, skelId, value) {
            const valEl = document.getElementById(valId);
            const skelEl = document.getElementById(skelId);
            if (valEl) {
                valEl.innerText = value;
                valEl.classList.remove('hidden');
            }
            if (skelEl) {
                skelEl.classList.add('hidden');
            }
        }

        function renderClassTable(classes) {
            const tbody = document.getElementById('classTableBody');
            tbody.innerHTML = '';

            if (!classes || classes.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="px-6 py-12 text-center text-slate-400">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <svg class="h-8 w-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                                <span>No classes found.</span>
                            </div>
                        </td>
                    </tr>
                `;
                return;
            }

            let rowNo = (currentPageNo - 1) * currentPageSize;
            classes.forEach(item => {
                rowNo++;
                const codeId = 'C00' + item.subClassId;
                const currentCount = item.studentCount || 0;
                const limit = item.studentLimit || 0;
                const percent = limit > 0 ? Math.min(100, Math.round((currentCount / limit) * 100)) : 0;
                const isFull = currentCount >= limit;

                const openDateFormatted = item.openDate ? formatDate(item.openDate) : '-';
                const openTimeFormatted = item.openTime ? formatTime(item.openTime) : '-';

                const statusBadge = isFull
                    ? `<span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-semibold text-rose-700 ring-1 ring-rose-200"><span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>Full</span>`
                    : `<span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Available</span>`;

                const enrollBtn = !isFull
                    ? `<button type="button" onclick="openEnrollModal(${item.subClassId}, '${escapeJs(item.className)}', '${escapeJs(item.place || '')}', ${currentCount}, ${limit})"
                               class="rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 p-1.5 transition cursor-pointer" title="Enroll Student">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                       </button>`
                    : `<span class="rounded-lg bg-slate-50 text-slate-300 p-1.5 cursor-not-allowed" title="Class Full"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg></span>`;

                const rowHtml = `
                    <tr class="hover:bg-slate-50/60 transition">
                        <td class="px-6 py-4 font-semibold text-slate-800">
                            <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">${rowNo}</span>
                        </td>
                        <td class="px-6 py-4 font-medium text-slate-900">
                            <div class="flex items-center gap-2.5">
                                <div class="h-8 w-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                                </div>
                                <div>
                                    <span class="block font-semibold text-slate-900">${escapeHtml(item.className)}</span>
                                    <span class="text-[11px] text-slate-400 font-normal">Class No: ${codeId}</span>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-slate-700">
                            <div class="flex items-center gap-1.5">
                                <svg class="h-3.5 w-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                <span>${escapeHtml(item.place || 'Not Assigned')}</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-slate-600">
                            <div class="text-xs">
                                <span class="font-medium text-slate-800">${openDateFormatted}</span>
                                <span class="text-[11px] text-slate-400 block">${openTimeFormatted}</span>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="w-36">
                                <div class="flex items-center justify-between text-xs mb-1">
                                    <span class="font-semibold text-slate-700">${currentCount} / ${limit}</span>
                                    <span class="text-[10px] text-slate-400">${percent}%</span>
                                </div>
                                <div class="h-1.5 w-full rounded-full bg-slate-100 overflow-hidden">
                                    <div class="h-full rounded-full ${percent >= 100 ? 'bg-rose-500' : percent >= 75 ? 'bg-amber-500' : 'bg-emerald-500'}" style="width: ${percent}%;"></div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4">${statusBadge}</td>
                        <td class="px-6 py-4 text-center">
                            <div class="inline-flex items-center gap-1.5">
                                ${enrollBtn}
                                <button type="button" onclick="openEditClassModal(${item.subClassId}, '${escapeJs(item.className)}', '${escapeJs(item.place || '')}', ${item.studentLimit || 30}, '${item.openDate || ''}', '${item.openTime || ''}')"
                                        class="rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 p-1.5 transition cursor-pointer" title="Edit Class">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                </button>
                                <button type="button" onclick="deleteClass(${item.subClassId})"
                                        class="rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 p-1.5 transition cursor-pointer" title="Delete Class">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', rowHtml);
            });
        }

        function renderClassCards(classes) {
            const container = document.getElementById('cardViewContainer');
            container.innerHTML = '';

            if (!classes || classes.length === 0) return;

            classes.forEach(item => {
                const codeId = 'C00' + item.subClassId;
                const currentCount = item.studentCount || 0;
                const limit = item.studentLimit || 0;
                const percent = limit > 0 ? Math.min(100, Math.round((currentCount / limit) * 100)) : 0;
                const isFull = currentCount >= limit;

                const openDateFormatted = item.openDate ? formatDate(item.openDate) : '-';
                const openTimeFormatted = item.openTime ? formatTime(item.openTime) : '-';

                const cardHtml = `
                    <div class="rounded-xl border border-slate-200/80 bg-white p-5 shadow-2xs hover:border-blue-300 hover:shadow-md transition flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-[11px] font-semibold text-slate-400">Class No: ${codeId}</span>
                                ${isFull 
                                    ? '<span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-semibold text-rose-700 ring-1 ring-rose-200"><span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>Full</span>'
                                    : '<span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-emerald-200"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Available</span>'}
                            </div>
                            <h3 class="text-base font-bold text-slate-900">${escapeHtml(item.className)}</h3>
                            <p class="text-xs text-slate-500 mt-1 flex items-center gap-1.5">
                                <svg class="h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                ${escapeHtml(item.place || 'Not Assigned')}
                            </p>
                            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600">
                                <span>Schedule:</span>
                                <span class="font-semibold text-slate-800">${openDateFormatted} at ${openTimeFormatted}</span>
                            </div>
                            <div class="mt-3">
                                <div class="flex items-center justify-between text-xs mb-1">
                                    <span class="text-slate-500">Capacity:</span>
                                    <span class="font-semibold text-slate-800">${currentCount} / ${limit} (${percent}%)</span>
                                </div>
                                <div class="h-1.5 w-full rounded-full bg-slate-100 overflow-hidden">
                                    <div class="h-full rounded-full ${percent >= 100 ? 'bg-rose-500' : 'bg-emerald-500'}" style="width: ${percent}%;"></div>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center justify-end gap-2 mt-5 pt-3 border-t border-slate-100">
                            ${!isFull 
                                ? `<button type="button" onclick="openEnrollModal(${item.subClassId}, '${escapeJs(item.className)}', '${escapeJs(item.place || '')}', ${currentCount}, ${limit})"
                                          class="rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 text-xs font-semibold shadow-xs transition cursor-pointer">
                                        Enroll
                                   </button>` 
                                : ''}
                            <button type="button" onclick="openEditClassModal(${item.subClassId}, '${escapeJs(item.className)}', '${escapeJs(item.place || '')}', ${item.studentLimit || 30}, '${item.openDate || ''}', '${item.openTime || ''}')"
                                    class="rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 px-3 py-1.5 text-xs font-semibold transition cursor-pointer">
                                Edit
                            </button>
                            <button type="button" onclick="deleteClass(${item.subClassId})"
                                    class="rounded-lg border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 px-2.5 py-1.5 text-xs font-semibold transition cursor-pointer">
                                Delete
                            </button>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', cardHtml);
            });
        }

        function renderClassPagination(totalCount, totalPages, pageNo, pageSize) {
            const showingText = document.getElementById('showingText');
            const startItem = totalCount > 0 ? (pageNo - 1) * pageSize + 1 : 0;
            const endItem = Math.min(pageNo * pageSize, totalCount);

            if (showingText) {
                showingText.innerText = totalCount > 0 
                    ? `Showing ${startItem} - ${endItem} of ${totalCount} classes`
                    : 'Showing 0 classes';
            }

            const paginationNav = document.getElementById('paginationNav');
            paginationNav.innerHTML = '';

            const hasPrevious = pageNo > 1;
            const hasNext = pageNo < totalPages;

            if (hasPrevious) {
                paginationNav.insertAdjacentHTML('beforeend', `
                    <button type="button" onclick="loadClasses(${pageNo - 1})"
                            class="h-7 px-2.5 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium cursor-pointer">
                        &lsaquo; Prev
                    </button>
                `);
            } else {
                paginationNav.insertAdjacentHTML('beforeend', `
                    <span class="h-7 px-2.5 rounded-md border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-300 cursor-not-allowed">
                        &lsaquo; Prev
                    </span>
                `);
            }

            const startPage = Math.max(1, pageNo - 2);
            const endPage = Math.min(totalPages, pageNo + 2);

            for (let i = startPage; i <= endPage; i++) {
                if (i === pageNo) {
                    paginationNav.insertAdjacentHTML('beforeend', `
                        <span class="h-7 w-7 rounded-md bg-blue-600 text-white font-semibold flex items-center justify-center shadow-xs">${i}</span>
                    `);
                } else {
                    paginationNav.insertAdjacentHTML('beforeend', `
                        <button type="button" onclick="loadClasses(${i})"
                                class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium cursor-pointer">${i}</button>
                    `);
                }
            }

            if (hasNext) {
                paginationNav.insertAdjacentHTML('beforeend', `
                    <button type="button" onclick="loadClasses(${pageNo + 1})"
                            class="h-7 px-2.5 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium cursor-pointer">
                        Next &rsaquo;
                    </button>
                `);
            } else {
                paginationNav.insertAdjacentHTML('beforeend', `
                    <span class="h-7 px-2.5 rounded-md border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-300 cursor-not-allowed">
                        Next &rsaquo;
                    </span>
                `);
            }
        }

        function triggerClassSearch() {
            const input = document.getElementById('classSearchInput');
            const searchVal = input ? input.value.trim() : '';
            const statusVal = document.getElementById('statusFilter').value;
            loadClasses(1, currentPageSize, searchVal, statusVal);
        }

        function resetClassFilters() {
            const input = document.getElementById('classSearchInput');
            if (input) input.value = '';
            const filter = document.getElementById('statusFilter');
            if (filter) filter.value = 'all';
            loadClasses(1, currentPageSize, '', 'all');
        }

        function changeClassPageSize(size) {
            loadClasses(1, parseInt(size, 10), currentSearch, currentStatus);
        }

        // Create Class AJAX
        const createClassModal = document.getElementById('createClassModal');

        function openCreateClassModal() {
            createClassModal.classList.remove('hidden');
            const firstInput = document.getElementById('createClassName');
            if (firstInput) setTimeout(() => firstInput.focus(), 100);
        }

        function closeCreateClassModal() {
            createClassModal.classList.add('hidden');
        }

        function submitCreateClass() {
            const form = document.getElementById('createClassForm');
            const token = $('input[name="__RequestVerificationToken"]').val();
            const submitBtn = document.getElementById('btnSubmitCreateClass');

            const model = {
                ClassName: document.getElementById('createClassName').value.trim(),
                Place: document.getElementById('createPlace').value.trim(),
                StudentLimit: parseInt(document.getElementById('createStudentLimit').value, 10),
                OpenDate: document.getElementById('createOpenDate').value,
                OpenTime: document.getElementById('createOpenTime').value
            };

            if (!model.ClassName || !model.Place || !model.StudentLimit) {
                alert('Please fill in all required fields.');
                return;
            }

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="inline-block animate-spin mr-1">⌛</span> Creating...';
            }

            $.ajax({
                url: '@Url.Action("Create", "SubClass")?role=' + encodeURIComponent(currentRole),
                type: 'POST',
                data: model,
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (res) {
                    if (res && res.isSuccess) {
                        closeCreateClassModal();
                        form.reset();
                        if (window.showToast) window.showToast(res.message || 'Class created successfully!', true);
                        loadClasses();
                    } else {
                        if (window.showToast) window.showToast(res ? res.message : 'Failed to create class', false);
                        else alert(res ? res.message : 'Failed to create class');
                    }
                },
                error: function (xhr) {
                    const msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Server error creating class';
                    if (window.showToast) window.showToast(msg, false);
                    else alert(msg);
                },
                complete: function () {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg><span>Create Class</span>';
                    }
                }
            });
        }

        // Edit Class AJAX
        const editClassModal = document.getElementById('editClassModal');

        function openEditClassModal(id, name, place, limit, openDate, openTime) {
            document.getElementById('editSubClassId').value = id;
            document.getElementById('editClassName').value = name || '';
            document.getElementById('editPlace').value = place || '';
            document.getElementById('editStudentLimit').value = limit || 30;
            if (openDate) {
                document.getElementById('editOpenDate').value = openDate.length >= 10 ? openDate.substring(0, 10) : openDate;
            }
            if (openTime) {
                document.getElementById('editOpenTime').value = openTime.length >= 5 ? openTime.substring(0, 5) : openTime;
            }
            editClassModal.classList.remove('hidden');
            const firstInput = document.getElementById('editClassName');
            if (firstInput) setTimeout(() => firstInput.focus(), 100);
        }

        function closeEditClassModal() {
            editClassModal.classList.add('hidden');
        }

        function submitEditClass() {
            const form = document.getElementById('editClassForm');
            const token = $('input[name="__RequestVerificationToken"]').val();
            const submitBtn = document.getElementById('btnSubmitEditClass');
            const id = document.getElementById('editSubClassId').value;

            const model = {
                SubClassId: parseInt(id, 10),
                ClassName: document.getElementById('editClassName').value.trim(),
                Place: document.getElementById('editPlace').value.trim(),
                StudentLimit: parseInt(document.getElementById('editStudentLimit').value, 10),
                OpenDate: document.getElementById('editOpenDate').value,
                OpenTime: document.getElementById('editOpenTime').value
            };

            if (!model.ClassName || !model.Place || !model.StudentLimit) {
                alert('Please fill in all required fields.');
                return;
            }

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="inline-block animate-spin mr-1">⌛</span> Updating...';
            }

            $.ajax({
                url: '@Url.Action("Update", "SubClass")/' + id + '?role=' + encodeURIComponent(currentRole),
                type: 'POST',
                data: model,
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (res) {
                    if (res && res.isSuccess) {
                        closeEditClassModal();
                        if (window.showToast) window.showToast(res.message || 'Class updated successfully!', true);
                        loadClasses();
                    } else {
                        if (window.showToast) window.showToast(res ? res.message : 'Failed to update class', false);
                        else alert(res ? res.message : 'Failed to update class');
                    }
                },
                error: function (xhr) {
                    const msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Server error updating class';
                    if (window.showToast) window.showToast(msg, false);
                    else alert(msg);
                },
                complete: function () {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>Update Class</span>';
                    }
                }
            });
        }

        // Enroll Student AJAX
        const enrollModal = document.getElementById('enrollModal');
        const modalClassId = document.getElementById('modalClassId');
        const modalClassName = document.getElementById('modalClassName');
        const modalPlace = document.getElementById('modalPlace');
        const modalCapacity = document.getElementById('modalCapacity');

        function openEnrollModal(classId, className, place, currentCount, limit) {
            modalClassId.value = classId;
            modalClassName.innerText = className;
            modalPlace.innerText = place || 'Not Assigned';
            modalCapacity.innerText = `${currentCount} / ${limit} seats enrolled`;
            toggleModalStudentMode(false);
            enrollModal.classList.remove('hidden');

            // Lazy load students if not cached
            loadStudentDropdown();
        }

        function closeEnrollModal() {
            enrollModal.classList.add('hidden');
        }

        function loadStudentDropdown() {
            if (cachedStudents) {
                populateStudentSelect(cachedStudents);
                return;
            }

            const loader = document.getElementById('studentSelectLoading');
            if (loader) loader.classList.remove('hidden');

            $.ajax({
                url: '@Url.Action("GetStudents", "SubClass")',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.isSuccess && res.students) {
                        cachedStudents = res.students;
                        populateStudentSelect(cachedStudents);
                    }
                },
                complete: function () {
                    if (loader) loader.classList.add('hidden');
                }
            });
        }

        function populateStudentSelect(students) {
            const select = document.getElementById('modalStudentSelect');
            if (!select) return;

            select.innerHTML = '<option value="">-- Choose a Registered Student --</option>';
            students.forEach(s => {
                select.insertAdjacentHTML('beforeend', `
                    <option value="${s.userId}">${escapeHtml(s.fullName)} (${escapeHtml(s.email)}) [No: ${s.userId}]</option>
                `);
            });
        }

        function submitEnrollStudent() {
            const token = $('input[name="__RequestVerificationToken"]').val();
            const submitBtn = document.getElementById('btnSubmitEnroll');
            const isNew = document.getElementById('modalIsNewStudentInput').value === 'true';

            const model = {
                ClassId: parseInt(modalClassId.value, 10),
                IsNewStudent: isNew,
                EnrollDate: document.getElementById('modalEnrollDate').value,
                StudentId: !isNew ? parseInt(document.getElementById('modalStudentSelect').value, 10) : null,
                FullName: isNew ? document.getElementById('modalFullName').value.trim() : null,
                Email: isNew ? document.getElementById('modalEmail').value.trim() : null,
                TelegramUsername: isNew ? document.getElementById('modalTelegram').value.trim() : null
            };

            if (!isNew && !model.StudentId) {
                alert('Please select an existing student.');
                return;
            }
            if (isNew && (!model.FullName || !model.Email)) {
                alert('Please enter student name and email.');
                return;
            }

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="inline-block animate-spin mr-1">⌛</span> Enrolling...';
            }

            $.ajax({
                url: '@Url.Action("Enroll", "SubClass")?role=' + encodeURIComponent(currentRole),
                type: 'POST',
                data: model,
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (res) {
                    if (res && res.isSuccess) {
                        closeEnrollModal();
                        document.getElementById('enrollStudentForm').reset();
                        cachedStudents = null; // Invalidate cache so new students are picked up
                        if (window.showToast) window.showToast(res.message || 'Student enrolled successfully!', true);
                        loadClasses();
                    } else {
                        if (window.showToast) window.showToast(res ? res.message : 'Failed to enroll student', false);
                        else alert(res ? res.message : 'Failed to enroll student');
                    }
                },
                error: function (xhr) {
                    const msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Server error enrolling student';
                    if (window.showToast) window.showToast(msg, false);
                    else alert(msg);
                },
                complete: function () {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span id="modalSubmitBtnText">Confirm Enrollment</span>';
                    }
                }
            });
        }

        function toggleModalStudentMode(isNew) {
            const isNewInput = document.getElementById('modalIsNewStudentInput');
            const tabExistingBtn = document.getElementById('modalTabExistingBtn');
            const tabNewBtn = document.getElementById('modalTabNewBtn');
            const existingSection = document.getElementById('modalExistingSection');
            const newSection = document.getElementById('modalNewSection');
            const submitBtnText = document.getElementById('modalSubmitBtnText');

            const studentSelect = document.getElementById('modalStudentSelect');
            const fullNameInput = document.getElementById('modalFullName');
            const emailInput = document.getElementById('modalEmail');

            isNewInput.value = isNew ? "true" : "false";

            if (isNew) {
                tabNewBtn.classList.add('bg-white', 'text-emerald-600', 'shadow-2xs');
                tabNewBtn.classList.remove('text-slate-500');

                tabExistingBtn.classList.remove('bg-white', 'text-emerald-600', 'shadow-2xs');
                tabExistingBtn.classList.add('text-slate-500');

                existingSection.classList.add('hidden');
                newSection.classList.remove('hidden');

                if (studentSelect) studentSelect.removeAttribute('required');
                if (fullNameInput) fullNameInput.setAttribute('required', 'required');
                if (emailInput) emailInput.setAttribute('required', 'required');

                submitBtnText.innerText = "Register & Enroll Student";
            } else {
                tabExistingBtn.classList.add('bg-white', 'text-emerald-600', 'shadow-2xs');
                tabExistingBtn.classList.remove('text-slate-500');

                tabNewBtn.classList.remove('bg-white', 'text-emerald-600', 'shadow-2xs');
                tabNewBtn.classList.add('text-slate-500');

                newSection.classList.add('hidden');
                existingSection.classList.remove('hidden');

                if (fullNameInput) fullNameInput.removeAttribute('required');
                if (emailInput) emailInput.removeAttribute('required');
                if (studentSelect) studentSelect.setAttribute('required', 'required');

                submitBtnText.innerText = "Confirm Enrollment";
            }
        }

        function deleteClass(id) {
            if (!confirm('Are you sure you want to delete this class?')) return;

            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Delete", "SubClass")/' + id + '?role=' + encodeURIComponent(currentRole),
                type: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (res) {
                    if (res && res.isSuccess) {
                        if (window.showToast) window.showToast('Class deleted successfully!', true);
                        loadClasses();
                    } else {
                        if (window.showToast) window.showToast(res ? res.message : 'Failed to delete class', false);
                    }
                },
                error: function () {
                    if (window.showToast) window.showToast('Error communicating with server', false);
                }
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function escapeJs(text) {
            if (!text) return '';
            return text.replace(/'/g, "\\'").replace(/"/g, '\\"');
        }

        function formatDate(dStr) {
            if (!dStr) return '-';
            const dt = new Date(dStr);
            if (isNaN(dt.getTime())) return dStr;
            return dt.toLocaleDateString();
        }

        function formatTime(tStr) {
            if (!tStr) return '--:--';
            if (typeof tStr === 'string' && tStr.length >= 5) return tStr.substring(0, 5);
            return tStr;
        }

        // Live search debounced
        let searchTimeout = null;
        document.getElementById('classSearchInput').addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                triggerClassSearch();
            }, 350);
        });

        // Close modal on backdrop
        createClassModal.addEventListener('click', (e) => {
            if (e.target === createClassModal) closeCreateClassModal();
        });
        editClassModal.addEventListener('click', (e) => {
            if (e.target === editClassModal) closeEditClassModal();
        });
        enrollModal.addEventListener('click', (e) => {
            if (e.target === enrollModal) closeEnrollModal();
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                if (!createClassModal.classList.contains('hidden')) closeCreateClassModal();
                if (!editClassModal.classList.contains('hidden')) closeEditClassModal();
                if (!enrollModal.classList.contains('hidden')) closeEnrollModal();
            }
        });

        // Initial Load via AJAX
        $(document).ready(function () {
            loadClasses();
        });
    </script>
}
