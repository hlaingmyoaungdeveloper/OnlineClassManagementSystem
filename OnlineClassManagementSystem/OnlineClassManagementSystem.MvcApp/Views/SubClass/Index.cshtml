@model OnlineClassManagementSystem.Shared.models.SubClass.SubClassListResponseModel

@{
    ViewData["Title"] = "Class Management";
    var classes = Model?.SubClassList ?? new List<OnlineClassManagementSystem.Shared.models.SubClass.SubClassModel>();
    var students = ViewBag.Students as List<OnlineClassManagementSystem.Shared.models.User.UserModel> ?? new();
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");

    var totalClasses = Model?.TotalClasses > 0 ? Model.TotalClasses : (Model?.TotalCount ?? classes.Count);
    var totalEnrolled = Model?.TotalEnrolled ?? classes.Sum(c => c.StudentCount ?? 0);
    var totalCapacity = Model?.TotalCapacity ?? classes.Sum(c => c.StudentLimit);
    var availableSeats = Model != null && Model.TotalCapacity > 0 ? Model.AvailableSeats : Math.Max(0, totalCapacity - totalEnrolled);

    var pageNo = Model?.PageNo ?? (ViewBag.PageNo as int? ?? 1);
    var pageSize = Model?.PageSize ?? (ViewBag.PageSize as int? ?? 10);
    var totalCount = Model?.TotalCount ?? classes.Count;
    var totalPages = Model?.TotalPages ?? (pageSize > 0 ? (int)Math.Ceiling((double)totalCount / pageSize) : 1);
    if (totalPages < 1) totalPages = 1;
    var hasPrevious = Model?.HasPreviousPage ?? (pageNo > 1);
    var hasNext = Model?.HasNextPage ?? (pageNo < totalPages);
    var searchVal = ViewBag.Search as string ?? "";
    var statusVal = ViewBag.Status as string ?? "all";
}

<div class="p-6 md:p-8 space-y-6">

    <!-- Header Section with Title, Subtitle, and Add Class Button -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Class Management</h1>
            <p class="text-xs text-slate-500 mt-1">Manage and monitor all class schedules, room allocations, capacity, and student enrollments.</p>
        </div>
        <div class="flex items-center gap-2.5">
            <button type="button" onclick="openCreateClassModal()"
               class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 px-4 py-2.5 text-xs font-semibold text-white shadow-sm hover:bg-blue-700 transition cursor-pointer">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Add Class
            </button>
        </div>
    </div>

    <!-- Metric Overview Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Total Classes</span>
                <div class="h-7 w-7 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                </div>
            </div>
            <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900">@totalClasses</p>
        </div>

        <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Total Enrolled</span>
                <div class="h-7 w-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                </div>
            </div>
            <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900">@totalEnrolled</p>
        </div>

        <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Total Capacity</span>
                <div class="h-7 w-7 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                </div>
            </div>
            <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900">@totalCapacity</p>
        </div>

        <div class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-2xs">
            <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Available Seats</span>
                <div class="h-7 w-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
            </div>
            <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900">@availableSeats</p>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-xs font-medium text-emerald-800 flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null || ViewBag.Error != null)
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs font-medium text-amber-800 flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <span>@(TempData["Error"] ?? ViewBag.Error)</span>
        </div>
    }

    <!-- Controls Row: Search, Availability Filter, and View Mode Toggle -->
    <form method="get" asp-action="Index" class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200/80 bg-white p-3.5 shadow-2xs">
        <input type="hidden" name="role" value="@currentRole" />
        <input type="hidden" name="pageNo" value="1" />
        <input type="hidden" name="pageSize" value="@pageSize" />

        <div class="flex flex-wrap items-center gap-3 flex-1">
            <!-- Search Input -->
            <div class="relative flex-1 min-w-[220px] max-w-md">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </span>
                <input type="text" name="search" id="classSearchInput" value="@searchVal" placeholder="Search by class name or place..."
                       class="w-full rounded-lg border border-slate-200 bg-slate-50/50 py-2 pl-9 pr-3 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white transition" />
            </div>

            <!-- Status Filter Dropdown -->
            <div class="w-40">
                <select name="status" id="statusFilter" onchange="this.form.submit()" class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs font-medium text-slate-700 outline-none focus:border-blue-500 focus:bg-white transition">
                    <option value="all" selected="@(statusVal == "all" ? "selected" : null)">All Status</option>
                    <option value="available" selected="@(statusVal == "available" ? "selected" : null)">Available Seats</option>
                    <option value="full" selected="@(statusVal == "full" ? "selected" : null)">Class Full</option>
                </select>
            </div>

            <button type="submit" class="rounded-lg bg-blue-600 hover:bg-blue-700 px-4 py-2 text-xs font-semibold text-white shadow-xs transition">
                Search
            </button>
            @if (!string.IsNullOrEmpty(searchVal) || statusVal != "all")
            {
                <a asp-action="Index" asp-route-role="@currentRole" class="rounded-lg border border-slate-200 bg-white hover:bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 transition">
                    Reset
                </a>
            }
        </div>

        <!-- View Mode Switcher: Table View & Card View -->
        <div class="flex items-center gap-1 rounded-lg border border-slate-200 bg-slate-50/80 p-1">
            <button id="tableViewBtn" type="button" title="Table View"
                    class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition bg-white text-blue-600 shadow-2xs">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                <span>Table</span>
            </button>
            <button id="cardViewBtn" type="button" title="Card View"
                    class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium transition text-slate-500 hover:text-slate-800">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                <span>Cards</span>
            </button>
        </div>
    </form>

    <!-- Empty Filter Results Banner (Hidden by default) -->
    <div id="noMatchBanner" class="hidden rounded-xl border border-slate-200 bg-white p-8 text-center text-slate-400">
        <svg class="mx-auto h-10 w-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p class="mt-2 text-sm font-medium text-slate-600">No classes match your filter.</p>
        <p class="text-xs text-slate-400">Try adjusting your search query or status filter.</p>
    </div>

    <!-- VIEW 1: TABLE VIEW -->
    <div id="tableViewContainer" class="rounded-xl border border-slate-200/80 bg-white shadow-2xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50/80 text-xs font-semibold uppercase text-slate-500 border-b border-slate-200/80">
                    <tr>
                        <th class="px-6 py-3.5">No</th>
                        <th class="px-6 py-3.5">Class Name</th>
                        <th class="px-6 py-3.5">Place / Room</th>
                        <th class="px-6 py-3.5">Schedule</th>
                        <th class="px-6 py-3.5">Capacity & Occupancy</th>
                        <th class="px-6 py-3.5">Status</th>
                        <th class="px-6 py-3.5 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100" id="classTableBody">
                    @if (classes.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <svg class="h-8 w-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                                    <span>No classes found.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var rowNo = 0;
                        @foreach (var item in classes)
                        {
                            rowNo++;
                            var codeId = "C00" + item.SubClassId;
                            var currentCount = item.StudentCount ?? 0;
                            var limit = item.StudentLimit;
                            var percent = limit > 0 ? Math.Min(100, (int)Math.Round((double)currentCount / limit * 100)) : 0;
                            var isFull = currentCount >= limit;
                            var rowStatus = isFull ? "full" : "available";

                            <tr class="class-row hover:bg-slate-50/60 transition"
                                data-class-name="@item.ClassName.ToLower()"
                                data-place="@((item.Place ?? "").ToLower())"
                                data-status="@rowStatus"
                                data-class-id="@item.SubClassId">
                                <td class="px-6 py-4 font-semibold text-slate-800">
                                    <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">@rowNo</span>
                                </td>
                                <td class="px-6 py-4 font-medium text-slate-900">
                                    <div class="flex items-center gap-2.5">
                                        <div class="h-8 w-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                                        </div>
                                        <div>
                                            <span class="block font-semibold text-slate-900">@item.ClassName</span>
                                            <span class="text-[11px] text-slate-400 font-normal">Class No: @codeId</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-slate-700">
                                    <div class="flex items-center gap-1.5">
                                        <svg class="h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                        <span>@(string.IsNullOrEmpty(item.Place) ? "Not Assigned" : item.Place)</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-slate-700">
                                    <div class="space-y-0.5">
                                        <span class="text-xs font-medium text-slate-800 block">@(item.OpenDate?.ToString("dd-MM-yyyy") ?? "Ongoing")</span>
                                        @if (!string.IsNullOrEmpty(item.OpenTime))
                                        {
                                            <span class="inline-flex items-center gap-1 rounded bg-slate-100 px-1.5 py-0.5 text-[11px] text-slate-600 font-medium">
                                                <svg class="h-3 w-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                @item.OpenTime
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-slate-700">
                                    <div class="w-36 space-y-1">
                                        <div class="flex justify-between text-xs">
                                            <span class="font-semibold text-slate-800">@currentCount / @limit</span>
                                            <span class="text-slate-400">@percent%</span>
                                        </div>
                                        <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
                                            <div class="h-1.5 rounded-full @(isFull ? "bg-rose-500" : percent >= 80 ? "bg-amber-500" : "bg-emerald-500")"
                                                 style="width: @percent%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    @if (isFull)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-semibold text-rose-600 border border-rose-100">Full</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-600 border border-emerald-100">Available</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <div class="inline-flex items-center justify-center gap-2">
                                        <!-- ENROLL ACTION BUTTON -->
                                        @if (!isFull)
                                        {
                                            <button type="button"
                                                    onclick="openEnrollModal(@item.SubClassId, '@item.ClassName', '@(item.Place ?? "")', @currentCount, @limit)"
                                                    class="inline-flex items-center gap-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 px-2.5 py-1 text-xs font-semibold text-white shadow-2xs transition"
                                                    title="Enroll Student">
                                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                                                Enroll
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-400 cursor-not-allowed"
                                                  title="Class capacity reached">
                                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v2m0-2h2m-2 0H10m11-3.5a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                Full
                                            </span>
                                        }

                                        <!-- Edit Button -->
                                        <a asp-controller="SubClass" asp-action="Edit" asp-route-id="@item.SubClassId" asp-route-role="@currentRole"
                                           class="h-7 w-7 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 hover:text-blue-600 flex items-center justify-center transition"
                                           title="Edit Class">
                                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                        </a>

                                        <!-- Delete Button -->
                                        <form asp-controller="SubClass" asp-action="Delete" asp-route-id="@item.SubClassId" asp-route-role="@currentRole" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="h-7 w-7 rounded-lg border border-slate-200 bg-white hover:bg-rose-50 text-slate-600 hover:text-rose-600 flex items-center justify-center transition"
                                                    title="Delete Class"
                                                    onclick="return confirm('Are you sure you want to delete @item.ClassName?');">
                                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @{
            var startItem = totalCount > 0 ? (pageNo - 1) * pageSize + 1 : 0;
            var endItem = Math.Min(pageNo * pageSize, totalCount);
            int startPage = Math.Max(1, pageNo - 2);
            int endPage = Math.Min(totalPages, pageNo + 2);
        }

        <!-- Table Pagination Footer -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-200/80 px-6 py-3.5 bg-slate-50/50 text-xs text-slate-500">
            <div class="flex items-center gap-3">
                <span>Showing @(totalCount > 0 ? $"{startItem} - {endItem} of {totalCount}" : "0") classes</span>
                <div class="flex items-center gap-1.5 pl-3 border-l border-slate-200">
                    <span>Per page:</span>
                    <select onchange="location.href='@Url.Action("Index", new { role = currentRole, search = searchVal, status = statusVal, pageNo = 1 })&pageSize=' + this.value"
                            class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 outline-none focus:border-blue-500">
                        <option value="5" selected="@(pageSize == 5 ? "selected" : null)">5</option>
                        <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10</option>
                        <option value="20" selected="@(pageSize == 20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50</option>
                    </select>
                </div>
            </div>
            <div class="flex items-center gap-1">
                @if (hasPrevious)
                {
                    <a asp-action="Index" asp-route-pageNo="@(pageNo - 1)" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-status="@statusVal" asp-route-role="@currentRole"
                       class="h-7 px-2.5 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">
                        &lsaquo; Prev
                    </a>
                }
                else
                {
                    <span class="h-7 px-2.5 rounded-md border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-300 cursor-not-allowed">
                        &lsaquo; Prev
                    </span>
                }

                @if (startPage > 1)
                {
                    <a asp-action="Index" asp-route-pageNo="1" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-status="@statusVal" asp-route-role="@currentRole"
                       class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">1</a>
                    @if (startPage > 2)
                    {
                        <span class="px-1 text-slate-400">...</span>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    if (i == pageNo)
                    {
                        <span class="h-7 w-7 rounded-md bg-blue-600 text-white font-semibold flex items-center justify-center shadow-xs">@i</span>
                    }
                    else
                    {
                        <a asp-action="Index" asp-route-pageNo="@i" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-status="@statusVal" asp-route-role="@currentRole"
                           class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">@i</a>
                    }
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <span class="px-1 text-slate-400">...</span>
                    }
                    <a asp-action="Index" asp-route-pageNo="@totalPages" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-status="@statusVal" asp-route-role="@currentRole"
                       class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">@totalPages</a>
                }

                @if (hasNext)
                {
                    <a asp-action="Index" asp-route-pageNo="@(pageNo + 1)" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-status="@statusVal" asp-route-role="@currentRole"
                       class="h-7 px-2.5 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">
                        Next &rsaquo;
                    </a>
                }
                else
                {
                    <span class="h-7 px-2.5 rounded-md border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-300 cursor-not-allowed">
                        Next &rsaquo;
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- VIEW 2: CARD VIEW -->
    <div id="cardViewContainer" class="hidden">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" id="classCardGrid">
            @if (classes.Count == 0)
            {
                <div class="col-span-full rounded-xl border border-slate-200 bg-white p-12 text-center text-slate-400">
                    <p>No classes available.</p>
                </div>
            }
            else
            {
                @foreach (var item in classes)
                {
                    var codeId = "C00" + item.SubClassId;
                    var currentCount = item.StudentCount ?? 0;
                    var limit = item.StudentLimit;
                    var percent = limit > 0 ? Math.Min(100, (int)Math.Round((double)currentCount / limit * 100)) : 0;
                    var isFull = currentCount >= limit;
                    var cardStatus = isFull ? "full" : "available";

                    <div class="class-card group rounded-2xl border border-slate-200/80 bg-white p-5 shadow-2xs hover:shadow-md hover:border-slate-300 transition duration-200 flex flex-col justify-between"
                         data-class-name="@item.ClassName.ToLower()"
                         data-place="@((item.Place ?? "").ToLower())"
                         data-status="@cardStatus"
                         data-class-id="@item.SubClassId">

                        <div>
                            <!-- Top Badge Row -->
                            <div class="flex items-center justify-between gap-2 mb-3">
                                <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">No: @codeId</span>
                                @if (isFull)
                                {
                                    <span class="inline-flex items-center rounded-full bg-rose-50 px-2.5 py-0.5 text-[11px] font-semibold text-rose-600 border border-rose-100">Class Full</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-600 border border-emerald-100">Available</span>
                                }
                            </div>

                            <!-- Class Title -->
                            <h3 class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition mb-3">
                                @item.ClassName
                            </h3>

                            <!-- Details list -->
                            <div class="space-y-2 text-xs text-slate-600 border-t border-slate-100 pt-3 mb-4">
                                <!-- Place -->
                                <div class="flex items-center gap-2">
                                    <svg class="h-4 w-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                    <span class="truncate">@(string.IsNullOrEmpty(item.Place) ? "Not Assigned" : item.Place)</span>
                                </div>

                                <!-- Date & Time -->
                                <div class="flex items-center gap-2">
                                    <svg class="h-4 w-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    <span>@(item.OpenDate?.ToString("dd-MM-yyyy") ?? "Ongoing") @(!string.IsNullOrEmpty(item.OpenTime) ? "• " + item.OpenTime : "")</span>
                                </div>
                            </div>

                            <!-- Capacity Progress Bar -->
                            <div class="space-y-1.5 mb-5 rounded-xl bg-slate-50 p-3 border border-slate-100">
                                <div class="flex justify-between text-xs">
                                    <span class="text-slate-500 font-medium">Capacity</span>
                                    <span class="font-bold text-slate-800">@currentCount / @limit <span class="text-slate-400 font-normal">(@percent%)</span></span>
                                </div>
                                <div class="w-full bg-slate-200/80 rounded-full h-2 overflow-hidden">
                                    <div class="h-2 rounded-full @(isFull ? "bg-rose-500" : percent >= 80 ? "bg-amber-500" : "bg-emerald-500")"
                                         style="width: @percent%"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Action Buttons -->
                        <div class="flex items-center gap-2 pt-3 border-t border-slate-100">
                            <!-- ENROLL ACTION BUTTON -->
                            @if (!isFull)
                            {
                                <button type="button"
                                        onclick="openEnrollModal(@item.SubClassId, '@item.ClassName', '@(item.Place ?? "")', @currentCount, @limit)"
                                        class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 py-2 text-xs font-semibold text-white shadow-2xs transition">
                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                                    Enroll
                                </button>
                            }
                            else
                            {
                                <button type="button" disabled
                                        class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-xl bg-slate-100 py-2 text-xs font-medium text-slate-400 cursor-not-allowed">
                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v2m0-2h2m-2 0H10m11-3.5a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    Class Full
                                </button>
                            }

                            <!-- Edit Icon Button -->
                            <a asp-controller="SubClass" asp-action="Edit" asp-route-id="@item.SubClassId" asp-route-role="@currentRole"
                               class="h-8 w-8 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 hover:text-blue-600 flex items-center justify-center transition"
                               title="Edit Class">
                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                            </a>

                            <!-- Delete Icon Button -->
                            <form asp-controller="SubClass" asp-action="Delete" asp-route-id="@item.SubClassId" asp-route-role="@currentRole" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="h-8 w-8 rounded-xl border border-slate-200 bg-white hover:bg-rose-50 text-slate-600 hover:text-rose-600 flex items-center justify-center transition"
                                        title="Delete Class"
                                        onclick="return confirm('Are you sure you want to delete @item.ClassName?');">
                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                </button>
                            </form>
                        </div>

                    </div>
                }
            }
        </div>

        <!-- Card View Pagination Footer -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 rounded-xl border border-slate-200/80 bg-white p-3.5 shadow-2xs text-xs text-slate-500 mt-5">
            <div class="flex items-center gap-3">
                <span>Showing @(totalCount > 0 ? $"{startItem} - {endItem} of {totalCount}" : "0") classes</span>
                <div class="flex items-center gap-1.5 pl-3 border-l border-slate-200">
                    <span>Per page:</span>
                    <select onchange="location.href='@Url.Action("Index", new { role = currentRole, search = searchVal, status = statusVal, pageNo = 1 })&pageSize=' + this.value"
                            class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 outline-none focus:border-blue-500">
                        <option value="5" selected="@(pageSize == 5 ? "selected" : null)">5</option>
                        <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10</option>
                        <option value="20" selected="@(pageSize == 20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50</option>
                    </select>
                </div>
            </div>
            <div class="flex items-center gap-1">
                @if (hasPrevious)
                {
                    <a asp-action="Index" asp-route-pageNo="@(pageNo - 1)" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-status="@statusVal" asp-route-role="@currentRole"
                       class="h-7 px-2.5 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">
                        &lsaquo; Prev
                    </a>
                }
                else
                {
                    <span class="h-7 px-2.5 rounded-md border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-300 cursor-not-allowed">
                        &lsaquo; Prev
                    </span>
                }

                @if (startPage > 1)
                {
                    <a asp-action="Index" asp-route-pageNo="1" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-status="@statusVal" asp-route-role="@currentRole"
                       class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">1</a>
                    @if (startPage > 2)
                    {
                        <span class="px-1 text-slate-400">...</span>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    if (i == pageNo)
                    {
                        <span class="h-7 w-7 rounded-md bg-blue-600 text-white font-semibold flex items-center justify-center shadow-xs">@i</span>
                    }
                    else
                    {
                        <a asp-action="Index" asp-route-pageNo="@i" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-status="@statusVal" asp-route-role="@currentRole"
                           class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">@i</a>
                    }
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <span class="px-1 text-slate-400">...</span>
                    }
                    <a asp-action="Index" asp-route-pageNo="@totalPages" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-status="@statusVal" asp-route-role="@currentRole"
                       class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">@totalPages</a>
                }

                @if (hasNext)
                {
                    <a asp-action="Index" asp-route-pageNo="@(pageNo + 1)" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-status="@statusVal" asp-route-role="@currentRole"
                       class="h-7 px-2.5 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">
                        Next &rsaquo;
                    </a>
                }
                else
                {
                    <span class="h-7 px-2.5 rounded-md border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-300 cursor-not-allowed">
                        Next &rsaquo;
                    </span>
                }
            </div>
        </div>
    </div>

<!-- CREATE CLASS POPUP MODAL -->
<div id="createClassModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs hidden transition-opacity duration-200">
    <div class="relative w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-2xl animate-in fade-in zoom-in-95 duration-150">
        <!-- Close Button (X) -->
        <button type="button" onclick="closeCreateClassModal()" class="absolute top-4 right-4 rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>

        <!-- Header -->
        <div class="flex items-center gap-3 pb-4 mb-5 border-b border-slate-100">
            <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-900">Create New Class</h3>
                <p class="text-xs text-slate-500">Add a new class schedule, room allocation, and student capacity</p>
            </div>
        </div>

        <form asp-controller="SubClass" asp-action="Create" asp-route-role="@currentRole" method="post" class="space-y-4" id="createClassForm">
            @Html.AntiForgeryToken()

            <!-- Class Name -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Class Name <span class="text-rose-500">*</span></label>
                <input name="ClassName" id="createClassName" required placeholder="e.g. Class A, Grade 10 Math"
                       class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
            </div>

            <!-- Room / Place -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Room / Place <span class="text-rose-500">*</span></label>
                <input name="Place" id="createPlace" required placeholder="e.g. Room 101, Lab A"
                       class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
            </div>

            <!-- Grid 3 items: StudentLimit, OpenDate, OpenTime -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Capacity <span class="text-rose-500">*</span></label>
                    <input name="StudentLimit" id="createStudentLimit" type="number" min="1" max="500" value="30" required
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Open Date <span class="text-rose-500">*</span></label>
                    <input name="OpenDate" id="createOpenDate" type="date" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" required
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Open Time <span class="text-rose-500">*</span></label>
                    <input name="OpenTime" id="createOpenTime" type="time" value="09:00" required
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
                </div>
            </div>

            <!-- Modal Action Buttons -->
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeCreateClassModal()"
                        class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition cursor-pointer">
                    Cancel
                </button>
                <button type="submit"
                        class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-xs font-semibold text-white shadow-sm transition cursor-pointer">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    <span>Create Class</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ENROLL STUDENT MODAL -->
<div id="enrollModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs hidden transition-opacity duration-200">
    <div class="relative w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-2xl animate-in fade-in zoom-in-95 duration-150">
        <!-- Close Button (X) -->
        <button type="button" onclick="closeEnrollModal()" class="absolute top-4 right-4 rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>

        <div class="flex items-center gap-3 pb-4 mb-4 border-b border-slate-100">
            <div class="h-10 w-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-900">Enroll Student</h3>
                <p class="text-xs text-slate-500">Add a student to <span id="modalClassName" class="font-semibold text-emerald-600">Selected Class</span></p>
            </div>
        </div>

        <!-- Class Preview Info Banner -->
        <div class="rounded-xl bg-slate-50 border border-slate-100 p-3 mb-5 grid grid-cols-2 gap-3 text-xs">
            <div>
                <span class="text-[11px] text-slate-400 uppercase font-semibold block">Room / Place</span>
                <span id="modalPlace" class="font-medium text-slate-700">Room 101</span>
            </div>
            <div>
                <span class="text-[11px] text-slate-400 uppercase font-semibold block">Current Occupancy</span>
                <span id="modalCapacity" class="font-semibold text-slate-800">0 / 30 seats</span>
            </div>
        </div>

        <form asp-controller="SubClass" asp-action="Enroll" asp-route-role="@currentRole" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ClassId" id="modalClassId" value="0" />
            <input type="hidden" name="IsNewStudent" id="modalIsNewStudentInput" value="false" />

            <!-- Student Option Toggle: Existing Student vs New Student -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Student Option</label>
                <div class="grid grid-cols-2 gap-2 p-1 rounded-xl bg-slate-100/80 border border-slate-200/80">
                    <button type="button" id="modalTabExistingBtn" onclick="toggleModalStudentMode(false)"
                            class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-semibold transition bg-white text-emerald-600 shadow-2xs">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        Existing Student
                    </button>
                    <button type="button" id="modalTabNewBtn" onclick="toggleModalStudentMode(true)"
                            class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-semibold transition text-slate-500 hover:text-slate-800">
                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                        + New Student
                    </button>
                </div>
            </div>

            <!-- Existing Student Section -->
            <div id="modalExistingSection">
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                    Select Existing Student <span class="text-rose-500">*</span>
                </label>
                @if (students.Count > 0)
                {
                    <select name="StudentId" id="modalStudentSelect" required
                            class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-emerald-500 focus:bg-white focus:ring-2 focus:ring-emerald-100 transition">
                        <option value="">-- Choose a Registered Student --</option>
                        @foreach (var s in students)
                        {
                            <option value="@s.UserId">@s.FullName (@s.Email) [No: @s.UserId]</option>
                        }
                    </select>
                }
                else
                {
                    <input type="number" name="StudentId" id="modalStudentInput" min="1" placeholder="Enter Student User No (e.g. 1)"
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-emerald-500 focus:bg-white focus:ring-2 focus:ring-emerald-100 transition" />
                    <p class="text-[11px] text-slate-400 mt-1">Enter student No to enroll.</p>
                }
            </div>

            <!-- New Student Data Section -->
            <div id="modalNewSection" class="hidden space-y-3 p-3.5 rounded-xl border border-emerald-100 bg-emerald-50/40">
                <div class="flex items-center gap-1.5 text-xs font-semibold text-emerald-800 mb-1">
                    <svg class="h-4 w-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>Enter New Student Information</span>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                        Full Name <span class="text-rose-500">*</span>
                    </label>
                    <input type="text" name="FullName" id="modalFullName" placeholder="e.g. Aung Min Khant"
                           class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs text-slate-700 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 transition" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                        Email Address <span class="text-rose-500">*</span>
                    </label>
                    <input type="email" name="Email" id="modalEmail" placeholder="e.g. aungmin@gmail.com"
                           class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs text-slate-700 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 transition" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                        Telegram / Contact <span class="text-slate-400 font-normal">(Optional)</span>
                    </label>
                    <input type="text" name="TelegramUsername" id="modalTelegram" placeholder="e.g. @@aungmin"
                           class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs text-slate-700 outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 transition" />
                </div>
            </div>

            <!-- Enrollment Date -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">
                    Enrollment Date <span class="text-rose-500">*</span>
                </label>
                <input type="date" name="EnrollDate" value="@(DateTime.Now.ToString("yyyy-MM-dd"))" required
                       class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-emerald-500 focus:bg-white focus:ring-2 focus:ring-emerald-100 transition" />
            </div>

            <!-- Modal Action Buttons -->
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeEnrollModal()"
                        class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">
                    Cancel
                </button>
                <button type="submit"
                        class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 px-5 py-2 text-xs font-semibold text-white shadow-sm transition">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span id="modalSubmitBtnText">Confirm Enrollment</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // View Toggle Logic
        const tableViewBtn = document.getElementById('tableViewBtn');
        const cardViewBtn = document.getElementById('cardViewBtn');
        const tableViewContainer = document.getElementById('tableViewContainer');
        const cardViewContainer = document.getElementById('cardViewContainer');

        function setViewMode(mode) {
            if (mode === 'card') {
                tableViewContainer.classList.add('hidden');
                cardViewContainer.classList.remove('hidden');

                cardViewBtn.classList.add('bg-white', 'text-blue-600', 'shadow-2xs');
                cardViewBtn.classList.remove('text-slate-500');

                tableViewBtn.classList.remove('bg-white', 'text-blue-600', 'shadow-2xs');
                tableViewBtn.classList.add('text-slate-500');
            } else {
                cardViewContainer.classList.add('hidden');
                tableViewContainer.classList.remove('hidden');

                tableViewBtn.classList.add('bg-white', 'text-blue-600', 'shadow-2xs');
                tableViewBtn.classList.remove('text-slate-500');

                cardViewBtn.classList.remove('bg-white', 'text-blue-600', 'shadow-2xs');
                cardViewBtn.classList.add('text-slate-500');
            }
            try {
                localStorage.setItem('subclass_view_mode', mode);
            } catch (e) {}
        }

        tableViewBtn.addEventListener('click', () => setViewMode('table'));
        cardViewBtn.addEventListener('click', () => setViewMode('card'));

        // Restore view preference
        const savedMode = localStorage.getItem('subclass_view_mode');
        if (savedMode === 'card') {
            setViewMode('card');
        } else {
            setViewMode('table');
        }


        // Enroll Modal Logic
        const enrollModal = document.getElementById('enrollModal');
        const modalClassId = document.getElementById('modalClassId');
        const modalClassName = document.getElementById('modalClassName');
        const modalPlace = document.getElementById('modalPlace');
        const modalCapacity = document.getElementById('modalCapacity');

        function toggleModalStudentMode(isNew) {
            const isNewInput = document.getElementById('modalIsNewStudentInput');
            const tabExistingBtn = document.getElementById('modalTabExistingBtn');
            const tabNewBtn = document.getElementById('modalTabNewBtn');
            const existingSection = document.getElementById('modalExistingSection');
            const newSection = document.getElementById('modalNewSection');
            const submitBtnText = document.getElementById('modalSubmitBtnText');

            const studentSelect = document.getElementById('modalStudentSelect');
            const studentInput = document.getElementById('modalStudentInput');
            const fullNameInput = document.getElementById('modalFullName');
            const emailInput = document.getElementById('modalEmail');

            isNewInput.value = isNew ? "true" : "false";

            if (isNew) {
                tabNewBtn.classList.add('bg-white', 'text-emerald-600', 'shadow-2xs');
                tabNewBtn.classList.remove('text-slate-500');

                tabExistingBtn.classList.remove('bg-white', 'text-emerald-600', 'shadow-2xs');
                tabExistingBtn.classList.add('text-slate-500');

                existingSection.classList.add('hidden');
                newSection.classList.remove('hidden');

                if (studentSelect) studentSelect.removeAttribute('required');
                if (studentInput) studentInput.removeAttribute('required');

                if (fullNameInput) fullNameInput.setAttribute('required', 'required');
                if (emailInput) emailInput.setAttribute('required', 'required');

                submitBtnText.innerText = "Register & Enroll Student";
            } else {
                tabExistingBtn.classList.add('bg-white', 'text-emerald-600', 'shadow-2xs');
                tabExistingBtn.classList.remove('text-slate-500');

                tabNewBtn.classList.remove('bg-white', 'text-emerald-600', 'shadow-2xs');
                tabNewBtn.classList.add('text-slate-500');

                newSection.classList.add('hidden');
                existingSection.classList.remove('hidden');

                if (fullNameInput) fullNameInput.removeAttribute('required');
                if (emailInput) emailInput.removeAttribute('required');

                if (studentSelect) studentSelect.setAttribute('required', 'required');
                if (studentInput) studentInput.setAttribute('required', 'required');

                submitBtnText.innerText = "Confirm Enrollment";
            }
        }

        // Create Class Modal Logic
        const createClassModal = document.getElementById('createClassModal');

        function openCreateClassModal() {
            createClassModal.classList.remove('hidden');
            const firstInput = document.getElementById('createClassName');
            if (firstInput) {
                setTimeout(() => firstInput.focus(), 100);
            }
        }

        function closeCreateClassModal() {
            createClassModal.classList.add('hidden');
        }

        createClassModal.addEventListener('click', (e) => {
            if (e.target === createClassModal) {
                closeCreateClassModal();
            }
        });

        function openEnrollModal(classId, className, place, currentCount, limit) {
            modalClassId.value = classId;
            modalClassName.innerText = className;
            modalPlace.innerText = place || 'Not Assigned';
            modalCapacity.innerText = `${currentCount} / ${limit} seats enrolled`;
            toggleModalStudentMode(false);
            enrollModal.classList.remove('hidden');
        }

        function closeEnrollModal() {
            enrollModal.classList.add('hidden');
        }

        // Close modal on backdrop click
        enrollModal.addEventListener('click', (e) => {
            if (e.target === enrollModal) {
                closeEnrollModal();
            }
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                if (!createClassModal.classList.contains('hidden')) {
                    closeCreateClassModal();
                }
                if (!enrollModal.classList.contains('hidden')) {
                    closeEnrollModal();
                }
            }
        });
    </script>
}
