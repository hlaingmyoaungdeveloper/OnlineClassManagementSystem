@model OnlineClassManagementSystem.Domain.models.SubClass.SubClassListResponseModel

<div class="p-8">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800">Class Management</h2>
        <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium shadow-sm transition">
            + Create New Class
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            @TempData["SuccessMessage"]
        </div>
    }
    
    @if ((Model != null && !Model.IsSuccess) || ViewBag.ErrorMessage != null || TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            @(Model?.Message ?? ViewBag.ErrorMessage ?? TempData["ErrorMessage"])
        </div>
    }

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <table class="w-full text-left text-sm">
            <thead class="bg-gray-50 text-gray-500 border-b">
                <tr>
                    <th class="px-6 py-3">Class Name</th>
                    <th class="px-6 py-3">Place</th>
                    <th class="px-6 py-3">Schedule</th>
                    <th class="px-6 py-3">Students</th>
                    <th class="px-6 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model == null || Model.SubClassList == null || !Model.SubClassList.Any())
                {
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-gray-500">No classes available.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.SubClassList)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 font-bold text-gray-800">@item.ClassName</td>
                            <td class="px-6 py-4 text-gray-600">@item.Place</td>
                            <td class="px-6 py-4 text-gray-600">
                                @(item.OpenDate?.ToString("dd-MM-yyyy") ?? "No Date") <br />
                                <span class="text-xs text-gray-400">@item.OpenTime</span>
                            </td>
                            <td class="px-6 py-4 text-gray-600">
                                @item.StudentCount / @item.StudentLimit
                            </td>
                            <td class="px-6 py-4 text-right space-x-3">
                                <a asp-action="Edit" asp-route-id="@item.SubClassId" class="text-blue-600 font-medium hover:underline">Edit</a>

                                <form asp-action="Delete" asp-route-id="@item.SubClassId" method="post" class="inline m-0 p-0">
                                    <button type="submit" class="text-red-600 font-medium bg-transparent border-none cursor-pointer hover:underline" onclick="return confirm('Are you sure you want to delete this class?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>