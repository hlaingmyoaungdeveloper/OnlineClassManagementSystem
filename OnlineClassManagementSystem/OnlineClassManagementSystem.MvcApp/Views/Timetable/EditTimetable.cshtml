@model OnlineClassManagementSystem.Shared.models.Timetable.TimetablePatchRequestModel

@{
    ViewData["Title"] = "Edit Timetable Schedule";
    var classes = ViewBag.Classes as List<OnlineClassManagementSystem.Shared.models.SubClass.SubClassModel>;
    var teachers = ViewBag.Teachers as List<OnlineClassManagementSystem.Shared.models.User.UserModel>;
    var teachPlans = ViewBag.TeachPlans as List<OnlineClassManagementSystem.Shared.models.TeachPlan.TeachPlanModel>;
    int timetableId = ViewBag.TimetableId ?? 0;
}

<div class="min-h-screen bg-slate-50 px-4 py-10">
    <div class="mx-auto max-w-2xl">

        <a asp-controller="Timetable"
           asp-action="Index"
           class="text-sm font-medium text-blue-600 hover:text-blue-800">
            ← Back to Timetables
        </a>

        <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

            <h1 class="text-2xl font-bold text-slate-900">
                Edit Schedule (ID: @timetableId)
            </h1>

            <p class="mt-2 text-sm text-slate-500">
                Update the class, instructor, subject, or time slot.
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="mt-5 rounded-lg bg-red-50 p-3 text-sm text-red-700">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Timetable"
                  asp-action="Edit"
                  asp-route-id="@timetableId"
                  method="post"
                  class="mt-6 space-y-5">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-sm text-red-600"></div>

                <!-- Class -->
                <div>
                    <label asp-for="SubClassId" class="mb-2 block text-sm font-semibold text-slate-700">
                        Class
                    </label>
                    <select asp-for="SubClassId" class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
                        <option value="">-- Select Class --</option>
                        @if (classes != null)
                        {
                            foreach (var c in classes)
                            {
                                <option value="@c.SubClassId">@c.ClassName (ID: @c.SubClassId)</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="SubClassId" class="text-sm text-red-600"></span>
                </div>

                <!-- Teacher -->
                <div>
                    <label asp-for="TeacherId" class="mb-2 block text-sm font-semibold text-slate-700">
                        Teacher / Instructor
                    </label>
                    <select asp-for="TeacherId" class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
                        <option value="">-- Select Teacher --</option>
                        @if (teachers != null)
                        {
                            foreach (var t in teachers)
                            {
                                <option value="@t.UserId">@t.FullName (@t.Email)</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="TeacherId" class="text-sm text-red-600"></span>
                </div>

                <!-- Subject -->
                <div>
                    <label asp-for="SubjectId" class="mb-2 block text-sm font-semibold text-slate-700">
                        Subject
                    </label>
                    @if (teachPlans != null && teachPlans.Count > 0)
                    {
                        <select asp-for="SubjectId" class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
                            <option value="">-- Select Subject / Plan --</option>
                            @foreach (var p in teachPlans)
                            {
                                <option value="@p.SubjectId">@p.SubjectName (ID: @p.SubjectId)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input asp-for="SubjectId" type="number" min="1" class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" placeholder="Enter Subject ID" />
                    }
                    <span asp-validation-for="SubjectId" class="text-sm text-red-600"></span>
                </div>

                <!-- Day of Week & Mode -->
                <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <label asp-for="DayOfWeek" class="mb-2 block text-sm font-semibold text-slate-700">
                            Day of Week
                        </label>
                        <select asp-for="DayOfWeek" class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
                            <option value="Monday">Monday</option>
                            <option value="Tuesday">Tuesday</option>
                            <option value="Wednesday">Wednesday</option>
                            <option value="Thursday">Thursday</option>
                            <option value="Friday">Friday</option>
                            <option value="Saturday">Saturday</option>
                            <option value="Sunday">Sunday</option>
                        </select>
                        <span asp-validation-for="DayOfWeek" class="text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label asp-for="Mode" class="mb-2 block text-sm font-semibold text-slate-700">
                            Mode
                        </label>
                        <select asp-for="Mode" class="w-full rounded-lg border border-slate-300 px-4 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
                            <option value="ClassRoom">ClassRoom (In-Person)</option>
                            <option value="Online">Online</option>
                            <option value="Hybrid">Hybrid</option>
                        </select>
                        <span asp-validation-for="Mode" class="text-sm text-red-600"></span>
                    </div>
                </div>

                <!-- Start Time & End Time -->
                <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <label asp-for="StartTime" class="mb-2 block text-sm font-semibold text-slate-700">
                            Start Time
                        </label>
                        <input asp-for="StartTime" type="time" class="w-full rounded-lg border border-slate-300 px-3 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
                        <span asp-validation-for="StartTime" class="text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label asp-for="EndTime" class="mb-2 block text-sm font-semibold text-slate-700">
                            End Time
                        </label>
                        <input asp-for="EndTime" type="time" class="w-full rounded-lg border border-slate-300 px-3 py-3 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
                        <span asp-validation-for="EndTime" class="text-sm text-red-600"></span>
                    </div>
                </div>

                <div class="flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:justify-end">
                    <a asp-controller="Timetable" asp-action="Index" class="rounded-lg border border-slate-300 px-5 py-3 text-center font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
                    <button type="submit" class="rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700">Update Schedule</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
