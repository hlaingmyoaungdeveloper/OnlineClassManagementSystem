@model OnlineClassManagementSystem.Shared.models.Timetable.TimetablePatchRequestModel

@{
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");
    var isTeacher = currentRole == "teacher";
    ViewData["Title"] = "Edit Timetable Schedule";
    var classes = ViewBag.Classes as List<OnlineClassManagementSystem.Shared.models.SubClass.SubClassModel>;
    var teachers = ViewBag.Teachers as List<OnlineClassManagementSystem.Shared.models.User.UserModel>;
    var teachPlans = ViewBag.TeachPlans as List<OnlineClassManagementSystem.Shared.models.TeachPlan.TeachPlanModel>;
    int timetableId = ViewBag.TimetableId ?? 0;
}

<div class="p-6 md:p-8 space-y-6 max-w-4xl">

    <!-- Back Button -->
    <div>
        <a asp-controller="Timetable" asp-action="Index" asp-route-role="@currentRole"
           class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 transition">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back
        </a>
    </div>

    <!-- Main Card -->
    <div class="rounded-xl border border-slate-200 bg-white p-6 md:p-8 shadow-xs">
        <h1 class="text-xl font-bold tracking-tight text-slate-900 mb-6">Edit Schedule (ID: @timetableId)</h1>

        @if (ViewBag.Error != null)
        {
            <div class="mb-6 rounded-lg bg-red-50 p-3 text-xs text-red-700">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Timetable" asp-action="Edit" asp-route-id="@timetableId" asp-route-role="@currentRole" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs text-red-600"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <!-- Class -->
                <div>
                    <label asp-for="SubClassId" class="block text-xs font-semibold text-slate-700 mb-1.5">Class</label>
                    <select asp-for="SubClassId" class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500">
                        <option value="">-- Select Class --</option>
                        @if (classes != null)
                        {
                            foreach (var c in classes)
                            {
                                <option value="@c.SubClassId">@c.ClassName (ID: @c.SubClassId)</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="SubClassId" class="text-[11px] text-red-600"></span>
                </div>

                <!-- Teacher -->
                <div>
                    <label asp-for="TeacherId" class="block text-xs font-semibold text-slate-700 mb-1.5">Teacher / Instructor</label>
                    <select asp-for="TeacherId" class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500">
                        <option value="">-- Select Teacher --</option>
                        @if (teachers != null)
                        {
                            foreach (var t in teachers)
                            {
                                <option value="@t.UserId">@t.FullName (@t.Email)</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="TeacherId" class="text-[11px] text-red-600"></span>
                </div>
            </div>

            <!-- Subject -->
            <div>
                <label asp-for="SubjectId" class="block text-xs font-semibold text-slate-700 mb-1.5">Subject</label>
                @if (teachPlans != null && teachPlans.Count > 0)
                {
                    <select asp-for="SubjectId" class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500">
                        <option value="">-- Select Subject / Plan --</option>
                        @foreach (var p in teachPlans)
                        {
                            <option value="@p.SubjectId">@p.SubjectName (ID: @p.SubjectId)</option>
                        }
                    </select>
                }
                else
                {
                    <input asp-for="SubjectId" type="number" min="1" class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500" placeholder="Enter Subject ID" />
                }
                <span asp-validation-for="SubjectId" class="text-[11px] text-red-600"></span>
            </div>

            <!-- Day of Week & Mode -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label asp-for="DayOfWeek" class="block text-xs font-semibold text-slate-700 mb-1.5">Day of Week</label>
                    <select asp-for="DayOfWeek" class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500">
                        <option value="Monday">Monday</option>
                        <option value="Tuesday">Tuesday</option>
                        <option value="Wednesday">Wednesday</option>
                        <option value="Thursday">Thursday</option>
                        <option value="Friday">Friday</option>
                        <option value="Saturday">Saturday</option>
                        <option value="Sunday">Sunday</option>
                    </select>
                    <span asp-validation-for="DayOfWeek" class="text-[11px] text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Mode" class="block text-xs font-semibold text-slate-700 mb-1.5">Mode</label>
                    <select asp-for="Mode" class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500">
                        <option value="ClassRoom">ClassRoom (In-Person)</option>
                        <option value="Online">Online</option>
                        <option value="Hybrid">Hybrid</option>
                    </select>
                    <span asp-validation-for="Mode" class="text-[11px] text-red-600"></span>
                </div>
            </div>

            <!-- Start Time & End Time -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label asp-for="StartTime" class="block text-xs font-semibold text-slate-700 mb-1.5">Start Time</label>
                    <input asp-for="StartTime" type="time" class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500" />
                    <span asp-validation-for="StartTime" class="text-[11px] text-red-600"></span>
                </div>

                <div>
                    <label asp-for="EndTime" class="block text-xs font-semibold text-slate-700 mb-1.5">End Time</label>
                    <input asp-for="EndTime" type="time" class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500" />
                    <span asp-validation-for="EndTime" class="text-[11px] text-red-600"></span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-controller="Timetable" asp-action="Index" asp-route-role="@currentRole"
                   class="rounded-lg border border-slate-200 bg-white px-5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">
                    Cancel
                </a>
                <button type="submit"
                        class="rounded-lg @(isTeacher ? "bg-teal-600 hover:bg-teal-700" : "bg-blue-600 hover:bg-blue-700") px-6 py-2 text-xs font-semibold text-white shadow-xs transition">
                    Update Schedule
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
