@model OnlineClassManagementSystem.Shared.models.Timetable.TimetableListResponseModel

@{
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");
    var isTeacher = currentRole == "teacher";
    ViewData["Title"] = isTeacher ? "My Timetable" : "Timetable Management";

    var timetables = Model?.TimetableList ?? new List<OnlineClassManagementSystem.Shared.models.Timetable.TimetableModel>();
    var classes = ViewBag.Classes as List<OnlineClassManagementSystem.Shared.models.SubClass.SubClassModel> ?? new();
    var teachers = ViewBag.Teachers as List<OnlineClassManagementSystem.Shared.models.User.UserModel> ?? new();

    var today = DateTime.Today;
    int diff = (7 + (today.DayOfWeek - DayOfWeek.Sunday)) % 7;
    var startOfWeek = today.AddDays(-1 * diff);
    var days = Enumerable.Range(0, 7).Select(i => {
        var d = startOfWeek.AddDays(i);
        return new {
            Name = d.ToString("ddd"),
            DayNum = d.ToString("dd"),
            DayOfWeek = d.DayOfWeek.ToString(),
            ColIndex = i
        };
    }).ToArray();

    var timeSlots = new (string Label, int Hour)[]
    {
        ("8:00 AM", 8),
        ("9:00 AM", 9),
        ("10:00 AM", 10),
        ("11:00 AM", 11),
        ("1:00 PM", 13),
        ("2:00 PM", 14),
        ("3:00 PM", 15),
        ("4:00 PM", 16)
    };
}

<div class="p-6 md:p-8 space-y-6">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">@(isTeacher ? "My Timetable" : "Timetable Management")</h1>
        </div>
        @if (!isTeacher)
        {
            <div>
                <a asp-action="Create" asp-route-role="@currentRole"
                   class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    Add Schedule
                </a>
            </div>
        }
    </div>

    <!-- Filters Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-xs">
        <form method="get" asp-action="Index" class="flex flex-wrap items-center gap-4 flex-1">
            <input type="hidden" name="role" value="@currentRole" />

            <!-- Class Filter -->
            <div class="w-48">
                <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Class</label>
                <select name="classId" class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs font-medium text-slate-700 outline-none focus:border-blue-500">
                    <option value="">All Classes</option>
                    @foreach (var c in classes)
                    {
                        <option value="@c.SubClassId" selected="@(ViewBag.SelectedClassId == c.SubClassId ? "selected" : null)">@c.ClassName</option>
                    }
                </select>
            </div>

            @if (!isTeacher)
            {
                <!-- Admin Filter: Teacher -->
                <div class="w-48">
                    <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Teacher</label>
                    <select name="teacherId" class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-xs font-medium text-slate-700 outline-none focus:border-blue-500">
                        <option value="">All Teachers</option>
                        @foreach (var t in teachers)
                        {
                            <option value="@t.UserId" selected="@(ViewBag.SelectedTeacherId == t.UserId ? "selected" : null)">@t.FullName</option>
                        }
                    </select>
                </div>
            }

            <div class="self-end">
                <button type="submit" class="rounded-lg @(isTeacher ? "bg-teal-600 hover:bg-teal-700" : "bg-blue-600 hover:bg-blue-700") px-5 py-2 text-xs font-semibold text-white shadow-xs transition">
                    Apply Filter
                </button>
            </div>
        </form>
    </div>

    <!-- Date Navigation Row -->
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <span class="text-sm font-semibold text-slate-800">@startOfWeek.ToString("MMM d") - @startOfWeek.AddDays(6).ToString("MMM d, yyyy")</span>
        </div>

        <div>
            <span class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 shadow-xs">
                Current Week
            </span>
        </div>
    </div>

    <!-- Weekly Timetable Grid -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[760px] border-collapse text-xs">
                <!-- Day Headers -->
                <thead>
                    <tr class="border-b border-slate-200 bg-slate-50/50">
                        <th class="w-24 px-3 py-3 text-center font-medium text-slate-400 border-r border-slate-200">
                            Time
                        </th>
                        @foreach (var day in days)
                        {
                            <th class="px-3 py-3 text-center border-r border-slate-200 last:border-r-0">
                                <span class="block text-slate-500 font-medium text-[11px]">@day.Name</span>
                                <span class="block text-slate-800 font-bold text-sm">@day.DayNum</span>
                            </th>
                        }
                    </tr>
                </thead>

                <!-- Time Slot Rows -->
                <tbody class="divide-y divide-slate-100">
                    @foreach (var slot in timeSlots)
                    {
                        <tr class="h-20 hover:bg-slate-50/30 transition">
                            <!-- Time Label -->
                            <td class="w-24 px-3 py-2 text-center text-[11px] font-semibold text-slate-400 border-r border-slate-200 align-middle">
                                @slot.Label
                            </td>

                            <!-- 7 Days Columns -->
                            @for (int d = 0; d < 7; d++)
                            {
                                var dayInfo = days[d];
                                var matched = timetables.Where(t =>
                                    (string.Equals(t.DayOfWeek, dayInfo.DayOfWeek, StringComparison.OrdinalIgnoreCase) ||
                                     string.Equals(t.DayOfWeek, dayInfo.Name, StringComparison.OrdinalIgnoreCase)) &&
                                    t.StartTime.Hour == slot.Hour).ToList();

                                <td class="p-1.5 border-r border-slate-200 last:border-r-0 align-top relative">
                                    @if (matched.Any())
                                    {
                                        foreach (var item in matched)
                                        {
                                            <div class="w-full rounded-lg bg-blue-50 border border-blue-200 p-2 text-center shadow-xs flex flex-col justify-center mb-1 last:mb-0">
                                                <span class="font-bold text-blue-700 text-xs leading-tight">@(item.SubjectName ?? "Subject")</span>
                                                <span class="text-[10px] text-blue-600 font-medium">@(item.ClassName ?? ("Class #" + item.SubClassId))</span>
                                                @if (!string.IsNullOrEmpty(item.TeacherName))
                                                {
                                                    <span class="text-[9px] text-slate-500 font-normal truncate mt-0.5">@item.TeacherName</span>
                                                }
                                                <span class="text-[9px] text-slate-400">@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")</span>
                                            </div>
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
