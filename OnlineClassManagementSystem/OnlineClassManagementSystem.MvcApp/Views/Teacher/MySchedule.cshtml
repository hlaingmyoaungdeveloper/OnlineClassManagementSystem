@model OnlineClassManagementSystem.MvcApp.ViewModels.ScheduleViewModel
@{
    ViewData["Title"] = "My Schedule";
    var hours = Enumerable.Range(8, 9); // 8 AM to 4 PM (8 hours = 480px)
    var calendarHeight = 480; // 60px per hour × 8 hours
}

@if (Model.ErrorMessage != null)
{
    <div class="mb-5 bg-amber-50 border border-amber-200 rounded-xl p-4 text-amber-700 text-sm">ℹ️ @Model.ErrorMessage</div>
}

<!-- Legend -->
<div class="flex items-center gap-4 mb-5 flex-wrap">
    <p class="text-sm text-slate-500">Mode:</p>
    <span class="flex items-center gap-1.5 text-xs font-medium text-slate-600">
        <span class="w-3 h-3 rounded bg-indigo-600 inline-block"></span> Classroom
    </span>
    <span class="flex items-center gap-1.5 text-xs font-medium text-slate-600">
        <span class="w-3 h-3 rounded bg-blue-500 inline-block"></span> Online
    </span>
    <span class="flex items-center gap-1.5 text-xs font-medium text-slate-600">
        <span class="w-3 h-3 rounded bg-purple-500 inline-block"></span> Hybrid
    </span>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    <!-- Day Headers -->
    <div class="grid border-b border-slate-100" style="grid-template-columns: 60px repeat(5, 1fr);">
        <div class="p-3 border-r border-slate-100 bg-slate-50"></div>
        @foreach (var day in Model.Days)
        {
            <div class="p-3 text-center border-r border-slate-100 last:border-r-0 bg-slate-50">
                <p class="text-xs font-bold text-slate-700 uppercase tracking-wide">@day[..3]</p>
                <p class="text-xs text-slate-400 hidden sm:block">@day</p>
            </div>
        }
    </div>

    <!-- Time Grid -->
    <div class="grid relative" style="grid-template-columns: 60px repeat(5, 1fr);">

        <!-- Hour Labels -->
        <div class="border-r border-slate-100">
            @foreach (var h in hours)
            {
                <div class="h-[60px] border-b border-slate-50 flex items-start justify-end pr-2 pt-1">
                    <span class="text-[10px] font-medium text-slate-400">
                        @(h <= 12 ? $"{h}AM" : $"{h - 12}PM")
                    </span>
                </div>
            }
        </div>

        <!-- Day Columns -->
        @foreach (var day in Model.Days)
        {
            var dayEntries = Model.ForDay(day).ToList();
            <div class="border-r border-slate-100 last:border-r-0 relative" style="height: @(calendarHeight)px;">
                <!-- Hour lines -->
                @foreach (var h in hours)
                {
                    <div class="absolute w-full border-b border-slate-50" style="top: @((h - 8) * 60)px; left: 0;"></div>
                }

                <!-- Class Blocks -->
                @foreach (var entry in dayEntries)
                {
                    var top = entry.GridTopPx;
                    var height = Math.Max(entry.GridHeightPx, 30);
                    <div class="absolute left-1 right-1 @entry.ModeClass text-white rounded-xl px-2 py-1.5 overflow-hidden shadow-sm
                                hover:brightness-110 transition-all duration-200 cursor-default group"
                         style="top: @(top)px; height: @(height)px; min-height: 30px;">
                        <p class="text-[11px] font-bold leading-tight truncate">@entry.ClassName</p>
                        @if (height >= 50)
                        {
                            <p class="text-[10px] opacity-80 truncate">@entry.SubjectName</p>
                            <p class="text-[10px] opacity-70">@entry.StartTime.ToString("HH:mm") – @entry.EndTime.ToString("HH:mm")</p>
                        }
                        <!-- Tooltip on hover -->
                        <div class="hidden group-hover:block absolute z-10 bottom-full left-0 mb-1 bg-slate-900 text-white text-xs rounded-lg px-3 py-2 shadow-xl whitespace-nowrap">
                            <p class="font-bold">@entry.ClassName</p>
                            <p class="text-slate-300">@entry.SubjectName</p>
                            <p class="text-slate-400">@entry.StartTime.ToString("HH:mm") – @entry.EndTime.ToString("HH:mm")</p>
                            <p class="text-slate-400">Mode: @entry.Mode</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (!Model.Entries.Any())
{
    <div class="mt-6 text-center py-10">
        <p class="text-slate-400 text-sm">No schedule entries found for this week.</p>
    </div>
}
