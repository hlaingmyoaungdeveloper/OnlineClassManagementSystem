@model OnlineClassManagementSystem.MvcApp.ViewModels.EnrollmentListViewModel
@{
    ViewData["Title"] = $"Student Roster — {ViewBag.ClassName}";
}

<div class="mb-5 flex items-center gap-3">
    <a href="@Url.Action("MyClasses","Teacher")"
       class="p-2 rounded-xl hover:bg-white text-slate-500 hover:text-slate-800 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
    </a>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="mb-5 bg-amber-50 border border-amber-200 rounded-xl p-4 text-amber-700 text-sm">ℹ️ @Model.ErrorMessage</div>
}

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <div>
            <h2 class="text-base font-bold text-slate-800">@ViewBag.ClassName</h2>
            <p class="text-slate-400 text-xs mt-0.5">Approved students only · @Model.Enrollments.Count enrolled</p>
        </div>
        <div class="w-10 h-10 bg-green-100 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
        </div>
    </div>

    @if (!Model.Enrollments.Any())
    {
        <div class="py-16 text-center">
            <p class="text-slate-400 text-sm">No approved students in this class yet.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-slate-50 text-left">
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">#</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Student Name</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Student ID</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Enrolled On</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var (e, i) in Model.Enrollments.Select((e, i) => (e, i + 1)))
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-3.5 text-slate-400 font-mono text-xs">@i</td>
                            <td class="px-6 py-3.5">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-full bg-gradient-to-br from-indigo-400 to-purple-500 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
                                        @(e.StudentName?.Length > 0 ? e.StudentName[0].ToString().ToUpper() : "?")
                                    </div>
                                    <span class="font-semibold text-slate-800">@e.StudentName</span>
                                </div>
                            </td>
                            <td class="px-6 py-3.5 text-slate-500 font-mono text-xs">@e.StudentId</td>
                            <td class="px-6 py-3.5 text-slate-500">@(e.EnrollDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                            <td class="px-6 py-3.5">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                    Approved
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
