@model OnlineClassManagementSystem.MvcApp.ViewModels.SubClassListViewModel
@{
    ViewData["Title"] = "My Classes";
}

@if (Model.ErrorMessage != null)
{
    <div class="mb-5 bg-amber-50 border border-amber-200 rounded-xl p-4 text-amber-700 text-sm">
        ℹ️ @Model.ErrorMessage
    </div>
}

@if (!Model.Classes.Any())
{
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 py-20 text-center">
        <svg class="w-14 h-14 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
        <p class="text-slate-400 text-sm font-medium">You have no classes assigned yet.</p>
        <p class="text-slate-300 text-xs mt-1">Ask your admin to assign classes to your account.</p>
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        @foreach (var cls in Model.Classes)
        {
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 flex flex-col">
                <div class="flex items-start justify-between gap-3 mb-4">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center flex-shrink-0 shadow-sm">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253"/>
                        </svg>
                    </div>
                    <span class="text-xs bg-green-100 text-green-700 font-semibold px-2.5 py-1 rounded-full">Active</span>
                </div>

                <h3 class="text-base font-bold text-slate-800 mb-1">@cls.ClassName</h3>
                <p class="text-sm text-slate-400 mb-4">Class ID: @cls.SubClassId</p>

                <div class="mt-auto flex gap-2">
                    <a href="@Url.Action("StudentRoster","Teacher", new { classId = cls.SubClassId })"
                       class="flex-1 text-center py-2 px-3 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold rounded-xl transition-colors">
                        👥 View Roster
                    </a>
                    <a href="@Url.Action("MySchedule","Teacher")"
                       class="flex-1 text-center py-2 px-3 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-semibold rounded-xl transition-colors">
                        📅 Schedule
                    </a>
                </div>
            </div>
        }
    </div>
}
