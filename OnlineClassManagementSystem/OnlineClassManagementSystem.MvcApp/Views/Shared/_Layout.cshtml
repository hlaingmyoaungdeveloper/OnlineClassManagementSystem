
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Online Class Management System</title>

    <!-- Tailwind CSS Browser CDN: suitable for development -->
<script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/OnlineClassManagementSystem.MvcApp.styles.css"
          asp-append-version="true" />
</head>

<body class="min-h-screen bg-slate-50 text-slate-800 antialiased">

    <!-- Main Page Content -->
    <main role="main" class="min-h-screen">
        @RenderBody()
    </main>

    <!-- Optional Footer -->
    <footer class="border-t border-slate-200 bg-white px-6 py-4">
        <div class="mx-auto max-w-7xl text-center text-sm text-slate-500">
            &copy; @DateTime.Now.Year - Online Class Management System
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js" integrity="sha256-+bUdzX9O0/6n+U0VwZVdO9yqB6e3hC/5YBk2VZ+zR0U=" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
