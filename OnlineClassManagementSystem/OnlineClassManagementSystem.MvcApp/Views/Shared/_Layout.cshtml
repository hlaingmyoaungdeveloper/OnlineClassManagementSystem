<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Online Class Management System - Manage classes, enrollments and schedules." />
    <title>@ViewData["Title"] — OCMS</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                    animation: {
                        'fade-in': 'fadeIn 0.4s ease-out',
                        'slide-in': 'slideIn 0.3s ease-out',
                    },
                    keyframes: {
                        fadeIn: { '0%': { opacity: '0', transform: 'translateY(8px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },
                        slideIn: { '0%': { transform: 'translateX(-8px)', opacity: '0' }, '100%': { transform: 'translateX(0)', opacity: '1' } },
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', system-ui, sans-serif; }
        .sidebar-gradient { background: linear-gradient(180deg, #4338ca 0%, #3730a3 40%, #312e81 100%); }
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #c7d2fe; border-radius: 99px; }
        .toast-enter { animation: fadeIn 0.4s ease-out; }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-slate-50 text-slate-800 antialiased">

@{
    var isLoggedIn = Context.Session.GetString("UserRole") != null;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    var username = Context.Session.GetString("Username") ?? "";
    var role = Context.Session.GetString("UserRole") ?? "";
}

@if (isLoggedIn)
{
    <div class="flex h-screen overflow-hidden">

        <!-- Sidebar -->
        <aside id="sidebar" class="sidebar-gradient flex flex-col w-64 flex-shrink-0 shadow-2xl z-30 transition-all duration-300 overflow-hidden">
            @await Html.PartialAsync("_Sidebar")
        </aside>

        <!-- Main Area -->
        <div class="flex flex-col flex-1 overflow-hidden">

            <!-- Top Navbar -->
            <header class="bg-white border-b border-slate-200 px-6 py-3 flex items-center justify-between shadow-sm z-20">
                <div class="flex items-center gap-4">
                    <button onclick="document.getElementById('sidebar').classList.toggle('hidden')"
                            class="lg:hidden p-2 rounded-lg hover:bg-slate-100 text-slate-500">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>
                    <div>
                        <h1 class="text-lg font-bold text-slate-800">@pageTitle</h1>
                        <p class="text-xs text-slate-400">Online Class Management System</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <span class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full
                        @(role == "Admin" ? "bg-orange-100 text-orange-700" :
                          role == "Teacher" ? "bg-green-100 text-green-700" :
                          "bg-blue-100 text-blue-700")">
                        <span class="w-1.5 h-1.5 rounded-full
                            @(role == "Admin" ? "bg-orange-500" :
                              role == "Teacher" ? "bg-green-500" : "bg-blue-500")"></span>
                        @role
                    </span>
                    <div class="flex items-center gap-2">
                        <div class="w-9 h-9 rounded-full bg-indigo-600 flex items-center justify-center text-white font-bold text-sm shadow">
                            @(username.Length > 0 ? username[0].ToString().ToUpper() : "?")
                        </div>
                        <span class="hidden md:block text-sm font-medium text-slate-700">@username</span>
                    </div>
                </div>
            </header>

            <!-- Toast Notifications -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="toast-enter mx-6 mt-4 flex items-center gap-3 px-4 py-3 bg-green-50 border border-green-200 rounded-xl text-green-800 text-sm shadow-sm">
                    <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="toast-enter mx-6 mt-4 flex items-center gap-3 px-4 py-3 bg-red-50 border border-red-200 rounded-xl text-red-800 text-sm shadow-sm">
                    <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                    @TempData["ErrorMessage"]
                </div>
            }

            <!-- Page Content -->
            <main class="flex-1 overflow-y-auto p-6" style="animation: fadeIn 0.4s ease-out;">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <main class="min-h-screen">
        @RenderBody()
    </main>
}

@await RenderSectionAsync("Scripts", required: false)
<script>
    document.querySelectorAll('.toast-enter').forEach(el => {
        setTimeout(() => {
            el.style.transition = 'opacity 0.4s';
            el.style.opacity = '0';
            setTimeout(() => el.remove(), 400);
        }, 5000);
    });
</script>
</body>
</html>

