@{
    var role = Context.Session.GetString("UserRole") ?? "Guest";
    var username = Context.Session.GetString("Username") ?? "Guest";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string NavClass(string controller, string action = "") {
        bool match = controller == currentController && (action == "" || action == currentAction);
        return match
            ? "flex items-center gap-3 px-4 py-3 rounded-xl bg-white/20 text-white font-semibold shadow-sm"
            : "flex items-center gap-3 px-4 py-3 rounded-xl text-indigo-100 hover:bg-white/10 transition-all duration-200";
    }
}

<!-- Sidebar Brand -->
<div class="flex items-center gap-3 px-4 py-5 border-b border-white/20">
    <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
    </div>
    <div>
        <p class="text-white font-bold text-sm leading-tight">OCMS</p>
        <p class="text-indigo-200 text-xs">Online Class System</p>
    </div>
</div>

<!-- User Info -->
<div class="px-4 py-4 border-b border-white/20">
    <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-white/30 flex items-center justify-center text-white font-bold text-sm">
            @(username.Length > 0 ? username[0].ToString().ToUpper() : "?")
        </div>
        <div class="min-w-0">
            <p class="text-white text-sm font-semibold truncate">@username</p>
            <span class="inline-block text-xs px-2 py-0.5 rounded-full font-medium
                @(role == "Admin" ? "bg-orange-400/30 text-orange-200" :
                  role == "Teacher" ? "bg-green-400/30 text-green-200" :
                  "bg-blue-400/30 text-blue-200")">
                @role
            </span>
        </div>
    </div>
</div>

<!-- Navigation Links -->
<nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">

    @if (role == "Admin")
    {
        <p class="text-indigo-300 text-xs font-semibold uppercase tracking-wider px-4 mb-2">Admin</p>

        <a href="@Url.Action("Dashboard","Admin")" class="@NavClass("Admin","Dashboard")">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            Dashboard
        </a>

        <a href="@Url.Action("Classes","Admin")" class="@NavClass("Admin","Classes")">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            Class Management
        </a>

        <a href="@Url.Action("EnrollmentRequests","Admin")" class="@NavClass("Admin","EnrollmentRequests")">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
            Enrollment Requests
        </a>

        <a href="@Url.Action("Users","Admin")" class="@NavClass("Admin","Users")">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            User Management
        </a>
    }

    @if (role == "Teacher")
    {
        <p class="text-indigo-300 text-xs font-semibold uppercase tracking-wider px-4 mb-2">Teacher</p>

        <a href="@Url.Action("MyClasses","Teacher")" class="@NavClass("Teacher","MyClasses")">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            My Classes
        </a>

        <a href="@Url.Action("MySchedule","Teacher")" class="@NavClass("Teacher","MySchedule")">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            My Schedule
        </a>
    }

    @if (role == "Student")
    {
        <p class="text-indigo-300 text-xs font-semibold uppercase tracking-wider px-4 mb-2">Student</p>

        <a href="@Url.Action("BrowseClasses","Student")" class="@NavClass("Student","BrowseClasses")">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            Browse Classes
        </a>

        <a href="@Url.Action("MyEnrollments","Student")" class="@NavClass("Student","MyEnrollments")">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            My Enrollments
        </a>

        <a href="@Url.Action("MyTimetable","Student")" class="@NavClass("Student","MyTimetable")">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            My Timetable
        </a>
    }
</nav>

<!-- Logout -->
<div class="px-3 pb-4">
    <a href="@Url.Action("Logout","Home")"
       class="flex items-center gap-3 px-4 py-3 rounded-xl text-indigo-200 hover:bg-red-500/30 hover:text-white transition-all duration-200">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        Sign Out
    </a>
</div>
