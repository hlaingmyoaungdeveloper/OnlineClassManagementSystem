@model OnlineClassManagementSystem.Shared.models.TeachingTracking.TeachingTrackingListResponseModel

@{
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");
    var isTeacher = currentRole == "teacher";
    ViewData["Title"] = isTeacher ? "My Test Tracking" : "Test Tracking";

    var trackings = Model?.TeachingTrackingList ?? new List<OnlineClassManagementSystem.Shared.models.TeachingTracking.TeachingTrackingModel>();
}

<div class="p-6 md:p-8 space-y-6">

    <!-- Header Section with Title and Add Button -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">@(isTeacher ? "My Test Tracking" : "Test Tracking")</h1>
        </div>
        <div>
            <a asp-action="Create" asp-route-role="@currentRole"
               class="inline-flex items-center gap-1.5 rounded-lg @(isTeacher ? "bg-teal-600 hover:bg-teal-700" : "bg-blue-600 hover:bg-blue-700") px-4 py-2 text-xs font-semibold text-white shadow-xs transition">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Add Test Tracking
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3.5 text-xs text-emerald-800">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null || ViewBag.Error != null)
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-3.5 text-xs text-amber-800">
            @(TempData["Error"] ?? ViewBag.Error)
        </div>
    }

    <!-- Search / Filter Row -->
    <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-xs">
        <div class="flex flex-wrap items-center gap-4 flex-1">
            <div class="flex-1 min-w-[200px] max-w-sm">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </span>
                    <input type="text" placeholder="Search test tracking..." class="w-full rounded-lg border border-slate-200 bg-slate-50/50 py-2 pl-9 pr-3 text-xs text-slate-700 outline-none focus:border-blue-500" />
                </div>
            </div>
        </div>
        <div class="text-xs text-slate-500">
            Total: <span class="font-semibold text-slate-700">@trackings.Count</span> records
        </div>
    </div>

    <!-- Table Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50/80 text-xs font-semibold uppercase text-slate-500 border-b border-slate-200/80">
                    <tr>
                        <th class="px-6 py-3.5">ID</th>
                        <th class="px-6 py-3.5">Class</th>
                        <th class="px-6 py-3.5">Teacher</th>
                        <th class="px-6 py-3.5">Topic / Plan</th>
                        <th class="px-6 py-3.5">Date Taught</th>
                        <th class="px-6 py-3.5">Time</th>
                        <th class="px-6 py-3.5">Remarks</th>
                        <th class="px-6 py-3.5 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (trackings.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="px-6 py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <svg class="h-8 w-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                    <span>No test tracking records found.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var track in trackings)
                        {
                            var codeId = "TT00" + track.TrackId;

                            <tr class="hover:bg-slate-50/60 transition">
                                <td class="px-6 py-4 font-semibold text-slate-800">@codeId</td>
                                <td class="px-6 py-4 text-slate-800 font-medium">@(track.ClassName ?? ("Class #" + track.SubClassId))</td>
                                <td class="px-6 py-4 text-slate-700">@(track.TeacherName ?? ("Teacher #" + track.TeacherId))</td>
                                <td class="px-6 py-4 text-slate-700">@(track.TopicTaught ?? "-")</td>
                                <td class="px-6 py-4 text-slate-500">@track.DateTaught.ToString("yyyy-MM-dd")</td>
                                <td class="px-6 py-4 text-slate-500">
                                    @track.StartTime.ToString("HH:mm") - @track.EndTime.ToString("HH:mm")
                                </td>
                                <td class="px-6 py-4 text-slate-500">@(string.IsNullOrEmpty(track.Remarks) ? "-" : track.Remarks)</td>
                                <td class="px-6 py-4 text-center">
                                    <div class="inline-flex items-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@track.TrackId" asp-route-role="@currentRole" class="text-blue-600 hover:text-blue-800 p-1" title="Edit">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@track.TrackId" asp-route-role="@currentRole" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-rose-500 hover:text-rose-700 p-1" title="Delete" onclick="return confirm('Are you sure you want to delete this tracking record?');">
                                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-200/80 px-6 py-3.5 bg-slate-50/50 text-xs text-slate-500">
            <span>Showing @(trackings.Count > 0 ? "1-" + trackings.Count : "0") of @trackings.Count</span>
            <div class="flex items-center gap-1">
                <button class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-400 hover:bg-slate-100">&lt;</button>
                <button class="h-7 w-7 rounded-md bg-blue-600 text-white font-semibold flex items-center justify-center">1</button>
                <button class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-400 hover:bg-slate-100">&gt;</button>
            </div>
        </div>
    </div>

</div>
