@model OnlineClassManagementSystem.Shared.models.TeachingTracking.TeachingTrackingCreateRequestModel

@{
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");
    var isTeacher = currentRole == "teacher";
    ViewData["Title"] = "Add Test Tracking";

    var teachPlans = ViewBag.TeachPlans as List<OnlineClassManagementSystem.Shared.models.TeachPlan.TeachPlanModel> ?? new();
    var subClasses = ViewBag.SubClasses as List<OnlineClassManagementSystem.Shared.models.SubClass.SubClassModel> ?? new();
    var teachers = ViewBag.Teachers as List<OnlineClassManagementSystem.Shared.models.User.UserModel> ?? new();
}

<div class="p-6 md:p-8 space-y-6 max-w-4xl">

    <!-- Back Button -->
    <div>
        <a asp-controller="TeachingTracking" asp-action="Index" asp-route-role="@currentRole"
           class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 transition">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back
        </a>
    </div>

    <!-- Main Card -->
    <div class="rounded-xl border border-slate-200 bg-white p-6 md:p-8 shadow-xs">
        <h1 class="text-xl font-bold tracking-tight text-slate-900 mb-6">Add Test Tracking</h1>

        @if (ViewBag.Error != null)
        {
            <div class="mb-6 rounded-lg bg-red-50 p-3 text-xs text-red-700">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="TeachingTracking" asp-action="Create" asp-route-role="@currentRole" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs text-red-600"></div>

            <!-- Class & Test Plan Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Class <span class="text-rose-500">*</span></label>
                    <select asp-for="SubClassId" required class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500">
                        <option value="">-- Select Class --</option>
                        @foreach (var cls in subClasses)
                        {
                            <option value="@cls.SubClassId">@cls.ClassName</option>
                        }
                    </select>
                    <span asp-validation-for="SubClassId" class="text-[11px] text-red-600"></span>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Test Plan <span class="text-rose-500">*</span></label>
                    <select asp-for="TeachPlanId" required class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500">
                        <option value="">-- Select Test Plan --</option>
                        @foreach (var plan in teachPlans)
                        {
                            <option value="@plan.Id">@plan.Topic (@(plan.SubjectName ?? ("Subject #" + plan.SubjectId)))</option>
                        }
                    </select>
                    <span asp-validation-for="TeachPlanId" class="text-[11px] text-red-600"></span>
                </div>
            </div>

            <!-- Teacher & Date Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Teacher <span class="text-rose-500">*</span></label>
                    <select asp-for="TeacherId" required class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500">
                        <option value="">-- Select Teacher --</option>
                        @foreach (var teacher in teachers)
                        {
                            <option value="@teacher.UserId">@teacher.FullName</option>
                        }
                    </select>
                    <span asp-validation-for="TeacherId" class="text-[11px] text-red-600"></span>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Date Taught <span class="text-rose-500">*</span></label>
                    <input type="date" asp-for="DateTaught" required
                           class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500" />
                    <span asp-validation-for="DateTaught" class="text-[11px] text-red-600"></span>
                </div>
            </div>

            <!-- Start Time & End Time Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Start Time</label>
                    <input type="time" asp-for="StartTime"
                           class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500" />
                    <span asp-validation-for="StartTime" class="text-[11px] text-red-600"></span>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">End Time</label>
                    <input type="time" asp-for="EndTime"
                           class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500" />
                    <span asp-validation-for="EndTime" class="text-[11px] text-red-600"></span>
                </div>
            </div>

            <!-- Remarks -->
            <div>
                <label asp-for="Remarks" class="block text-xs font-semibold text-slate-700 mb-1.5">Remarks</label>
                <textarea asp-for="Remarks" rows="3" placeholder="Enter remarks (optional)..."
                          class="w-full rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500"></textarea>
                <span asp-validation-for="Remarks" class="text-[11px] text-red-600"></span>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-controller="TeachingTracking" asp-action="Index" asp-route-role="@currentRole"
                   class="rounded-lg border border-slate-200 bg-white px-5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">
                    Cancel
                </a>
                <button type="submit"
                        class="rounded-lg @(isTeacher ? "bg-teal-600 hover:bg-teal-700" : "bg-blue-600 hover:bg-blue-700") px-6 py-2 text-xs font-semibold text-white shadow-xs transition">
                    Save
                </button>
            </div>
        </form>
    </div>

</div>
