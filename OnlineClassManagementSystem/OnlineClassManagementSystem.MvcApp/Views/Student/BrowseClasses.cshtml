@model OnlineClassManagementSystem.MvcApp.ViewModels.SubClassListViewModel
@{
    ViewData["Title"] = "Browse Classes";
    var studentId = (int)(ViewBag.StudentId ?? 0);
    var enrolledIds = (HashSet<int>)(ViewBag.EnrolledClassIds ?? new HashSet<int>());
}

<div class="mb-6 flex items-center justify-between">
    <p class="text-slate-500 text-sm">Discover available classes and enroll to get started.</p>
    <span class="text-xs bg-indigo-50 text-indigo-600 font-semibold px-3 py-1.5 rounded-full">
        @Model.Classes.Count(c => !c.IsFull) available
    </span>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="mb-5 bg-red-50 border border-red-200 rounded-xl p-4 text-red-700 text-sm">⚠️ @Model.ErrorMessage</div>
}

@if (!Model.Classes.Any())
{
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 py-20 text-center">
        <svg class="w-14 h-14 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <p class="text-slate-400 text-sm">No classes available at the moment.</p>
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        @foreach (var cls in Model.Classes)
        {
            bool alreadyEnrolled = enrolledIds.Contains(cls.SubClassId);

            <div class="bg-white rounded-2xl shadow-sm border @(cls.IsFull ? "border-red-100" : "border-slate-100") overflow-hidden
                        hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 flex flex-col">

                <!-- Card Header -->
                <div class="p-5 pb-3 flex items-start justify-between gap-3">
                    <div class="flex items-start gap-3 min-w-0">
                        <div class="w-11 h-11 rounded-xl flex-shrink-0 flex items-center justify-center
                            @(cls.IsFull ? "bg-red-100" : "bg-gradient-to-br from-indigo-500 to-purple-600")">
                            <svg class="w-5 h-5 @(cls.IsFull ? "text-red-400" : "text-white")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253"/>
                            </svg>
                        </div>
                        <div class="min-w-0">
                            <h3 class="text-base font-bold text-slate-800 leading-tight truncate">@cls.ClassName</h3>
                            <p class="text-xs text-slate-400 mt-0.5 flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                @cls.Place
                            </p>
                        </div>
                    </div>
                    @if (cls.IsFull)
                    {
                        <span class="flex-shrink-0 text-xs bg-red-100 text-red-600 font-bold px-2.5 py-1 rounded-full">Full</span>
                    }
                    else if (alreadyEnrolled)
                    {
                        <span class="flex-shrink-0 text-xs bg-green-100 text-green-700 font-bold px-2.5 py-1 rounded-full">Enrolled</span>
                    }
                </div>

                <!-- Card Details -->
                <div class="px-5 py-2 space-y-1.5 flex-1">
                    <div class="flex items-center gap-2 text-xs text-slate-500">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        @(cls.OpenDate ?? "TBA")
                    </div>
                    <div class="flex items-center gap-2 text-xs text-slate-500">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        @cls.OpenTime
                    </div>
                </div>

                <!-- Capacity Bar -->
                <div class="px-5 pt-3 pb-1">
                    <div class="flex items-center justify-between text-xs text-slate-500 mb-1.5">
                        <span>Capacity</span>
                        <span class="font-semibold @(cls.IsFull ? "text-red-600" : cls.CapacityPercent > 75 ? "text-amber-600" : "text-green-600")">
                            @cls.StudentCount / @cls.StudentLimit
                        </span>
                    </div>
                    <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full rounded-full transition-all duration-700
                            @(cls.IsFull ? "bg-red-500" : cls.CapacityPercent > 75 ? "bg-amber-500" : "bg-green-500")"
                             style="width: @cls.CapacityPercent.ToString("F0")%">
                        </div>
                    </div>
                </div>

                <!-- Enroll Button -->
                <div class="p-5 pt-3">
                    @if (cls.IsFull)
                    {
                        <button disabled
                                class="w-full py-2.5 bg-slate-100 text-slate-400 text-sm font-semibold rounded-xl cursor-not-allowed">
                            Class Full — No Spots Available
                        </button>
                    }
                    else if (alreadyEnrolled)
                    {
                        <button disabled
                                class="w-full py-2.5 bg-green-50 text-green-600 text-sm font-semibold rounded-xl cursor-not-allowed">
                            ✓ Already Enrolled
                        </button>
                    }
                    else
                    {
                        <form asp-action="Enroll" asp-controller="Student" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ClassId" value="@cls.SubClassId" />
                            <input type="hidden" name="StudentId" value="@studentId" />
                            <button type="submit" id="enroll-@cls.SubClassId"
                                    class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-sm shadow-indigo-200 hover:shadow-indigo-300 transition-all duration-200">
                                Enroll Now →
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
