@model OnlineClassManagementSystem.Domain.models.Timetable.TimetableModel

@{
    ViewData["Title"] = "Edit Schedule";
}

<div class="max-w-2xl mx-auto">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a asp-controller="Schedule" asp-action="Index" class="hover:text-blue-600 transition no-underline text-gray-500">Schedules</a>
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-gray-800 font-medium">Edit Schedule</span>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-100 bg-gradient-to-r from-blue-50 to-indigo-50">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-gray-800">Edit Schedule</h3>
                    <p class="text-xs text-gray-500">Update timetable details for <strong>@(Model?.ClassName ?? "Class")</strong>.</p>
                </div>
            </div>
        </div>

        <form asp-action="Edit" asp-route-id="@ViewBag.ScheduleId" method="post" class="p-6 space-y-5">
            @Html.AntiForgeryToken()

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-sm font-medium">@ViewBag.ErrorMessage</span>
                </div>
            }

            <!-- Current Info -->
            <div class="bg-gray-50 rounded-xl p-4 border border-gray-100">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Current Schedule</p>
                <div class="grid grid-cols-2 gap-3 text-sm">
                    <div>
                        <span class="text-gray-400">Class:</span>
                        <span class="font-medium text-gray-700 ml-1">@(Model?.ClassName ?? "—")</span>
                    </div>
                    <div>
                        <span class="text-gray-400">Teacher:</span>
                        <span class="font-medium text-gray-700 ml-1">@(Model?.TeacherName ?? "—")</span>
                    </div>
                    <div>
                        <span class="text-gray-400">Subject:</span>
                        <span class="font-medium text-gray-700 ml-1">@(Model?.SubjectName ?? "—")</span>
                    </div>
                    <div>
                        <span class="text-gray-400">Day:</span>
                        <span class="font-medium text-gray-700 ml-1">@(Model?.DayOfWeek ?? "—")</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label for="SubClassId" class="block text-sm font-semibold text-gray-700 mb-1.5">Class ID</label>
                    <input name="SubClassId" type="number" value="@Model?.SubClassId" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition">
                </div>
                <div>
                    <label for="TeacherId" class="block text-sm font-semibold text-gray-700 mb-1.5">Teacher ID</label>
                    <input name="TeacherId" type="number" value="@Model?.TeacherId" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition">
                </div>
                <div>
                    <label for="SubjectId" class="block text-sm font-semibold text-gray-700 mb-1.5">Subject ID</label>
                    <input name="SubjectId" type="number" value="@Model?.SubjectId" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition">
                </div>
            </div>

            <div>
                <label for="DayOfWeek" class="block text-sm font-semibold text-gray-700 mb-1.5">Day of Week</label>
                <select name="DayOfWeek" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition bg-white">
                    <option value="">-- Select Day --</option>
                    @{
                        var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
                    }
                    @foreach (var day in days)
                    {
                        <option value="@day" selected="@(Model?.DayOfWeek == day)">@day</option>
                    }
                </select>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="StartTime" class="block text-sm font-semibold text-gray-700 mb-1.5">Start Time</label>
                    <input name="StartTime" type="time" value="@Model?.StartTime.ToString("HH\\:mm")" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition">
                </div>
                <div>
                    <label for="EndTime" class="block text-sm font-semibold text-gray-700 mb-1.5">End Time</label>
                    <input name="EndTime" type="time" value="@Model?.EndTime.ToString("HH\\:mm")" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition">
                </div>
            </div>

            <div>
                <label for="Mode" class="block text-sm font-semibold text-gray-700 mb-1.5">Mode</label>
                <select name="Mode" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition bg-white">
                    <option value="ClassRoom" selected="@(Model?.Mode == "ClassRoom")">ClassRoom</option>
                    <option value="Online" selected="@(Model?.Mode == "Online")">Online</option>
                </select>
            </div>

            <div class="pt-4 flex justify-end gap-3 border-t border-gray-100">
                <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-xl font-medium transition text-sm no-underline">Cancel</a>
                <button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white rounded-xl font-semibold shadow-md hover:shadow-lg transition-all text-sm">
                    Update Schedule
                </button>
            </div>
        </form>
    </div>
</div>
