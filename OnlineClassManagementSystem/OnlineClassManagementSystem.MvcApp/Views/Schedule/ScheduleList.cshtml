@model OnlineClassManagementSystem.Domain.models.Timetable.TimetableListResponseModel

@{
    ViewData["Title"] = "Schedules";

    var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
    var dayAbbr = new Dictionary<string, string>
    {
        {"Monday","MON"}, {"Tuesday","TUE"}, {"Wednesday","WED"},
        {"Thursday","THU"}, {"Friday","FRI"}, {"Saturday","SAT"}, {"Sunday","SUN"}
    };

    // Group schedules by teacher
    var teacherGroups = Model?.TimetableList?
        .GroupBy(t => new { t.TeacherId, t.TeacherName })
        .OrderBy(g => g.Key.TeacherName)
        .ToList();

    // Color palette for subjects (rotate through)
    var subjectColors = new[]
    {
        new { bg = "bg-blue-100", text = "text-blue-800", border = "border-blue-200", dot = "bg-blue-500", cardBg = "bg-blue-50" },
        new { bg = "bg-violet-100", text = "text-violet-800", border = "border-violet-200", dot = "bg-violet-500", cardBg = "bg-violet-50" },
        new { bg = "bg-emerald-100", text = "text-emerald-800", border = "border-emerald-200", dot = "bg-emerald-500", cardBg = "bg-emerald-50" },
        new { bg = "bg-amber-100", text = "text-amber-800", border = "border-amber-200", dot = "bg-amber-500", cardBg = "bg-amber-50" },
        new { bg = "bg-rose-100", text = "text-rose-800", border = "border-rose-200", dot = "bg-rose-500", cardBg = "bg-rose-50" },
        new { bg = "bg-cyan-100", text = "text-cyan-800", border = "border-cyan-200", dot = "bg-cyan-500", cardBg = "bg-cyan-50" },
        new { bg = "bg-indigo-100", text = "text-indigo-800", border = "border-indigo-200", dot = "bg-indigo-500", cardBg = "bg-indigo-50" },
        new { bg = "bg-orange-100", text = "text-orange-800", border = "border-orange-200", dot = "bg-orange-500", cardBg = "bg-orange-50" },
    };

    // Map subject IDs to colors
    var subjectColorMap = new Dictionary<int, int>();
    int colorIdx = 0;
    if (Model?.TimetableList != null)
    {
        foreach (var subjectId in Model.TimetableList.Select(t => t.SubjectId).Distinct())
        {
            subjectColorMap[subjectId] = colorIdx % subjectColors.Length;
            colorIdx++;
        }
    }

    // Get current day of week name
    var today = DateTime.Now.DayOfWeek.ToString();
}

<div>
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 gap-4">
        <div>
            <h2 class="text-2xl font-extrabold text-gray-800">Schedules</h2>
            <p class="text-sm text-gray-500 mt-1">Weekly timetable overview across all teachers and classes.</p>
        </div>
        <div class="flex items-center gap-3">
            <!-- View Toggle (visual only) -->
            <div class="inline-flex bg-gray-100 rounded-xl p-1">
                <button class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-gray-400 hover:text-gray-600 transition">Month</button>
                <button class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-gray-800 shadow-sm">Week</button>
                <button class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-gray-400 hover:text-gray-600 transition">Day</button>
            </div>
            <a asp-action="Create"
               class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white px-5 py-2.5 rounded-xl font-semibold shadow-md hover:shadow-lg transition-all duration-200 no-underline text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                New Schedule
            </a>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-700 px-5 py-3 rounded-xl mb-5">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm font-medium">@TempData["SuccessMessage"]</span>
        </div>
    }
    @if ((Model != null && !Model.IsSuccess) || ViewBag.ErrorMessage != null || TempData["ErrorMessage"] != null)
    {
        <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 px-5 py-3 rounded-xl mb-5">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm font-medium">@(Model?.Message ?? ViewBag.ErrorMessage ?? TempData["ErrorMessage"])</span>
        </div>
    }

    <!-- Weekly Timetable Grid -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">

        @if (teacherGroups == null || !teacherGroups.Any())
        {
            <div class="px-6 py-20 text-center">
                <div class="flex flex-col items-center">
                    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <p class="text-gray-500 font-medium text-base">No schedules found</p>
                    <p class="text-gray-400 text-sm mt-1 mb-4">Create a new schedule to populate the timetable.</p>
                    <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg text-sm font-medium transition no-underline">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                        Add Schedule
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Header: "VIEW BY" label -->
            <div class="px-6 py-3 border-b border-gray-100 bg-gray-50/60 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" /></svg>
                    <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">View by: Teachers</span>
                </div>
                <div class="flex items-center gap-2 text-xs text-gray-400">
                    <span class="inline-flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-blue-500"></span> Online
                    </span>
                    <span class="inline-flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-gray-400"></span> ClassRoom
                    </span>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full border-collapse min-w-[900px]">
                    <!-- Day Headers -->
                    <thead>
                        <tr>
                            <th class="w-48 px-4 py-3 text-left border-b border-r border-gray-200 bg-gray-50/80">
                                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Teacher</span>
                            </th>
                            @foreach (var day in days)
                            {
                                var isToday = day == today;
                                <th class="px-2 py-3 text-center border-b border-r border-gray-200 last:border-r-0 @(isToday ? "bg-blue-50/70" : "bg-gray-50/80")">
                                    <div class="flex flex-col items-center gap-0.5">
                                        <span class="text-[10px] font-bold tracking-wider @(isToday ? "text-blue-600" : "text-gray-400")">@dayAbbr[day]</span>
                                        @if (isToday)
                                        {
                                            <span class="w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-[11px] font-bold">@DateTime.Now.Day</span>
                                        }
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>

                    <!-- Teacher Rows -->
                    <tbody>
                        @foreach (var teacherGroup in teacherGroups)
                        {
                            <tr class="border-b border-gray-100 last:border-b-0">
                                <!-- Teacher Name Cell -->
                                <td class="px-4 py-3 border-r border-gray-200 bg-white align-top">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 bg-gradient-to-br from-violet-400 to-purple-500 rounded-full flex items-center justify-center text-white text-xs font-bold shadow-sm flex-shrink-0">
                                            @(teacherGroup.Key.TeacherName?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                        <div class="min-w-0">
                                            <p class="text-sm font-semibold text-gray-800 truncate">@(teacherGroup.Key.TeacherName ?? "Unknown")</p>
                                            <p class="text-[11px] text-gray-400">@teacherGroup.Count() schedule(s)</p>
                                        </div>
                                    </div>
                                </td>

                                <!-- Day Cells -->
                                @foreach (var day in days)
                                {
                                    var isToday = day == today;
                                    var schedulesForDay = teacherGroup
                                        .Where(t => t.DayOfWeek != null && t.DayOfWeek.Equals(day, StringComparison.OrdinalIgnoreCase))
                                        .OrderBy(t => t.StartTime)
                                        .ToList();

                                    <td class="px-1.5 py-2 border-r border-gray-200 last:border-r-0 align-top @(isToday ? "bg-blue-50/30" : "")">
                                        <div class="space-y-1.5 min-h-[60px]">
                                            @foreach (var schedule in schedulesForDay)
                                            {
                                                var cIdx = subjectColorMap.ContainsKey(schedule.SubjectId)
                                                    ? subjectColorMap[schedule.SubjectId]
                                                    : 0;
                                                var colors = subjectColors[cIdx];
                                                var isOnline = schedule.Mode?.Equals("Online", StringComparison.OrdinalIgnoreCase) ?? false;

                                                <div class="@colors.bg @colors.border border rounded-lg p-2 cursor-pointer hover:shadow-md transition-all duration-200 group relative">
                                                    <!-- Subject + Mode Badge -->
                                                    <div class="flex items-start justify-between gap-1 mb-1">
                                                        <span class="text-[11px] font-bold @colors.text leading-tight truncate">@(schedule.SubjectName ?? "Subject")</span>
                                                        @if (isOnline)
                                                        {
                                                            <span class="flex-shrink-0 w-1.5 h-1.5 rounded-full bg-blue-500 mt-1" title="Online"></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="flex-shrink-0 w-1.5 h-1.5 rounded-full bg-gray-400 mt-1" title="ClassRoom"></span>
                                                        }
                                                    </div>

                                                    <!-- Class Name -->
                                                    <p class="text-[10px] text-gray-500 truncate mb-0.5">@(schedule.ClassName ?? "Class")</p>

                                                    <!-- Time -->
                                                    <div class="flex items-center gap-1">
                                                        <svg class="w-2.5 h-2.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                        <span class="text-[10px] text-gray-500 font-medium">@schedule.StartTime.ToString("hh\\:mm") - @schedule.EndTime.ToString("hh\\:mm")</span>
                                                    </div>

                                                    <!-- Hover Actions Overlay -->
                                                    <div class="absolute inset-0 bg-white/90 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center gap-2">
                                                        <a asp-action="Edit" asp-route-id="@schedule.SubClassId"
                                                           class="w-7 h-7 bg-blue-100 hover:bg-blue-200 rounded-lg flex items-center justify-center transition no-underline" title="Edit">
                                                            <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                                        </a>
                                                        <form asp-action="Delete" asp-route-id="@schedule.SubClassId" method="post" class="m-0 p-0">
                                                            <button type="submit"
                                                                    class="w-7 h-7 bg-red-100 hover:bg-red-200 rounded-lg flex items-center justify-center transition cursor-pointer border-none" title="Delete"
                                                                    onclick="return confirm('Delete this schedule?');">
                                                                <svg class="w-3.5 h-3.5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Summary Footer -->
            <div class="px-6 py-3 border-t border-gray-200 bg-gray-50/60 flex items-center justify-between">
                <p class="text-xs text-gray-400">
                    <span class="font-semibold text-gray-600">@(Model?.TimetableList?.Count ?? 0)</span> total schedules across
                    <span class="font-semibold text-gray-600">@(teacherGroups?.Count ?? 0)</span> teachers
                </p>
                <div class="flex items-center gap-3">
                    @if (Model?.TimetableList != null)
                    {
                        var subjects = Model.TimetableList.Select(t => new { t.SubjectId, t.SubjectName }).Distinct().ToList();
                        @foreach (var subject in subjects)
                        {
                            var cIdx2 = subjectColorMap.ContainsKey(subject.SubjectId) ? subjectColorMap[subject.SubjectId] : 0;
                            var c = subjectColors[cIdx2];
                            <span class="inline-flex items-center gap-1 text-[11px] @c.text font-medium">
                                <span class="w-2 h-2 rounded-full @c.dot"></span>
                                @(subject.SubjectName ?? "Subject")
                            </span>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>
