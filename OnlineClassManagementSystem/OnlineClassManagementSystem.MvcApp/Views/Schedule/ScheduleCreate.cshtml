@model OnlineClassManagementSystem.Domain.models.Timetable.TimetableCreateRequestModel

@{
    ViewData["Title"] = "New Schedule";
}

<div class="max-w-2xl mx-auto">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a asp-controller="Schedule" asp-action="Index" class="hover:text-blue-600 transition no-underline text-gray-500">Schedules</a>
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-gray-800 font-medium">Create</span>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-100 bg-gradient-to-r from-amber-50 to-orange-50">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-amber-100 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-gray-800">Create New Schedule</h3>
                    <p class="text-xs text-gray-500">Set up a new timetable entry for a class.</p>
                </div>
            </div>
        </div>

        <form asp-action="Create" method="post" class="p-6 space-y-5">

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-sm font-medium">@ViewBag.ErrorMessage</span>
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label asp-for="SubClassId" class="block text-sm font-semibold text-gray-700 mb-1.5">Class ID</label>
                    <input asp-for="SubClassId" type="number" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:outline-none transition" placeholder="e.g. 1">
                    <span asp-validation-for="SubClassId" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="TeacherId" class="block text-sm font-semibold text-gray-700 mb-1.5">Teacher ID</label>
                    <input asp-for="TeacherId" type="number" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:outline-none transition" placeholder="e.g. 2">
                    <span asp-validation-for="TeacherId" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="SubjectId" class="block text-sm font-semibold text-gray-700 mb-1.5">Subject ID</label>
                    <input asp-for="SubjectId" type="number" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:outline-none transition" placeholder="e.g. 3">
                    <span asp-validation-for="SubjectId" class="text-red-500 text-xs mt-1"></span>
                </div>
            </div>

            <div>
                <label asp-for="DayOfWeek" class="block text-sm font-semibold text-gray-700 mb-1.5">Day of Week</label>
                <select asp-for="DayOfWeek" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:outline-none transition bg-white">
                    <option value="">-- Select Day --</option>
                    <option value="Monday">Monday</option>
                    <option value="Tuesday">Tuesday</option>
                    <option value="Wednesday">Wednesday</option>
                    <option value="Thursday">Thursday</option>
                    <option value="Friday">Friday</option>
                    <option value="Saturday">Saturday</option>
                    <option value="Sunday">Sunday</option>
                </select>
                <span asp-validation-for="DayOfWeek" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="StartTime" class="block text-sm font-semibold text-gray-700 mb-1.5">Start Time</label>
                    <input asp-for="StartTime" type="time" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:outline-none transition">
                    <span asp-validation-for="StartTime" class="text-red-500 text-xs mt-1"></span>
                </div>
                <div>
                    <label asp-for="EndTime" class="block text-sm font-semibold text-gray-700 mb-1.5">End Time</label>
                    <input asp-for="EndTime" type="time" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:outline-none transition">
                    <span asp-validation-for="EndTime" class="text-red-500 text-xs mt-1"></span>
                </div>
            </div>

            <div>
                <label asp-for="Mode" class="block text-sm font-semibold text-gray-700 mb-1.5">Mode</label>
                <select asp-for="Mode" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:outline-none transition bg-white">
                    <option value="ClassRoom">ClassRoom</option>
                    <option value="Online">Online</option>
                </select>
                <span asp-validation-for="Mode" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div class="pt-4 flex justify-end gap-3 border-t border-gray-100">
                <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-xl font-medium transition text-sm no-underline">Cancel</a>
                <button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white rounded-xl font-semibold shadow-md hover:shadow-lg transition-all text-sm">
                    Create Schedule
                </button>
            </div>
        </form>
    </div>
</div>
