@model OnlineClassManagementSystem.Shared.models.Enrollment.EnrollmentCreateRequestModel

@{
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");
    ViewData["Title"] = "New Enrollment";

    var classes = ViewBag.Classes as List<OnlineClassManagementSystem.Shared.models.SubClass.SubClassModel> ?? new();
    var students = ViewBag.Students as List<OnlineClassManagementSystem.Shared.models.User.UserModel> ?? new();
}

<div class="p-6 md:p-8 space-y-6 max-w-3xl mx-auto">

    <!-- Back Navigation -->
    <div>
        <a asp-action="Index" asp-route-role="@currentRole"
           class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 transition">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back to Enrollments
        </a>
    </div>

    <!-- Main Card -->
    <div class="rounded-2xl border border-slate-200/80 bg-white p-6 md:p-8 shadow-sm">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-slate-100">
            <div>
                <h1 class="text-xl font-bold tracking-tight text-slate-900">New Enrollment</h1>
                <p class="text-xs text-slate-500 mt-0.5">Enroll a registered student into an active class.</p>
            </div>
            <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs font-medium text-rose-800 flex items-center gap-2">
                <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                <span>@ViewBag.Error</span>
            </div>
        }

        <form asp-action="Create" asp-route-role="@currentRole" method="post" class="space-y-5">
            @Html.AntiForgeryToken()

            <!-- Class Selection -->
            <div>
                <label asp-for="ClassId" class="block text-xs font-semibold text-slate-700 mb-1.5">Class <span class="text-rose-500">*</span></label>
                <select asp-for="ClassId" required class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition">
                    <option value="">-- Select Class --</option>
                    @foreach (var c in classes)
                    {
                        var isFull = (c.StudentCount ?? 0) >= c.StudentLimit;
                        <option value="@c.SubClassId" disabled="@(isFull ? "disabled" : null)">
                            @c.ClassName (Limit: @c.StudentLimit, Enrolled: @(c.StudentCount ?? 0)) @(isFull ? "[FULL]" : "")
                        </option>
                    }
                </select>
                <span asp-validation-for="ClassId" class="text-[11px] text-rose-600"></span>
            </div>

            <!-- Student Selection -->
            <div>
                <label asp-for="StudentId" class="block text-xs font-semibold text-slate-700 mb-1.5">Student <span class="text-rose-500">*</span></label>
                @if (students.Count > 0)
                {
                    <select asp-for="StudentId" required class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition">
                        <option value="">-- Select Registered Student --</option>
                        @foreach (var s in students)
                        {
                            <option value="@s.UserId">@s.FullName (@s.Email) [No: @s.UserId]</option>
                        }
                    </select>
                }
                else
                {
                    <input asp-for="StudentId" type="number" min="1" required placeholder="Enter student user No"
                           class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white" />
                }
                <span asp-validation-for="StudentId" class="text-[11px] text-rose-600"></span>
            </div>

            <!-- Enroll Date -->
            <div>
                <label asp-for="EnrollDate" class="block text-xs font-semibold text-slate-700 mb-1.5">Enrollment Date</label>
                <input asp-for="EnrollDate" type="date" value="@(DateTime.Today.ToString("yyyy-MM-dd"))"
                       class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
                <span asp-validation-for="EnrollDate" class="text-[11px] text-rose-600"></span>
            </div>

            <!-- Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-action="Index" asp-route-role="@currentRole" class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">
                    Cancel
                </a>
                <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-xs font-semibold text-white shadow-sm transition">
                    Confirm & Enroll
                </button>
            </div>
        </form>
    </div>
</div>
