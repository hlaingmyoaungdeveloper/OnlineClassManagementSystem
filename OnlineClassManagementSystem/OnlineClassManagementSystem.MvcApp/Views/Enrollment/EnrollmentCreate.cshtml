@model OnlineClassManagementSystem.Domain.models.Enrollment.EnrollmentCreateRequestModel

@{
    ViewData["Title"] = "New Enrollment";
}

<div class="max-w-2xl mx-auto">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a asp-controller="Enrollment" asp-action="Index" class="hover:text-blue-600 transition no-underline text-gray-500">Enrollments</a>
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-gray-800 font-medium">Create</span>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-100 bg-gradient-to-r from-emerald-50 to-teal-50">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-emerald-100 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-gray-800">Create New Enrollment</h3>
                    <p class="text-xs text-gray-500">Enroll a student into a class.</p>
                </div>
            </div>
        </div>

        <form asp-action="Create" method="post" class="p-6 space-y-5">

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="flex items-center gap-3 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-sm font-medium">@ViewBag.ErrorMessage</span>
                </div>
            }

            <div>
                <label asp-for="ClassId" class="block text-sm font-semibold text-gray-700 mb-1.5">Class ID</label>
                <input asp-for="ClassId" type="number" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none transition" placeholder="Enter the Class ID">
                <span asp-validation-for="ClassId" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div>
                <label asp-for="StudentId" class="block text-sm font-semibold text-gray-700 mb-1.5">Student ID</label>
                <input asp-for="StudentId" type="number" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none transition" placeholder="Enter the Student ID">
                <span asp-validation-for="StudentId" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div>
                <label asp-for="EnrollDate" class="block text-sm font-semibold text-gray-700 mb-1.5">Enrollment Date</label>
                <input asp-for="EnrollDate" type="date" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none transition">
                <span asp-validation-for="EnrollDate" class="text-red-500 text-xs mt-1"></span>
                <p class="text-xs text-gray-400 mt-1">Leave blank to use today's date.</p>
            </div>

            <div class="pt-4 flex justify-end gap-3 border-t border-gray-100">
                <a asp-action="Index" class="px-5 py-2.5 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-xl font-medium transition text-sm no-underline">Cancel</a>
                <button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white rounded-xl font-semibold shadow-md hover:shadow-lg transition-all text-sm">
                    Create Enrollment
                </button>
            </div>
        </form>
    </div>
</div>
