@model OnlineClassManagementSystem.Shared.models.TeachPlan.TeachPlanListResponseModel

@{
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");
    var isTeacher = currentRole == "teacher";
    ViewData["Title"] = isTeacher ? "Test Plan" : "Test Plan Management";

    var searchVal = ViewBag.SearchQuery as string ?? "";
    var pageNo = (int)(ViewBag.PageNo ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
}

<div class="p-6 md:p-8 space-y-6">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">@(isTeacher ? "Test Plan" : "Test Plan Management")</h1>
            <p class="text-xs text-slate-500 mt-1">Manage test plans, syllabi, topics, and assigned subject curricula.</p>
        </div>
        @if (!isTeacher)
        {
            <div>
                <a asp-controller="TeachPlan" asp-action="Create" asp-route-role="@currentRole"
                   class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    Add Test Plan
                </a>
            </div>
        }
    </div>

    <!-- Filters Row -->
    <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-xs">
        <form id="teachPlanSearchForm" onsubmit="event.preventDefault(); triggerSearch();" class="flex flex-wrap items-center gap-3 flex-1">
            <!-- Search -->
            <div class="flex-1 min-w-[200px] max-w-sm">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </span>
                    <input type="text" id="teachPlanSearchInput" value="@searchVal" placeholder="Search test plan..." 
                           class="w-full rounded-lg border border-slate-200 bg-slate-50/50 py-2 pl-9 pr-3 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white transition" />
                </div>
            </div>

            <button type="submit" class="rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-2 text-xs font-semibold transition cursor-pointer">
                Search
            </button>

            <button type="button" id="btnClearSearch" onclick="clearSearch()" class="hidden text-xs text-rose-600 hover:underline cursor-pointer">
                Clear
            </button>
        </form>

        <div class="text-xs text-slate-500">
            Total: <span id="totalPlansCount" class="font-semibold text-slate-700">0</span> plans
        </div>
    </div>

    <!-- Table Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50/80 text-xs font-semibold uppercase text-slate-500 border-b border-slate-200/80">
                    <tr>
                        <th class="px-6 py-3.5">ID</th>
                        <th class="px-6 py-3.5">Title</th>
                        <th class="px-6 py-3.5">Subject</th>
                        <th class="px-6 py-3.5 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="teachPlansTableBody" class="divide-y divide-slate-100">
                    <!-- Loading skeleton rows -->
                    @for (int i = 0; i < 5; i++)
                    {
                        <tr class="table-skeleton-row">
                            <td class="px-6 py-4"><div class="h-4 w-12 rounded skeleton-shimmer"></div></td>
                            <td class="px-6 py-4"><div class="h-4 w-48 rounded skeleton-shimmer"></div></td>
                            <td class="px-6 py-4"><div class="h-4 w-32 rounded skeleton-shimmer"></div></td>
                            <td class="px-6 py-4 text-center"><div class="mx-auto h-4 w-16 rounded skeleton-shimmer"></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Footer -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-200/80 px-6 py-3.5 bg-slate-50/50 text-xs text-slate-500">
            <div class="flex items-center gap-3">
                <span id="showingText">Loading...</span>
                <div class="flex items-center gap-1.5 pl-3 border-l border-slate-200">
                    <span>Per page:</span>
                    <select id="pageSizeSelect" onchange="changePageSize(this.value)"
                            class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 outline-none focus:border-blue-500 cursor-pointer">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>

            <div id="paginationNav" class="flex items-center gap-1"></div>
        </div>
    </div>

</div>

<!-- EDIT TEACH PLAN POPUP MODAL -->
<div id="editTeachPlanModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs hidden transition-opacity duration-200">
    <div class="relative w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-2xl animate-in fade-in zoom-in-95 duration-150">
        <!-- Close Button (X) -->
        <button type="button" onclick="closeEditTeachPlanModal()" class="absolute top-4 right-4 rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition cursor-pointer">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>

        <!-- Header -->
        <div class="flex items-center gap-3 pb-4 mb-5 border-b border-slate-100">
            <div class="h-10 w-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                </svg>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-900">Edit Test Plan</h3>
                <p class="text-xs text-slate-500">Update test plan title and subject curriculum</p>
            </div>
        </div>

        <form id="editTeachPlanForm" onsubmit="event.preventDefault(); submitEditTeachPlan();" class="space-y-4">
            <input type="hidden" id="editTeachPlanId" />

            <!-- Topic / Title -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Test Plan Title <span class="text-rose-500">*</span></label>
                <input id="editTeachPlanTopic" required placeholder="e.g. Mid Term Test"
                       class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
            </div>

            <!-- Subject ID -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Subject ID <span class="text-rose-500">*</span></label>
                <input id="editTeachPlanSubjectId" type="number" min="1" required placeholder="e.g. 1"
                       class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3.5 py-2.5 text-xs text-slate-700 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-100 transition" />
            </div>

            <!-- Modal Action Buttons -->
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeEditTeachPlanModal()"
                        class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition cursor-pointer">
                    Cancel
                </button>
                <button type="submit" id="btnSubmitEditTeachPlan"
                        class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 px-5 py-2.5 text-xs font-semibold text-white shadow-sm transition cursor-pointer">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span>Update Test Plan</span>
                </button>
            </div>
        </form>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const currentRole = '@currentRole';
        const isTeacher = @(isTeacher ? "true" : "false");

        let currentPageNo = @pageNo;
        let currentPageSize = @pageSize;
        let currentSearch = '@searchVal';

        function loadTeachPlans(pageNo = currentPageNo, pageSize = currentPageSize, search = currentSearch) {
            currentPageNo = pageNo;
            currentPageSize = pageSize;
            currentSearch = search;

            // Update Clear button visibility
            const clearBtn = document.getElementById('btnClearSearch');
            if (clearBtn) {
                if (currentSearch && currentSearch.trim().length > 0) {
                    clearBtn.classList.remove('hidden');
                } else {
                    clearBtn.classList.add('hidden');
                }
            }

            // Show skeleton rows in table
            const tbody = document.getElementById('teachPlansTableBody');
            tbody.innerHTML = `
                @for (int i = 0; i < 5; i++)
                {
                    <tr class="table-skeleton-row">
                        <td class="px-6 py-4"><div class="h-4 w-12 rounded skeleton-shimmer"></div></td>
                        <td class="px-6 py-4"><div class="h-4 w-48 rounded skeleton-shimmer"></div></td>
                        <td class="px-6 py-4"><div class="h-4 w-32 rounded skeleton-shimmer"></div></td>
                        <td class="px-6 py-4 text-center"><div class="mx-auto h-4 w-16 rounded skeleton-shimmer"></div></td>
                    </tr>
                }
            `;

            const queryParams = $.param({
                pageNo: currentPageNo,
                pageSize: currentPageSize,
                search: currentSearch || ''
            });

            // AJAX call to /TeachPlan/GetData
            $.ajax({
                url: '@Url.Action("GetData", "TeachPlan")?' + queryParams,
                type: 'GET',
                dataType: 'json',
                timeout: 15000,
                success: function (response) {
                    if (response && response.isSuccess) {
                        const list = response.teachPlanList || [];
                        const totalCount = response.totalCount || list.length;
                        const totalPages = response.totalPages || Math.max(1, Math.ceil(totalCount / currentPageSize));

                        // Total badge
                        document.getElementById('totalPlansCount').innerText = totalCount;

                        renderTable(list);
                        renderPagination(totalCount, totalPages, currentPageNo, currentPageSize);
                    } else {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="4" class="px-6 py-12 text-center text-amber-600">
                                    <p class="font-medium">${escapeHtml(response ? response.message : 'Error loading test plans')}</p>
                                    <button onclick="loadTeachPlans()" class="mt-2 text-xs text-blue-600 hover:underline">Retry</button>
                                </td>
                            </tr>
                        `;
                    }
                },
                error: function (xhr, status, error) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-rose-500">
                                <p class="font-medium">Failed to connect to Web API.</p>
                                <button onclick="loadTeachPlans()" class="mt-2 text-xs text-blue-600 hover:underline">Retry</button>
                            </td>
                        </tr>
                    `;
                }
            });
        }

        function renderTable(plans) {
            const tbody = document.getElementById('teachPlansTableBody');
            tbody.innerHTML = '';

            if (!plans || plans.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-slate-400">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <svg class="h-8 w-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                <span>No test plans found.</span>
                            </div>
                        </td>
                    </tr>
                `;
                return;
            }

            plans.forEach(plan => {
                const codeId = 'TP00' + plan.id;
                const topic = plan.topic || '-';
                const subject = plan.subjectName || ('Subject #' + plan.subjectId);

                let actionsHtml = '';
                if (!isTeacher) {
                    actionsHtml = `
                        <div class="inline-flex items-center gap-2">
                            <button type="button" onclick="openEditTeachPlanModal(${plan.id}, '${escapeJs(plan.topic || '')}', ${plan.subjectId || 1})" 
                                    class="text-blue-600 hover:text-blue-800 p-1 rounded hover:bg-blue-50 transition cursor-pointer" title="Edit">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                            </button>
                            <button type="button" onclick="deleteTeachPlan(${plan.id})" class="text-rose-500 hover:text-rose-700 p-1 rounded hover:bg-rose-50 transition cursor-pointer" title="Delete">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        </div>
                    `;
                } else {
                    actionsHtml = `<span class="text-xs text-slate-400">View Only</span>`;
                }

                const rowHtml = `
                    <tr id="teachPlanRow_${plan.id}" class="hover:bg-slate-50/60 transition">
                        <td class="px-6 py-4 font-semibold text-slate-800">${escapeHtml(codeId)}</td>
                        <td class="px-6 py-4 text-slate-800 font-medium">${escapeHtml(topic)}</td>
                        <td class="px-6 py-4 text-slate-700">${escapeHtml(subject)}</td>
                        <td class="px-6 py-4 text-center">${actionsHtml}</td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', rowHtml);
            });
        }

        function renderPagination(totalCount, totalPages, pageNo, pageSize) {
            const showingText = document.getElementById('showingText');
            const startItem = totalCount > 0 ? (pageNo - 1) * pageSize + 1 : 0;
            const endItem = Math.min(pageNo * pageSize, totalCount);

            if (showingText) {
                showingText.innerText = totalCount > 0 
                    ? `Showing ${startItem} - ${endItem} of ${totalCount} plans`
                    : 'Showing 0 plans';
            }

            const paginationNav = document.getElementById('paginationNav');
            paginationNav.innerHTML = '';

            const hasPrevious = pageNo > 1;
            const hasNext = pageNo < totalPages;

            // Prev Button
            if (hasPrevious) {
                paginationNav.insertAdjacentHTML('beforeend', `
                    <button type="button" onclick="loadTeachPlans(${pageNo - 1})"
                            class="h-7 px-2.5 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium cursor-pointer">
                        &lsaquo; Prev
                    </button>
                `);
            } else {
                paginationNav.insertAdjacentHTML('beforeend', `
                    <span class="h-7 px-2.5 rounded-md border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-300 cursor-not-allowed">
                        &lsaquo; Prev
                    </span>
                `);
            }

            const startPage = Math.max(1, pageNo - 2);
            const endPage = Math.min(totalPages, pageNo + 2);

            if (startPage > 1) {
                paginationNav.insertAdjacentHTML('beforeend', `
                    <button type="button" onclick="loadTeachPlans(1)"
                            class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium cursor-pointer">1</button>
                `);
                if (startPage > 2) {
                    paginationNav.insertAdjacentHTML('beforeend', `<span class="px-1 text-slate-400">...</span>`);
                }
            }

            for (let i = startPage; i <= endPage; i++) {
                if (i === pageNo) {
                    paginationNav.insertAdjacentHTML('beforeend', `
                        <span class="h-7 w-7 rounded-md bg-blue-600 text-white font-semibold flex items-center justify-center shadow-xs">${i}</span>
                    `);
                } else {
                    paginationNav.insertAdjacentHTML('beforeend', `
                        <button type="button" onclick="loadTeachPlans(${i})"
                                class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium cursor-pointer">${i}</button>
                    `);
                }
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    paginationNav.insertAdjacentHTML('beforeend', `<span class="px-1 text-slate-400">...</span>`);
                }
                paginationNav.insertAdjacentHTML('beforeend', `
                    <button type="button" onclick="loadTeachPlans(${totalPages})"
                            class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium cursor-pointer">${totalPages}</button>
                `);
            }

            // Next Button
            if (hasNext) {
                paginationNav.insertAdjacentHTML('beforeend', `
                    <button type="button" onclick="loadTeachPlans(${pageNo + 1})"
                            class="h-7 px-2.5 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium cursor-pointer">
                        Next &rsaquo;
                    </button>
                `);
            } else {
                paginationNav.insertAdjacentHTML('beforeend', `
                    <span class="h-7 px-2.5 rounded-md border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-300 cursor-not-allowed">
                        Next &rsaquo;
                    </span>
                `);
            }
        }

        function triggerSearch() {
            const input = document.getElementById('teachPlanSearchInput');
            const searchVal = input ? input.value.trim() : '';
            loadTeachPlans(1, currentPageSize, searchVal);
        }

        function clearSearch() {
            const input = document.getElementById('teachPlanSearchInput');
            if (input) input.value = '';
            loadTeachPlans(1, currentPageSize, '');
        }

        function changePageSize(size) {
            loadTeachPlans(1, parseInt(size, 10), currentSearch);
        }

        function deleteTeachPlan(id) {
            if (!confirm('Are you sure you want to delete this test plan?')) return;

            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Delete", "TeachPlan")/' + id + '?role=' + encodeURIComponent(currentRole),
                type: 'POST',
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function (res) {
                    if (res && res.isSuccess) {
                        if (window.showToast) {
                            window.showToast('Test plan deleted successfully!', true);
                        }
                        loadTeachPlans();
                    } else {
                        if (window.showToast) {
                            window.showToast(res ? res.message : 'Failed to delete test plan', false);
                        } else {
                            alert(res ? res.message : 'Failed to delete');
                        }
                    }
                },
                error: function () {
                    if (window.showToast) {
                        window.showToast('Error communicating with server', false);
                    } else {
                        alert('Error communicating with server');
                    }
                }
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function escapeJs(text) {
            if (!text) return '';
            return text.replace(/'/g, "\\'").replace(/"/g, '\\"');
        }

        // Edit Teach Plan Modal
        const editTeachPlanModal = document.getElementById('editTeachPlanModal');

        function openEditTeachPlanModal(id, topic, subjectId) {
            document.getElementById('editTeachPlanId').value = id;
            document.getElementById('editTeachPlanTopic').value = topic || '';
            document.getElementById('editTeachPlanSubjectId').value = subjectId || 1;
            editTeachPlanModal.classList.remove('hidden');
            const firstInput = document.getElementById('editTeachPlanTopic');
            if (firstInput) setTimeout(() => firstInput.focus(), 100);
        }

        function closeEditTeachPlanModal() {
            editTeachPlanModal.classList.add('hidden');
        }

        function submitEditTeachPlan() {
            const id = document.getElementById('editTeachPlanId').value;
            const token = $('input[name="__RequestVerificationToken"]').val();
            const submitBtn = document.getElementById('btnSubmitEditTeachPlan');

            const model = {
                Id: parseInt(id, 10),
                Topic: document.getElementById('editTeachPlanTopic').value.trim(),
                SubjectId: parseInt(document.getElementById('editTeachPlanSubjectId').value, 10)
            };

            if (!model.Topic || !model.SubjectId) {
                alert('Please fill in all required fields.');
                return;
            }

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="inline-block animate-spin mr-1">⌛</span> Updating...';
            }

            $.ajax({
                url: '@Url.Action("Update", "TeachPlan")/' + id + '?role=' + encodeURIComponent(currentRole),
                type: 'POST',
                data: model,
                headers: {
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function(res) {
                    if (res && res.isSuccess) {
                        closeEditTeachPlanModal();
                        if (window.showToast) window.showToast(res.message || 'Test Plan updated successfully!', true);
                        loadTeachPlans();
                    } else {
                        if (window.showToast) window.showToast(res ? res.message : 'Failed to update plan', false);
                        else alert(res ? res.message : 'Failed to update plan');
                    }
                },
                error: function(xhr) {
                    const msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Server error updating plan';
                    if (window.showToast) window.showToast(msg, false);
                    else alert(msg);
                },
                complete: function() {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>Update Test Plan</span>';
                    }
                }
            });
        }

        // Close on backdrop click & ESC
        editTeachPlanModal.addEventListener('click', (e) => {
            if (e.target === editTeachPlanModal) closeEditTeachPlanModal();
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !editTeachPlanModal.classList.contains('hidden')) {
                closeEditTeachPlanModal();
            }
        });

        // Debounced live search
        let searchTimeout = null;
        document.getElementById('teachPlanSearchInput').addEventListener('input', function(e) {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                triggerSearch();
            }, 350);
        });

        // Initial Load via AJAX
        $(document).ready(function () {
            loadTeachPlans();
        });
    </script>
}
