@model OnlineClassManagementSystem.Shared.models.TeachPlan.TeachPlanListResponseModel

@{
    var queryRole = Context.Request.Query["role"].ToString();
    var currentRole = !string.IsNullOrEmpty(queryRole) ? queryRole.ToLower() : (ViewBag.CurrentRole as string ?? "admin");
    var isTeacher = currentRole == "teacher";
    ViewData["Title"] = isTeacher ? "Test Plan" : "Test Plan Management";

    var teachPlans = Model?.TeachPlanList ?? new List<OnlineClassManagementSystem.Shared.models.TeachPlan.TeachPlanModel>();
    var pageNo = Model?.PageNo ?? (int)(ViewBag.PageNo ?? 1);
    var pageSize = Model?.PageSize ?? (int)(ViewBag.PageSize ?? 10);
    var totalCount = Model?.TotalCount ?? teachPlans.Count;
    var totalPages = Model?.TotalPages ?? (int)Math.Ceiling((double)totalCount / pageSize);
    if (totalPages < 1) totalPages = 1;
    var hasPrevious = Model?.HasPreviousPage ?? (pageNo > 1);
    var hasNext = Model?.HasNextPage ?? (pageNo < totalPages);
    var searchVal = ViewBag.SearchQuery as string ?? "";
}

<div class="p-6 md:p-8 space-y-6">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">@(isTeacher ? "Test Plan" : "Test Plan Management")</h1>
        </div>
        @if (!isTeacher)
        {
            <div>
                <a asp-controller="TeachPlan" asp-action="Create" asp-route-role="@currentRole"
                   class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 transition">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    Add Test Plan
                </a>
            </div>
        }
    </div>

    <!-- Filters Row -->
    <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-xs">
        <form method="get" asp-action="Index" class="flex flex-wrap items-center gap-3 flex-1">
            <input type="hidden" name="role" value="@currentRole" />
            <input type="hidden" name="pageNo" value="1" />
            <input type="hidden" name="pageSize" value="@pageSize" />

            <!-- Search -->
            <div class="flex-1 min-w-[200px] max-w-sm">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </span>
                    <input type="text" name="search" value="@searchVal" placeholder="Search test plan..." class="w-full rounded-lg border border-slate-200 bg-slate-50/50 py-2 pl-9 pr-3 text-xs text-slate-700 outline-none focus:border-blue-500" />
                </div>
            </div>

            <button type="submit" class="rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-2 text-xs font-semibold transition">
                Search
            </button>

            @if (!string.IsNullOrEmpty(searchVal))
            {
                <a asp-action="Index" asp-route-role="@currentRole" class="text-xs text-rose-600 hover:underline">
                    Clear
                </a>
            }
        </form>
        <div class="text-xs text-slate-500">
            Total: <span class="font-semibold text-slate-700">@totalCount</span> plans
        </div>
    </div>

    <!-- Table Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50/80 text-xs font-semibold uppercase text-slate-500 border-b border-slate-200/80">
                    <tr>
                        <th class="px-6 py-3.5">ID</th>
                        <th class="px-6 py-3.5">Title</th>
                        <th class="px-6 py-3.5">Subject</th>
                        <th class="px-6 py-3.5 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (teachPlans.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <svg class="h-8 w-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                    <span>No test plans found.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var plan in teachPlans)
                        {
                            var codeId = "TP00" + plan.Id;
                            <tr class="hover:bg-slate-50/60 transition">
                                <td class="px-6 py-4 font-semibold text-slate-800">@codeId</td>
                                <td class="px-6 py-4 text-slate-800 font-medium">@(plan.Topic ?? "-")</td>
                                <td class="px-6 py-4 text-slate-700">@(plan.SubjectName ?? ("Subject #" + plan.SubjectId))</td>
                                <td class="px-6 py-4 text-center">
                                    <div class="inline-flex items-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@plan.Id" asp-route-role="@currentRole" class="text-blue-600 hover:text-blue-800 p-1" title="Edit">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@plan.Id" asp-route-role="@currentRole" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-rose-500 hover:text-rose-700 p-1" title="Delete" onclick="return confirm('Are you sure you want to delete this test plan?');">
                                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @{
            var startItem = totalCount > 0 ? (pageNo - 1) * pageSize + 1 : 0;
            var endItem = Math.Min(pageNo * pageSize, totalCount);
            int startPage = Math.Max(1, pageNo - 2);
            int endPage = Math.Min(totalPages, pageNo + 2);
        }

        <!-- Pagination Footer -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-200/80 px-6 py-3.5 bg-slate-50/50 text-xs text-slate-500">
            <div class="flex items-center gap-3">
                <span>Showing @(totalCount > 0 ? $"{startItem} - {endItem} of {totalCount}" : "0") plans</span>
                <div class="flex items-center gap-1.5 pl-3 border-l border-slate-200">
                    <span>Per page:</span>
                    <select onchange="location.href='@Url.Action("Index", new { role = currentRole, search = searchVal, pageNo = 1 })&pageSize=' + this.value"
                            class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 outline-none focus:border-blue-500">
                        <option value="5" selected="@(pageSize == 5 ? "selected" : null)">5</option>
                        <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10</option>
                        <option value="20" selected="@(pageSize == 20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center gap-1">
                @if (hasPrevious)
                {
                    <a asp-action="Index" asp-route-pageNo="@(pageNo - 1)" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-role="@currentRole"
                       class="h-7 px-2.5 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">
                        &lsaquo; Prev
                    </a>
                }
                else
                {
                    <span class="h-7 px-2.5 rounded-md border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-300 cursor-not-allowed">
                        &lsaquo; Prev
                    </span>
                }

                @if (startPage > 1)
                {
                    <a asp-action="Index" asp-route-pageNo="1" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-role="@currentRole"
                       class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">1</a>
                    @if (startPage > 2)
                    {
                        <span class="px-1 text-slate-400">...</span>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    if (i == pageNo)
                    {
                        <span class="h-7 w-7 rounded-md bg-blue-600 text-white font-semibold flex items-center justify-center shadow-xs">@i</span>
                    }
                    else
                    {
                        <a asp-action="Index" asp-route-pageNo="@i" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-role="@currentRole"
                           class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">@i</a>
                    }
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <span class="px-1 text-slate-400">...</span>
                    }
                    <a asp-action="Index" asp-route-pageNo="@totalPages" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-role="@currentRole"
                       class="h-7 w-7 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">@totalPages</a>
                }

                @if (hasNext)
                {
                    <a asp-action="Index" asp-route-pageNo="@(pageNo + 1)" asp-route-pageSize="@pageSize" asp-route-search="@searchVal" asp-route-role="@currentRole"
                       class="h-7 px-2.5 rounded-md border border-slate-200 bg-white flex items-center justify-center text-slate-600 hover:bg-slate-100 transition shadow-2xs font-medium">
                        Next &rsaquo;
                    </a>
                }
                else
                {
                    <span class="h-7 px-2.5 rounded-md border border-slate-200 bg-slate-50 flex items-center justify-center text-slate-300 cursor-not-allowed">
                        Next &rsaquo;
                    </span>
                }
            </div>
        </div>
    </div>

</div>
