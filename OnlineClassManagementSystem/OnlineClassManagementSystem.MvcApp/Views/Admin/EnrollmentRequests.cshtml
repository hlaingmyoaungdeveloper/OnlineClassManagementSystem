@model OnlineClassManagementSystem.MvcApp.ViewModels.EnrollmentListViewModel
@{
    ViewData["Title"] = "Enrollment Requests";
    var pending = Model.Enrollments.Where(e => e.Status?.ToLower() == "pending").ToList();
    var processed = Model.Enrollments.Where(e => e.Status?.ToLower() != "pending").ToList();
}

@if (Model.ErrorMessage != null)
{
    <div class="mb-5 bg-red-50 border border-red-200 rounded-xl p-4 text-red-700 text-sm">⚠️ @Model.ErrorMessage</div>
}

<!-- Pending Requests -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <h2 class="text-base font-bold text-slate-800">Pending Requests</h2>
            @if (pending.Any())
            {
                <span class="bg-amber-100 text-amber-700 text-xs font-bold px-2.5 py-1 rounded-full">@pending.Count</span>
            }
        </div>
    </div>

    @if (!pending.Any())
    {
        <div class="py-14 text-center">
            <div class="w-14 h-14 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-7 h-7 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
            </div>
            <p class="text-slate-500 text-sm font-medium">All caught up! No pending requests.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-slate-50 text-left">
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Student</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Class</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Applied On</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var e in pending)
                    {
                        <tr class="hover:bg-amber-50/30 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 font-bold text-sm flex-shrink-0">
                                        @(e.StudentName?.Length > 0 ? e.StudentName[0].ToString().ToUpper() : "?")
                                    </div>
                                    <div>
                                        <p class="font-semibold text-slate-800">@e.StudentName</p>
                                        <p class="text-slate-400 text-xs">ID: @e.StudentId</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="font-medium text-slate-800">@e.ClassName</span>
                            </td>
                            <td class="px-6 py-4 text-slate-500">
                                @(e.EnrollDate?.ToString("MMM dd, yyyy HH:mm") ?? "-")
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    <form asp-action="ApproveEnrollment" asp-controller="Admin" asp-route-id="@e.EnrollmentId" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-green-600 hover:bg-green-700 text-white text-xs font-semibold rounded-lg shadow-sm transition-all duration-200">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                            </svg>
                                            Approve
                                        </button>
                                    </form>
                                    <form asp-action="RejectEnrollment" asp-controller="Admin" asp-route-id="@e.EnrollmentId" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-lg shadow-sm transition-all duration-200">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                            </svg>
                                            Reject
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Processed Requests -->
@if (processed.Any())
{
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100">
            <h2 class="text-base font-bold text-slate-800">Recently Processed <span class="text-slate-400 font-normal text-sm">(@processed.Count)</span></h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-slate-50 text-left">
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Student</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Class</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Date</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var e in processed)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-3.5">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 font-bold text-xs flex-shrink-0">
                                        @(e.StudentName?.Length > 0 ? e.StudentName[0].ToString().ToUpper() : "?")
                                    </div>
                                    <span class="font-medium text-slate-700">@e.StudentName</span>
                                </div>
                            </td>
                            <td class="px-6 py-3.5 text-slate-600">@e.ClassName</td>
                            <td class="px-6 py-3.5 text-slate-500">@(e.EnrollDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                            <td class="px-6 py-3.5">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold @e.StatusBadgeClass">
                                    @e.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
