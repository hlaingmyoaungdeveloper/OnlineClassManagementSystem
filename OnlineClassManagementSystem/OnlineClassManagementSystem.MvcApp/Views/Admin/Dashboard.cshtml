@model OnlineClassManagementSystem.MvcApp.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stat Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex items-center gap-5">
        <div class="w-14 h-14 rounded-2xl bg-indigo-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
        </div>
        <div>
            <p class="text-sm text-slate-500 font-medium">Total Classes</p>
            <p class="text-3xl font-bold text-slate-800 mt-0.5">@Model.TotalClasses</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex items-center gap-5">
        <div class="w-14 h-14 rounded-2xl bg-amber-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>
        <div>
            <p class="text-sm text-slate-500 font-medium">Pending Enrollments</p>
            <p class="text-3xl font-bold text-slate-800 mt-0.5">@Model.PendingEnrollments</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 flex items-center gap-5">
        <div class="w-14 h-14 rounded-2xl bg-green-100 flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
        </div>
        <div>
            <p class="text-sm text-slate-500 font-medium">Total Enrollments</p>
            <p class="text-3xl font-bold text-slate-800 mt-0.5">@Model.RecentEnrollments.Count</p>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="flex gap-3 mb-8">
    <a href="@Url.Action("CreateClass", "Admin")"
       class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-all duration-200">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        New Class
    </a>
    <a href="@Url.Action("EnrollmentRequests", "Admin")"
       class="inline-flex items-center gap-2 px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold rounded-xl shadow-sm transition-all duration-200">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
        </svg>
        Review Requests
        @if (Model.PendingEnrollments > 0)
        {
            <span class="bg-white text-amber-600 text-xs font-bold px-2 py-0.5 rounded-full">@Model.PendingEnrollments</span>
        }
    </a>
</div>

<!-- Recent Enrollment Requests Table -->
@if (Model.ErrorMessage != null)
{
    <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-red-700 text-sm mb-6">⚠️ @Model.ErrorMessage</div>
}

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="text-base font-bold text-slate-800">Recent Enrollment Activity</h2>
        <a href="@Url.Action("EnrollmentRequests","Admin")" class="text-indigo-600 text-sm font-medium hover:underline">View all →</a>
    </div>

    @if (!Model.RecentEnrollments.Any())
    {
        <div class="py-16 text-center">
            <svg class="w-12 h-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <p class="text-slate-400 text-sm">No enrollment records yet.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-slate-50 text-left">
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Student</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Class</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Date</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var e in Model.RecentEnrollments)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-3.5">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold text-xs flex-shrink-0">
                                        @(e.StudentName?.Length > 0 ? e.StudentName[0].ToString().ToUpper() : "?")
                                    </div>
                                    <div>
                                        <p class="font-medium text-slate-800">@e.StudentName</p>
                                        <p class="text-slate-400 text-xs">ID: @e.StudentId</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-3.5 text-slate-600">@e.ClassName</td>
                            <td class="px-6 py-3.5 text-slate-500">
                                @(e.EnrollDate?.ToString("MMM dd, yyyy") ?? "-")
                            </td>
                            <td class="px-6 py-3.5">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold @e.StatusBadgeClass">
                                    @(e.Status ?? "Pending")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
