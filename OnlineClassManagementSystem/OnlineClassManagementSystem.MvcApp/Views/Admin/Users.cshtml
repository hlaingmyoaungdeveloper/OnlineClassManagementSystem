@model OnlineClassManagementSystem.MvcApp.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-12 text-center">
    <div class="w-16 h-16 bg-indigo-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
    </div>
    <h3 class="text-lg font-bold text-slate-700 mb-2">User Management</h3>
    <p class="text-slate-400 text-sm max-w-sm mx-auto">@Model.ErrorMessage</p>

    <div class="mt-6 inline-flex items-center gap-2 px-4 py-2 bg-indigo-50 text-indigo-700 text-xs font-semibold rounded-xl">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Coming Soon — User API endpoint is in the backlog
    </div>
</div>
